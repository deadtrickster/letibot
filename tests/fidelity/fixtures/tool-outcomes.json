              "pattern": {
                "type": "string"
              },
              "glob": {
                "type": "string"
              }
            },
            "required": [
              "pattern"
            ],
            "additionalProperties": false
          }
        }
      }
    ]
  },
  "items": [
    {
      "type": "user",
      "parts": [
