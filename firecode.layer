# letibot's guest layer — what a VM needs to build THIS repository.
#
# The cookbook names this file as owed: "a firecode.layer for this project waiting to be written
# (llama.cpp fork, libsqlite3-dev, the Rust toolchain), and until it exists every Rust run in a VM
# pays ten minutes to rediscover it."
#
# THE FORMAT IS ONE DIRECTIVE PER LINE. There is no backslash continuation — scripts/apply-layer.sh
# parses line by line and refuses the WHOLE FILE on the first line that is not ENV, RUN or a comment.
# Measured the hard way: a first version of this file wrapped its RUNs with trailing backslashes, so
# its continuation lines were neither, the file was rejected at the first of them, and two probes
# found a bare guest. The failure is legible ("apply-layer: <file>:N is not ENV, RUN or a comment")
# but only if somebody reads the host-side output — which the daemon captured and dropped, because
# firecode does not fail `up` when a layer fails.
#
# So: ENV KEY=value, or RUN <one shell command on ONE line>, or # a comment. No FROM (the base is
# the firecode image) and no COPY (the project is already mounted at the same absolute path).
# A RUN line is executed as `sudo -n bash -c 'set -euo pipefail; cd <project>; <cmd>'`, so avoid
# single quotes inside it — they would close that quote and change the meaning of everything after.

ENV DEBIAN_FRONTEND=noninteractive

# **`ENV` reaches this file's own RUN lines and NOTHING LATER.** Measured by a probe: the layer's rust
# line installed a working 1.5 GB toolchain under /usr/local, and `cargo --version` still failed for
# uid 1000 — because the rustup proxies look in `$HOME/.rustup` unless RUSTUP_HOME says otherwise, and
# this file's ENV does not survive into a later shell. So the variables are set TWICE, on purpose: as
# ENV below, so this file's own lines work, and in a profile file, so the guest's shells have them.
ENV RUSTUP_HOME=/usr/local/rustup CARGO_HOME=/usr/local/cargo
RUN echo export RUSTUP_HOME=/usr/local/rustup CARGO_HOME=/usr/local/cargo >> /etc/profile.d/10-letibot-rust.sh; cat /etc/profile.d/10-letibot-rust.sh

# ── The Rust toolchain ───────────────────────────────────────────────────────────────────────────
#
# MEASURED 2026-10-10, and this cost two probes: THIS IMAGE HAS NO RUST ANYWHERE. An earlier probe
# reported cargo 1.98.0 "in root's home", and that was wrong — the child that ran it had CREATED
# /root/.rustup and /usr/local/bin/cargo itself. A later probe with passwordless sudo searched the
# whole filesystem (`find / -xdev -type f \( -name cargo -o -name rustc -o -name rustup \) -perm
# -u+x`) and found nothing, and /root/.cargo does not exist.
#
# So the install branch below is not a fallback: it is the path. And it installs SYSTEM-WIDE, under
# /usr/local, because the layer runs as root and a toolchain in root's home is invisible to uid 1000,
# which is who the work runs as. Rustup's own documented recipe, with RUSTUP_HOME and CARGO_HOME
# moved out of $HOME.
#
# The search first anyway, so that an image which DOES ship one is used rather than duplicated —
# remembering /usr/lib/cargo, which exists on this image and holds only bin/fd: a search that matched
# a DIRECTORY named cargo would be fooled, so this matches a regular executable file.
RUN set -eux; found=""; command -v cargo >/dev/null 2>&1 && found=$(command -v cargo); if [ -z "$found" ]; then found=$(find / -xdev -maxdepth 6 -type f -name cargo -perm -u+x 2>/dev/null | head -1); fi; if [ -n "$found" ]; then ln -sfn "$found" /usr/local/bin/cargo; ln -sfn "$(dirname "$found")/rustc" /usr/local/bin/rustc 2>/dev/null || true; else export RUSTUP_HOME=/usr/local/rustup CARGO_HOME=/usr/local/cargo; curl --proto =https --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y --no-modify-path --default-toolchain stable; ln -sfn /usr/local/cargo/bin/cargo /usr/local/bin/cargo; ln -sfn /usr/local/cargo/bin/rustc /usr/local/bin/rustc; ln -sfn /usr/local/cargo/bin/rustup /usr/local/bin/rustup; fi; cargo --version; rustc --version

# ── The dev packages the build scripts need ──────────────────────────────────────────────────────
#
# The guest has the RUNTIME libsqlite3.so.0 and no sqlite3.pc and no /usr/include/sqlite3.h, which is
# the dev package's absence stated three ways. cmake and ninja are for the library below; pkg-config is
# already installed but is named because a build script looks for it.
#
# **NOT `cc`.** The first version listed it and the line died two seconds in: `E: Unable to locate
# package cc` — cc is a VIRTUAL package name on Ubuntu, provided by build-essential, and /usr/bin/cc is
# already there. Under the line's own `set -euo pipefail` that exit 100 killed the line, so the clone,
# the library and the fetch below never ran at all — a missing package name cost three lines.
RUN set -eux; apt-get update; apt-get install -y --no-install-recommends libsqlite3-dev pkg-config cmake ninja-build; rm -rf /var/lib/apt/lists/*

# ── The llama.cpp checkout crates/llama/build.rs insists on ──────────────────────────────────────
#
# The FORK — deadtrickster/llama.cpp — because letibot-llama links that one's libllama. Cloned to
# the absolute path the build reads BY DEFAULT (DEFAULT_LLAMA_DIR in crates/llama/build.rs), which is
# why nothing here sets LETIBOT_LLAMA_DIR: the path IS the default, and recreating it says less than
# an override. /home/dead/Projects does not exist in the guest at all, so the mkdir is load-bearing.
#
# GUARDED, because a layer's lines must be RE-RUNNABLE: the stamp is per FILE, not per line, so any
# edit to this file re-runs every line below it — and a bare git clone fails the second time.
RUN set -eux; mkdir -p /home/dead/Projects; if [ ! -d /home/dead/Projects/llama.cpp/.git ]; then git clone --depth 1 https://github.com/deadtrickster/llama.cpp.git /home/dead/Projects/llama.cpp; fi; test -f /home/dead/Projects/llama.cpp/include/llama.h

# ── The real library, built once and cached ──────────────────────────────────────────────────────
#
# A LINK-ONLY stub was the first draft, justified by the cost of a build — and the operator's
# correction is why it is not: "and firecode caches layers." A cached layer pays that cost ONCE, so
# the stub bought nothing and gave up the tests that call into llama. CPU-only (the guest has no GPU
# to pass through), tests/examples/server off because nothing under test runs them.
RUN set -eux; cd /home/dead/Projects/llama.cpp; cmake -B build-glm -G Ninja -DCMAKE_BUILD_TYPE=Release -DGGML_CUDA=OFF -DLLAMA_CURL=OFF -DLLAMA_BUILD_TESTS=OFF -DLLAMA_BUILD_EXAMPLES=OFF -DLLAMA_BUILD_SERVER=OFF; cmake --build build-glm --target llama --parallel $(nproc); ls -l /home/dead/Projects/llama.cpp/build-glm/bin/libllama.so

# ── The crates.io index and the 230 locked packages ──────────────────────────────────────────────
#
# The project is mounted at this same absolute path — the script cds into it before each line — so
# this fetches what Cargo.lock names, into the layer, where every later VM inherits it. Without it
# the first cargo check in every fresh VM pays a cold registry fetch; a probe measured exactly that
# (no ~/.cargo, no vendor/, no .cargo/config.toml in the guest).
RUN set -eux; CARGO_HOME=/usr/local/cargo cargo fetch
