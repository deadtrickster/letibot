{
  "name": "two-tool-calls",
  "why": "DECLARED DIVERGENCE. The template merges consecutive tool results into one user turn; this renderer emits one turn each, because Session::append_items renders one item at a time and the ledger cannot retract the <|im_end|> it already wrote. Expected to fail on every prefix that holds two adjacent results.",
  "prefix": {
    "system": "You are a coding assistant.",
    "tools": [
      {
        "type": "function",
        "function": {
          "name": "read",
          "description": "Read a file from disk. Give it a path relative to the workspace root.",
          "parameters": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string"
              },
              "limit": {
                "type": "integer"
              }
            },
            "required": [
              "path"
            ]
          }
        }
      }
    ]
  },
  "items": [
    {
      "type": "user",
      "parts": [
        {
          "kind": "text",
          "text": "Compare a.txt and b.txt."
        }
      ]
    },
    {
      "type": "reasoning",
      "text": "Read both.",
      "field": "inline"
    },
    {
      "type": "assistant",
      "text": "",
      "tool_calls": [
        {
          "id": "c1",
          "name": "read",
          "arguments": "{\"path\": \"a.txt\"}"
        },
        {
          "id": "c2",
          "name": "read",
          "arguments": "{\"path\": \"b.txt\"}"
        }
      ]
    },
    {
      "type": "tool_result",
      "call_id": "c1",
      "name": "read",
      "outcome": {
        "outcome": "ok"
      },
      "payload": "alpha\nbeta\n"
    },
    {
      "type": "tool_result",
      "call_id": "c2",
      "name": "read",
      "outcome": {
        "outcome": "ok"
      },
      "payload": "alpha\ngamma\n"
    },
    {
      "type": "reasoning",
      "text": "Line 2 differs.",
      "field": "inline"
    },
    {
      "type": "assistant",
      "text": "They differ on line 2."
    }
  ],
  "divergences": [
    "consecutive-tool-results-not-merged"
  ]
}
