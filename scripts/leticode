#!/usr/bin/env bash
# leticode — letibot seated as leticode: the opencode tool union
# (read, write, edit, grep, glob, todo_write, skill, lsp, task).
#
# It is the same daemon, store and socket as `letibot`; only the default seat
# differs, and the seat is decided when the daemon starts. So a daemon already
# running with another role stays that role — `letibot --stop` first to get a
# fresh leticode daemon.
#
#   leticode                     attach / start, leticode seat
#   leticode "one question"      one-shot, no TUI
#   leticode --new               a fresh leticode session
#   leticode --continue          reopen the newest session (its stored role wins)
#
# Everything `letibot` takes is forwarded unchanged (--glm/--flash/--dense,
# --mode, --sessions, --stop, ...). The dashboard is a separate window:
#   ~/bin/leticode-dash
#
# The shell and `web_fetch` are ON by default here (`--no-web-fetch` turns the fetch off).
# The shell is ON by default here — opencode's coder has bash, and the operator's
# rule (2026-09-14): "when i do leticode, --bash must be a default". What it may
# run without asking is the preapproved list (harnessd's `preapproved`
# disclosure; ~/.config/letibot/permission.json). `--no-bash` seats no shell.
# **The name this wrapper was invoked by, for the sentences that hand back a command.**
#
# `letibot` execs itself as the daemon launcher, so inside that script `$0` is
# `letibot` — and a fix line built from it told an operator who ran `leticode --glm` to
# run `letibot --stop && letibot`, which is a **coder** daemon on the **default** model:
# a different seat and a different model than the two words they typed. MEASURED
# 2026-10-07. Nothing else in that script can know which wrapper was used, because the
# role travels as an environment variable and the flag is consumed before it could be
# read back.
export LETIBOT_INVOKED_AS=leticode
export LETIBOT_ROLE=leticode
: "${LETIBOT_BASH:=1}"
export LETIBOT_BASH
# **`web_fetch` is on here too** — what `letibot`'s own comment has always said this wrapper does
# ("ON for the leticode seat, which sets LETIBOT_WEB_FETCH=1 itself") and it never did, so no
# leticode daemon ever had the tool: the operator's stroppy session showed `web_fetch (N/A)`.
# `--no-web-fetch` still turns it off; `letibot` reads that flag itself.
: "${LETIBOT_WEB_FETCH:=1}"
export LETIBOT_WEB_FETCH
for a in "$@"; do
  case "$a" in
    --no-bash) LETIBOT_BASH="" ;;
  esac
done
args=()
for a in "$@"; do [ "$a" = "--no-bash" ] || args+=("$a"); done
exec letibot "${args[@]}"
