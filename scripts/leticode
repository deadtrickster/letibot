#!/usr/bin/env bash
# leticode - letibot seated as leticode: the opencode tool union
# (read, write, edit, grep, glob, todo_write, skill, lsp, task).
#
# Same daemon, store and socket as `letibot`; only the default seat differs, and the seat is
# decided when the daemon starts. A daemon already running another role stays that role -
# `letibot --stop` first.
#
#   leticode                     attach / start, leticode seat
#   leticode "one question"      one-shot, no TUI
#   leticode --new               a fresh leticode session
#   leticode --continue          reopen the newest session (its stored role wins)
#
# Everything else is forwarded to `letibot` unchanged. The dashboard is a separate window:
#   ~/bin/leticode-dash
#
# The shell and `web_fetch` are on by default here (`--no-bash`, `--no-web-fetch` turn them
# off). What the shell may run unasked is the preapproved list (~/.config/letibot/permission.json).
# The wrapper's name, for sentences that hand back a command: inside `letibot` `$0` is always
# `letibot`, and the role travels in the environment.
export LETIBOT_INVOKED_AS=leticode
export LETIBOT_ROLE=leticode
: "${LETIBOT_BASH:=1}"
export LETIBOT_BASH
# `letibot` reads `--no-web-fetch` itself.
: "${LETIBOT_WEB_FETCH:=1}"
export LETIBOT_WEB_FETCH
for a in "$@"; do
  case "$a" in
    --no-bash) LETIBOT_BASH="" ;;
  esac
done
args=()
for a in "$@"; do [ "$a" = "--no-bash" ] || args+=("$a"); done
exec letibot "${args[@]}"
