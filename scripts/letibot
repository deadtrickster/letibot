#!/usr/bin/env bash
# One command to start chatting: brings up harnessd if it is not already up,
# then attaches the TUI head to it. The daemon owns the session, the ledger and the model
# connection; a head can close mid-turn and reattach, and a second head can attach at once.
#
#   letibot                     attach, or start this folder's daemon on a NEW session
#                               (never a resume: that is --continue's, and only its)
#   letibot --continue          reopen the newest session in THIS workspace. Takes no argument;
#                               a session id after it is read as --session ID (and said);
#                               a session NAME (its /rename title) after it opens that one,
#                               here first, else in any folder (asked before moving there).
#   letibot --session ID|NAME   reopen a particular one; a NAME is a /rename title: exact
#                               (any case), else a unique prefix, in THIS workspace first
#                               and then in every folder (asked before moving there)
#   letibot --sessions          what is on disk, grouped: your conversations first, then the
#                               harness's own work (subagents, the review queue, packages,
#                               one-shots) one line each with a count. A session put out of
#                               sight is left out: --archived lists it, --archived-only alone
#   letibot --new [TITLE]       start a fresh session in the running daemon (with none up, the
#                               one the plain start opened IS this fresh session)
#   letibot --rename ID TITLE   name a stored session
#   letibot --delete ID         remove a stored session that has no rows
#   letibot --archive ID [REASON]  put a stored session out of sight and KEEP it: the rows
#                               stay and --session ID opens it again
#   letibot --unarchive ID      put it back in the list
#   letibot --migrate ID --to HOST   move this session's whole daemon to a host, or back
#                               with `--to local` (docs/remote-hosts.md RH4). The session's
#                               socket is forwarded back here, so --session attaches to it
#   letibot "some prompt"       one-shot: run it, print, exit (no TUI)
#   letibot --glm               GLM's dialect+vocab; providers.toml names the address
#   letibot --listen WORDS      mute or unmute a folder project's repositories before the start:
#                               -REPO, +REPO, only REPO|this, all (then the usual command runs)
#   letibot --stop              stop the daemon
#   letibot --restart           stop it keeping its host background jobs, start a new one on
#                               the newest session, and let that one take the jobs back
#   letibot --room              the box's room: start its coordinator if none is serving, and say
#                               what it is (`--room --stop` stops it). One per box, not per folder
#   letibot --status            is it up, and on what
#
# Reopening works with a daemon up or not:
#   no daemon    start harnessd with `--session ID`; it replays the stored tokens into a new
#                ledger, verifies the hash chain, and refuses by name if it does not reproduce.
#   daemon up    ask it over the socket (`letibot-tui --resume ID`), as the ctrl-s picker does.
#                Restarting the daemon would take down every other session.
#
# Each folder's daemon logs to ~/logs/harnessd-<folder hash>.log (~/logs/harnessd.log names
# which file a start went to); the socket lives in $XDG_RUNTIME_DIR.

set -euo pipefail

# Raised here so every child inherits it: a process cannot raise its soft limit past the hard
# limit it was born with, and Darwin's soft 256 is below what sqlite needs. `ulimit -Sn` keeps
# the hard limit; 8192, not unlimited, so a descriptor leak still trips.
OPEN_FILES_WANTED=8192
raise_open_files() { # raise_open_files ASKED
  local asked="$1" want hard soft got
  want="$asked"
  hard="$(ulimit -Hn 2>/dev/null || true)"
  # `unlimited` is the usual answer on this box and it is not a number: the request stands
  # as asked. A hard limit that IS a number caps the request.
  case "$hard" in
    '' | *[!0-9]*) : ;;
    *) if [ "$hard" -lt "$want" ]; then want="$hard"; fi ;;
  esac
  soft="$(ulimit -Sn 2>/dev/null || true)"
  case "$soft" in
    '') : ;;
    # Already unlimited, or already above the request: never lower one, and say nothing —
    # a person who started this from a shell with `ulimit -n 20000` meant it.
    *[!0-9]*) return 0 ;;
    *) if [ "$soft" -ge "$asked" ]; then return 0; fi ;;
  esac
  ulimit -Sn "$want" 2>/dev/null || true
  got="$(ulimit -Sn 2>/dev/null || true)"
  case "$got" in
    '' | *[!0-9]*) return 0 ;; # unlimited now, or unreadable: nothing to report
  esac
  if [ "$got" -ge "$asked" ]; then return 0; fi
  echo "letibot: open files: got $got, not the $asked asked for (this box's hard limit is ${hard:-unreadable}) - a fact about the box, not a failure; a long shift may still run out of them" >&2
}
raise_open_files "$OPEN_FILES_WANTED"

# Binaries live beside the launcher as typed (the install layout), else beside the script it
# resolves to, else that checkout's target/release. `LETIBOT_BIN` wins and a wrong value is
# named. Exported, so the daemon and every bridge it starts run the same build.
if [ -n "${LETIBOT_BIN:-}" ]; then
  BIN="$LETIBOT_BIN"
else
  _typed="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" 2>/dev/null && pwd -P)" || _typed="$(dirname -- "${BASH_SOURCE[0]}")"
  _self="$(readlink -f -- "${BASH_SOURCE[0]}" 2>/dev/null || printf '%s' "${BASH_SOURCE[0]}")"
  _dir="$(cd -- "$(dirname -- "$_self")" 2>/dev/null && pwd -P)" || _dir="$(dirname -- "$_self")"
  BIN=""
  for _cand in "$_typed" "$_dir" "$_dir/../target/release"; do
    if [ -x "$_cand/harnessd" ]; then
      BIN="$_cand"
      break
    fi
  done
  # Nothing found: keep the FIRST candidate, so the message below names the place a
  # reader would expect to look — beside the launcher.
  [ -n "$BIN" ] || BIN="$_typed"
  # Resolved once, so every message names a path a reader can paste.
  BIN="$(cd -- "$BIN" 2>/dev/null && pwd -P || printf '%s' "$BIN")"
fi
export LETIBOT_BIN="$BIN"
# The head is a seat's choice: the exec sites go through $LETIBOT_HEAD, utility calls stay on
# letibot-tui. A substitute head must speak `--socket S [--resume ID | --new-session TITLE]`.
HEAD="${LETIBOT_HEAD:-$BIN/letibot-tui}"

# One daemon per folder, tmux-style. The workspace is the git toplevel inside a checkout,
# else the current directory. Its daemon's socket is named by the workspace path, and a record
# beside it (pid, role, model, start) lets `--status`, `--stop` and `--ls` act on this
# folder's daemon by pid, never on every harnessd on the box.
#
#   letibot                     connect to this folder's daemon, or start one
#   letibot --attach [DIR]      connect only; refuse to start one
#   letibot --ls                every folder's daemon and the live sessions inside it
#   letibot --stop [--all]      this folder's daemon (or all of them)
WORKSPACE="${LETIBOT_WORKSPACE:-$(git -C "$PWD" rev-parse --show-toplevel 2>/dev/null || echo "$PWD")}"
# A failed cd must not leave this empty: an empty workspace is a socket key everything
# shares and a `--scope` that matches every session. A pruned worktree can be gone.
if ! WORKSPACE="$(cd "$WORKSPACE" 2>/dev/null && pwd -P)" || [ -z "$WORKSPACE" ]; then
  echo "letibot: cannot resolve a workspace from $PWD -- the directory may have been" >&2
  echo "         removed (a pruned git worktree does this). cd somewhere that exists," >&2
  echo "         or set LETIBOT_WORKSPACE." >&2
  exit 1
fi
# Host facts, asked the way each kernel answers: Linux has `/proc`, `ss`, `setsid(1)` and GNU
# `stat`/`date`; macOS uses `ps`, `lsof`, BSD `stat`/`date` and perl's `POSIX::setsid`.
# Every caller goes through these helpers.
HOST_OS="$(uname -s)"
# A folder's key and socket are the resolver's (`letibot-multi where --json`, which is
# `bridge::daemon::resolve`): a second spelling of the hash here names sockets nobody serves.
# folder_where DIR -- sets W_FOLDER, W_KEY and W_SOCKET; on failure WHERE_WHY, and returns 1.
WHERE_WHY=""
folder_where() {
  local json
  W_FOLDER="" W_KEY="" W_SOCKET=""
  if [ ! -x "$BIN/letibot-multi" ]; then
    WHERE_WHY="no letibot-multi at $BIN (it names a folder's daemon socket)"
    return 1
  fi
  if ! json="$("$BIN/letibot-multi" where "$1" --json 2>&1)"; then
    WHERE_WHY="letibot-multi where could not place $1: ${json##*$'\n'}"
    return 1
  fi
  # The fields are read with sed, so a path JSON had to escape is refused, not misread.
  case "$json" in *\\*)
    WHERE_WHY="letibot-multi where answered with an escaped path, which this launcher does not read: $json"
    return 1
    ;;
  esac
  W_FOLDER="$(printf '%s\n' "$json" | sed -n 's/.*"folder":"\([^"]*\)".*/\1/p')"
  W_KEY="$(printf '%s\n' "$json" | sed -n 's/.*"project":"\([^"]*\)".*/\1/p')"
  W_SOCKET="$(printf '%s\n' "$json" | sed -n 's/.*"socket":"\([^"]*\)".*/\1/p')"
  if [ -z "$W_FOLDER" ] || [ -z "$W_KEY" ] || [ -z "$W_SOCKET" ]; then
    WHERE_WHY="letibot-multi where gave no folder, project and socket: $json"
    return 1
  fi
}
# Is this pid still there? Linux: its `/proc` directory. macOS: `ps` has a state for it,
# and the state is not a zombie's.
pid_alive() { # pid_alive PID
  [ -n "$1" ] || return 1
  if [ "$HOST_OS" = Darwin ]; then
    case "$(ps -o stat= -p "$1" 2>/dev/null)" in '' | Z*) return 1 ;; *) return 0 ;; esac
  fi
  [ -d "/proc/$1" ]
}
# A pid's argument vector, one argument per line. macOS has no `cmdline` file; `ps` gives
# the arguments space-joined, which is enough for the flags this script looks for.
pid_argv() { # pid_argv PID
  if [ "$HOST_OS" = Darwin ]; then
    ps -ww -o args= -p "$1" 2>/dev/null | tr ' ' '\n'
    return 0
  fi
  tr '\0' '\n' <"/proc/$1/cmdline" 2>/dev/null
}
# The pids listening on a unix socket, by its bound path — which both `ss` and `lsof`
# still report after the file has been unlinked, the case `live` below is written for.
# Each listing runs to completion before the match, for the SIGPIPE reason `live` gives.
socket_pids() { # socket_pids PATH
  local listing
  if [ "$HOST_OS" = Darwin ]; then
    listing="$(lsof -nP -U -a -F pn 2>/dev/null || true)"
    printf '%s\n' "$listing" |
      awk -v s="$1" '/^p/ { p = substr($0, 2) } /^n/ && substr($0, 2) == s { print p }' |
      sort -u
    return 0
  fi
  listing="$(ss -lxpH 2>/dev/null || true)"
  printf '%s\n' "$listing" | grep -F "$1" | grep -oE 'pid=[0-9]+' | cut -d= -f2 | sort -u || true
}
# When a process started and when a file was written, as epoch seconds; empty if unknown.
pid_started() { # pid_started PID
  if [ "$HOST_OS" = Darwin ]; then
    local l
    l="$(LC_ALL=C ps -o lstart= -p "$1" 2>/dev/null | sed 's/ *$//')"
    [ -n "$l" ] && LC_ALL=C date -j -f '%a %b %e %T %Y' "$l" +%s 2>/dev/null
    return 0
  fi
  # The process start time, not the /proc dir mtime, which moves with its entries. Field 2 may
  # hold spaces and `)`, so fields are counted after the last `)`, where field 22 is field 20.
  local bt rest st hz
  bt="$(awk '/^btime/{print $2; exit}' /proc/stat 2>/dev/null)"
  case "$bt" in '' | *[!0-9]*) return 0 ;; esac
  rest="$(sed 's/^.*) //' "/proc/$1/stat" 2>/dev/null)" || return 0
  [ -n "$rest" ] || return 0
  st="$(printf '%s\n' "$rest" | awk '{print $20}')"
  case "$st" in '' | *[!0-9]*) return 0 ;; esac
  # `getconf` is the honest reader for a clock tick; 100 is Linux's own value on every
  # architecture this project runs on, and a wrong divisor would be a start time off by
  # a few minutes rather than a wrong day.
  hz="$(getconf CLK_TCK 2>/dev/null || echo 100)"
  case "$hz" in '' | *[!0-9]* | 0) hz=100 ;; esac
  echo $((bt + st / hz))
}
file_mtime() { # file_mtime PATH
  if [ "$HOST_OS" = Darwin ]; then stat -f %m "$1" 2>/dev/null || true; else stat -c %Y "$1" 2>/dev/null || true; fi
}
epoch_fmt() { # epoch_fmt SECONDS FORMAT
  if [ "$HOST_OS" = Darwin ]; then date -r "$1" "$2"; else date -d "@$1" "$2"; fi
}
# Run a command as the leader of a new session, detached from this terminal. macOS has the
# system call and not the command, and perl's POSIX module is on every Mac.
#
# On Linux also in a systemd scope of its own: `setsid` makes a session, not a cgroup, and a
# daemon left in a tmux window's scope is OOM-killed with the window.
# `Delegate=yes` lets the daemon make its own leaf and memory-capped job tree.
# `OOMPolicy=continue`: a job killed at its cap must not stop the daemon's scope.
# `--expand-environment=no`: systemd-run otherwise rewrites `$X` in the arguments.
# With no user manager the scope cannot be made, `scope_ok` says so with the manager's own
# answer, and the daemon reports its tool calls as uncapped. The probe is bounded.
SCOPE_PROBE_SECONDS=2
SCOPE_WHY=""
# A command that cannot outlive `SCOPE_PROBE_SECONDS`. `timeout` is coreutils and is absent on a
# Mac, where this is not asked anyway.
probe_bounded() {
  if command -v timeout >/dev/null 2>&1; then
    timeout -k 1 "$SCOPE_PROBE_SECONDS" "$@"
    return $?
  fi
  "$@"
}
# A probe past its bound is left running, not killed. The session starts without waiting;
# the answer lands in `SCOPE_LATE` (`rc<TAB>seconds<TAB>last line`) and the daemon relays it.
# One probe per launcher run; the directory is the lock.
SCOPE_LATE=""
# The late probe ends too, so its directory is answered and swept.
SCOPE_PROBE_LATE_SECONDS=600
scope_probe_start() {
  local dir="$RUNDIR/scope-probe-$$"
  SCOPE_LATE="$dir/answer"
  mkdir -p "$RUNDIR" 2>/dev/null || true
  # Every probe answers within SCOPE_PROBE_LATE_SECONDS, so an hour-old directory has no waiter.
  find "$RUNDIR" -maxdepth 1 \( -name 'scope-probe-*' -o -name 'scope-join-*' \) -mmin +60 \
    -exec rm -rf '{}' + 2>/dev/null || true
  mkdir "$dir" 2>/dev/null || return 0
  # Twice forked, so the probe is nobody's child here and outlives an `exec`.
  (
    (
      started=$(date +%s)
      rc=0
      bound=()
      if command -v timeout >/dev/null 2>&1; then bound=(timeout -k 5 "$SCOPE_PROBE_LATE_SECONDS"); fi
      out="$(${bound[@]+"${bound[@]}"} systemd-run --user --scope --quiet --collect --expand-environment=no true 2>&1)" || rc=$?
      line="$(printf '%s\n' "$out" | grep -v '^[[:space:]]*$' | tail -1 || true)"
      case "$rc" in 124 | 137) [ "${#bound[@]}" -eq 0 ] || line="no answer in ${SCOPE_PROBE_LATE_SECONDS}s" ;; esac
      printf '%s\t%s\t%s\n' "$rc" "$(($(date +%s) - started))" "$line" >"$SCOPE_LATE.tmp" &&
        mv "$SCOPE_LATE.tmp" "$SCOPE_LATE"
    ) </dev/null >/dev/null 2>&1 &
  )
}
# Waits up to `SCOPE_PROBE_SECONDS` for the answer, with one live line on a terminal so a slow
# manager does not look like a hung launcher. 0 when it answered.
scope_probe_wait() {
  local i=0 ticks=$((SCOPE_PROBE_SECONDS * 10)) shown=""
  # An earlier caller in this run already waited the bound out.
  [ -f "${SCOPE_LATE%/*}/late" ] && [ ! -f "$SCOPE_LATE" ] && return 1
  while [ ! -f "$SCOPE_LATE" ] && [ "$i" -lt "$ticks" ]; do
    if [ -t 2 ] && [ $((i % 10)) -eq 5 ]; then
      printf '\rletibot: waiting for systemd (%ss)...' "$((SCOPE_PROBE_SECONDS - i / 10))" >&2
      shown=1
    fi
    sleep 0.1
    i=$((i + 1))
  done
  [ -n "$shown" ] && printf '\r\033[K' >&2
  [ -f "$SCOPE_LATE" ] && return 0
  : >"${SCOPE_LATE%/*}/late" 2>/dev/null || true
  return 1
}
scope_ok() {
  SCOPE_WHY=""
  if [ "$HOST_OS" = Darwin ]; then
    SCOPE_WHY="macOS has no systemd user manager, and needs none"
    return 1
  fi
  if ! command -v systemd-run >/dev/null 2>&1; then
    SCOPE_WHY="there is no systemd-run on this PATH"
    return 1
  fi
  local rc line
  scope_probe_start
  if ! scope_probe_wait; then
    SCOPE_WHY="late"
    return 1
  fi
  IFS=$'\t' read -r rc _ line <"$SCOPE_LATE" || rc=1
  [ "$rc" = 0 ] && return 0
  # The manager's own last line, which is where systemd puts the reason.
  SCOPE_WHY="the user manager refused a scope: ${line:-exit $rc with nothing said}"
  return 1
}
# Sets SCOPE_RUN to the words that start a command in such a scope, or to nothing.
# Every daemon goes under `letibot.slice` so letibot can be throttled and swept as a whole.
# `LETIBOT_SCOPE_RUNTIME_MAX` (a systemd timespan) opts into a wall-clock bound.
SCOPE_SLICE=letibot.slice
SCOPE_RUNTIME_WHY=""
scope_accepts_runtime_max() {
  local out rc=0
  out="$(probe_bounded systemd-run --user --scope --quiet --collect --expand-environment=no \
    -p "RuntimeMaxSec=$1" true 2>&1)" || rc=$?
  [ "$rc" -eq 0 ] && return 0
  SCOPE_RUNTIME_WHY="$(printf '%s\n' "$out" | grep -v '^[[:space:]]*$' | tail -1 || true)"
  return 1
}
SCOPE_LATE_LINE="letibot: the systemd user manager is not answering - the daemon runs without its own scope, and memory caps and io accounting are off for it. Its sessions are told when systemd answers."
# The probe asked in this shell, before a detach, so its wait and its degraded line are on the
# operator's terminal and not only in the daemon's log. The detached call then finds the answer,
# or the late mark, without waiting again.
scope_ask_here() {
  [ "$HOST_OS" = Darwin ] && return 0
  if ! scope_ok && [ "$SCOPE_WHY" = late ]; then
    echo "$SCOPE_LATE_LINE" >&2
  fi
}
scope_run() { # scope_run UNIT-STEM
  SCOPE_RUN=()
  unset LETIBOT_SCOPE_LATE
  if scope_ok; then
    SCOPE_RUN=(systemd-run --user --scope --quiet --collect --expand-environment=no
      --unit "$1-$KEY-$$" --slice "$SCOPE_SLICE" -p Delegate=yes -p OOMPolicy=continue)
    if [ -n "${LETIBOT_SCOPE_RUNTIME_MAX:-}" ]; then
      if scope_accepts_runtime_max "$LETIBOT_SCOPE_RUNTIME_MAX"; then
        SCOPE_RUN+=(-p "RuntimeMaxSec=$LETIBOT_SCOPE_RUNTIME_MAX")
      else
        echo "letibot: the user manager would not put a runtime bound on a scope: ${SCOPE_RUNTIME_WHY:-it refused, and said nothing} - the hard TTL is the reaper's, which reads the owner row" >&2
      fi
    fi
  elif [ "$SCOPE_WHY" = late ]; then
    export LETIBOT_SCOPE_LATE="$SCOPE_LATE"
    echo "$SCOPE_LATE_LINE" >&2
  elif [ "$HOST_OS" != Darwin ]; then
    echo "letibot: ${SCOPE_WHY} - harnessd shares this terminal's cgroup, and its tool calls run uncapped" >&2
  fi
}
# A good probe says the manager answered once, not that it makes this scope now. The real join
# is bounded too; past the bound the scope is given up and the command runs without one.
SCOPE_JOIN_SECONDS=5
SCOPE_PID=""
# scope_join COMMAND [ARGS...] -- start COMMAND in the scope SCOPE_RUN names. 0 with SCOPE_PID
# once it is in, 1 after the join was given up and killed. Whoever makes the gate directory
# first decides a join that lands at the bound, so the command never runs twice.
scope_join() {
  local gate i=0
  gate="$RUNDIR/scope-join-$$-$RANDOM"
  # shellcheck disable=SC2016 # expanded by the child shell, inside the scope
  "${SCOPE_RUN[@]}" "$BASH" -c 'mkdir "$0" 2>/dev/null || exit 125; exec "$@"' "$gate" "$@" <&0 &
  SCOPE_PID=$!
  while [ ! -d "$gate" ] && [ "$i" -lt $((SCOPE_JOIN_SECONDS * 10)) ] && kill -0 "$SCOPE_PID" 2>/dev/null; do
    sleep 0.1
    i=$((i + 1))
  done
  if mkdir "$gate" 2>/dev/null; then
    kill -KILL "$SCOPE_PID" 2>/dev/null || true
    wait "$SCOPE_PID" 2>/dev/null || true
    rmdir "$gate" 2>/dev/null || true
    SCOPE_PID=""
    echo "letibot: the user manager made no scope in ${SCOPE_JOIN_SECONDS}s - harnessd runs without its own scope, and its tool calls run uncapped" >&2
    return 1
  fi
  rmdir "$gate" 2>/dev/null || true
  return 0
}
# scope_wait -- wait for the joined command, passing TERM and HUP on, and exit with its status.
# INT is the terminal's and reaches the command's process group without help.
scope_wait() {
  local rc=0 again=0
  trap 'kill -TERM "$SCOPE_PID" 2>/dev/null' TERM HUP
  trap ':' INT
  while :; do
    rc=0
    wait "$SCOPE_PID" || rc=$?
    kill -0 "$SCOPE_PID" 2>/dev/null || break
  done
  # A wait cut short by a trap returns above 128; the reaped child's own status is asked again.
  if [ "$rc" -gt 128 ]; then
    wait "$SCOPE_PID" 2>/dev/null || again=$?
    [ "$again" -eq 127 ] || rc=$again
  fi
  exit "$rc"
}
detach() { # detach UNIT-STEM COMMAND [ARGS...]
  # The caller names the scope: every call runs under `&`, in a subshell, so a counter kept here
  # never reaches the next call and the room and a daemon started by one launcher asked for one
  # unit name, which systemd refuses.
  local stem=$1
  shift
  if [ "$HOST_OS" = Darwin ]; then
    exec /usr/bin/perl -MPOSIX -e 'POSIX::setsid(); exec { $ARGV[0] } @ARGV or die "detach: $ARGV[0]: $!\n"' -- "$@"
  fi
  scope_run "$stem"
  if [ "${#SCOPE_RUN[@]}" -gt 0 ] && scope_join setsid "$@"; then
    scope_wait
  fi
  # Exec'd, so the caller's pid is the daemon's and a give-up can stop it.
  exec setsid "$@"
}

# The runtime dir: `$XDG_RUNTIME_DIR/letibot`, else `/run/user/<uid>/letibot` on Linux and
# the per-user temp dir on macOS — asked of `getconf`, not read from `$TMPDIR`, so a
# daemon started without that variable lands where the head looks (`launcher.rs::rundir`).
if [ -n "${XDG_RUNTIME_DIR:-}" ]; then
  RUNDIR="$XDG_RUNTIME_DIR/letibot"
elif [ "$HOST_OS" = Darwin ]; then
  _tmp="$(getconf DARWIN_USER_TEMP_DIR 2>/dev/null || true)"
  RUNDIR="${_tmp:-${TMPDIR:-/tmp/}}"
  RUNDIR="${RUNDIR%/}/letibot"
else
  RUNDIR="/run/user/$(id -u)/letibot"
fi
# The runtime dir is made where something is written into it, not here: `--help`, `--status`
# and `--ls` answer on a box whose `/run/user` is missing, and a bare `mkdir -p` under `set -e`
# in front of the flag is how `--help` died before printing a line.
rundir() {
  mkdir -p "$RUNDIR" 2>/dev/null && return 0
  die "cannot create the runtime directory $RUNDIR
         set XDG_RUNTIME_DIR to a directory this account can write"
}
# The resolver's folder too: `LETIBOT_WORKSPACE` in a subdirectory is that checkout's daemon,
# as it is for `letibot where` and the bridge. Asked once; a verb that needs none still runs
# without letibot-multi, and `need_where` refuses the ones that do.
KEY="" SOCKET=""
if folder_where "$WORKSPACE"; then
  WORKSPACE="$W_FOLDER" KEY="$W_KEY" SOCKET="$W_SOCKET"
fi
RECORD="$RUNDIR/$KEY.json"
need_where() { [ -n "$KEY" ] || die "$WHERE_WHY"; }
# The data home as `lifecycle::data_dir` reads it: XDG_DATA_HOME only when absolute. The verbs,
# the bridge and the room resolve the same, so the daemon's store is the one they act on.
case "${XDG_DATA_HOME:-}" in
  /*) DATA_HOME="$XDG_DATA_HOME" ;;
  *) DATA_HOME="$HOME/.local/share" ;;
esac
STORE="${LETIBOT_STORE:-$DATA_HOME/letibot}"
# An exported LETIBOT_STORE=.../sessions.db outlives the split: once shared.db is beside it, the
# directory is the store, and the daemon refuses the old file by name.
if [ "$(basename "$STORE")" = sessions.db ] && [ -f "$(dirname "$STORE")/shared.db" ]; then
  STORE="$(dirname "$STORE")"
fi
# The one file a caller that still takes a single store path wants: `letibot migrate` moves a
# session's project file, and the key is the one this folder's socket already wears.
STORE_FILE="$STORE/projects/$KEY.db"
STORE_DIR="$STORE"
# A single file (LETIBOT_STORE=.../sessions.db, a pre-split box) lives in its directory.
[ -f "$STORE" ] && STORE_DIR="$(dirname "$STORE")"
# A data directory not yet split still holds sessions.db: hand that file over, which every
# daemon opens, until `letibot-migrate-split` has run. The split build refuses the bare dir.
if [ -z "${LETIBOT_STORE:-}" ] && [ -f "$STORE/sessions.db" ] && [ ! -e "$STORE/shared.db" ]; then
  STORE="$STORE/sessions.db"
  STORE_FILE="$STORE"
fi

# Each folder's daemon logs to its own file, keyed like its socket, so a boot failure's tail
# is that daemon's. `SHARED_LOG` gets one line per start naming where that daemon logs.
SHARED_LOG="$HOME/logs/harnessd.log"
LOG="${LETIBOT_LOG:-$HOME/logs/harnessd-$KEY.log}"

# The daemon needs no GPU: it links libllama only for the tokenizer, but ggml opens a CUDA
# context on every card at load (about 1.1 GB). Inference is the model server's.
# Set for harnessd only, not exported, so a later child that wants a GPU still gets one.
NOGPU=(env CUDA_VISIBLE_DEVICES=)

die() {
  echo "letibot: $*" >&2
  exit 1
}

# The command the person typed, for every sentence that hands one back. `leticode` execs
# this script, so `$0` is `letibot`; the wrapper names itself in `LETIBOT_INVOKED_AS`.
ME="${LETIBOT_INVOKED_AS:-$(basename "$0")}"

# `--glm`/`--dense` are consumed by the flag loop and never reach `EXTRA_ARGS`, so the
# model choice is recorded here for the attach checks. Empty means the model was left alone.
MODEL_FLAG=""

# What would apply this run's model choice, in the person's own words: their verb,
# their flag. One function because three sentences hand a command back and three
# copies would be three answers to *what do I run next*.
restart_advice() {
  if [ -n "$MODEL_FLAG" ]; then
    printf '%s --stop && %s %s' "$ME" "$ME" "$MODEL_FLAG"
  else
    printf '%s --stop && %s' "$ME" "$ME"
  fi
}

# `need WHAT VERB`: the argument a verb was left without, and where the rest of the sentence is.
# One shape for every missing argument, so the next step is never the thing that is missing.
need() { # need WHAT VERB
  die "$2 needs $1
         run \`$ME $2 --help\` for what it takes"
}

# The config reference is the multicall's verb and parses its own flags (`--markdown`, `--as`),
# so it is handed over before the flag guard can refuse them.
case "${1:-}" in
  --config-reference | --config-header)
    [ -x "$BIN/letibot-multi" ] || die "no letibot-multi at $BIN (the config reference lives there)"
    exec "$BIN/letibot-multi" "$@"
    ;;
  doctor)
    # Its own flags (`--json`) and exit codes (0 ok, 1 warn, 2 FAIL), so it goes before the guard.
    [ -x "$BIN/letibot-multi" ] || die "no letibot-multi at $BIN (the doctor lives there)"
    exec "$BIN/letibot-multi" "$@"
    ;;
esac

# `<verb> --help` answers for that verb. One wall of text for every question is what this
# was: a person asking about `--delete` read twenty commands to find the one they typed.
verb_help() { # verb_help VERB
  case "$1" in
    --continue | -c)
      cat <<'EOF'
letibot --continue
  Reopen the newest session in THIS workspace. The only verb that reopens anything
  without being asked which; it takes no argument.

  --continue s-ID   an id is read as `--session s-ID` and the reading is said out loud
  --continue NAME   a session name (its /rename title) opens that session, as `--session NAME`.
                    Looked up in this workspace first, then in every folder. A match in another
                    folder is offered with "Open it there? [Y/n]", and yes opens it in its own
                    folder. With no terminal it is refused with the folder and the command to run.

  example:
    letibot --continue
EOF
      ;;
    --session | -s)
      cat <<'EOF'
letibot --session ID|NAME
  Reopen one stored session, starting this folder's daemon if none is up.

  ID   the session id (`letibot --sessions` lists them, and so does ctrl-s in the head)
  NAME a /rename title: exact (any case), else a unique prefix. This workspace is searched
       first, then every folder; a match elsewhere is offered ("Open it there? [Y/n]", or a
       numbered list for several) and opens in that folder. An ambiguous or unknown name is
       refused with the candidates. A program cannot change its shell's directory, so the
       `cd` line is printed for you.

  example:
    letibot --session s-1789919514688401228
EOF
      ;;
    --sessions | --list)
      cat <<'EOF'
letibot session list
  What is on disk, grouped: your conversations first, then the harness's own work
  (subagents, the review queue, packages, one-shots), one line each with a count.
  `--sessions` is its old spelling.

  `--tsv` is the plain five-column form; `--archived`, `--archived-only` the archived ones

  example:
    letibot session list
EOF
      ;;
    --new | -n)
      cat <<'EOF'
letibot --new [TITLE]
  Start a fresh session in the running daemon. With none up, the session the plain
  start opens IS this fresh one.

  TITLE   what to name it (default: unnamed until `--rename`)

  example:
    letibot --new 'the queue wedge'
EOF
      ;;
    --rename)
      cat <<'EOF'
letibot session rename ID [TITLE]
  Name a stored session. `--rename` is its old spelling.

  ID      the session id (`letibot session list` lists them)
  TITLE   the new name; an empty title clears the name

  example:
    letibot session rename s-1789919514688401228 'gate red'
EOF
      ;;
    --delete)
      cat <<'EOF'
letibot session delete ID
  Remove a stored session that has no rows. A session with rows is refused by name,
  never deleted. `--delete` is its old spelling.

  ID   the session id (`letibot session list` lists them)

  example:
    letibot session delete s-1789919514688401228
EOF
      ;;
    --migrate)
      cat <<'EOF'
letibot --migrate SESSION --to HOST [--copy-keys]
  Move a session's whole daemon - its rows, its checkout and a harnessd - to a host,
  and leave a marked copy here. `--to local` brings it back.

  SESSION        the session to move
  --to HOST      a `[host.NAME]` from hosts.toml, or `local` (required)
  --copy-keys    send this box's providers.toml too, mode 600, never printed

  example:
    letibot --migrate s-1789919514688401228 --to lab2x1      (`letibot migrate --help`
                                                            has every flag)
EOF
      ;;
    --reattach)
      cat <<'EOF'
letibot --reattach SESSION
  Re-establish a moved session's daemon and its forwarded socket, when a head
  cannot reach it. `--migrate SESSION --to local` brings the session back instead.

  SESSION   the moved session's id

  example:
    letibot --reattach s-1789919514688401228
EOF
      ;;
    attach-github | attach)
      cat <<'EOF'
letibot attach github <org|owner/repo>
  The GitHub reviewer seat: poll the scope's open pull requests, one session per
  pull request, one review per push. Drafts until `[github] post` and a token are set.

  <org|owner/repo>   `stroppy-io` for a whole org, `stroppy-io/letibot` for one

  example:
    letibot attach github stroppy-io/letibot
EOF
      ;;
    --stop)
      cat <<'EOF'
letibot --stop [N|DIR] [--all] [--force]
  Interrupt this folder's daemon's turns, then stop it.

  N|DIR   another folder's daemon: the number `letibot --ls` prints, or its directory
          (default: this folder's)
  --all   every folder's daemon on this box
  --force SIGKILL one still there 5s after SIGTERM (the last resort, and it says so)

  example:
    letibot --stop
EOF
      ;;
    --restart)
      cat <<'EOF'
letibot --restart
  Restart this folder's daemon, to pick up a new build, without ending its background
  jobs: the stopping daemon leaves its host jobs running, and the new one takes them back
  when it opens the session (`--continue` here; another session on its own reopening).
  A VM's jobs cannot outlive the VM and end, as with `--stop`.

  no arguments

  example:
    letibot --restart
EOF
      ;;
    --room)
      cat <<'EOF'
letibot --room [--stop [--force]]
  The BOX'S ROOM: one coordinator per machine, shared by every folder, where tags and
  the queue's asks are arbitrated. Bare, it makes sure one is serving and says what it is.

  --stop    stop it

  With `letibot rooms install` (socket activation) both go to `letibot rooms start|stop`.

  example:
    letibot --room
EOF
      ;;
    --status)
      cat <<'EOF'
letibot --status
  Is this folder's daemon up, on what model, and which binary it was started from.

  no arguments

  example:
    letibot --status
EOF
      ;;
    --ls | --list-all)
      cat <<'EOF'
letibot --ls
  Every folder's daemon and the live sessions inside it, numbered: the number is what
  `letibot --stop N` and `letibot --attach N` take.

  no arguments

  example:
    letibot --ls
EOF
      ;;
    --where)
      cat <<'EOF'
letibot --where [FOLDER] [--ensure] [--json]
  The socket this folder's daemon listens on — exactly what `bridge::daemon::resolve`
  computes: $LETIBOT_SOCKET when set, else <rundir>/<sha256(folder)[..12]>.sock — and
  whether a daemon is live there. A program that drives letibot asks this instead of
  hashing the path itself.

  FOLDER     the folder (default: this one), as its git toplevel
  --ensure   start the folder's daemon when none is running, then answer
  --json     one object: socket, live, project (the key), folder

  The plain form is two lines: the socket, and then `up` or `down`.

  example:
    letibot --where --json
    letibot --where --ensure --json      (what an editor panel runs to start one)
EOF
      ;;
    --attach)
      cat <<'EOF'
letibot --attach [N|DIR]
  Connect to a daemon that is already up, and never start one: bare `letibot` starts a
  daemon when nothing is there, and this refuses instead.

  N|DIR   another folder's daemon: the number `letibot --ls` prints, or its directory
          (default: this folder's)

  example:
    letibot --attach
EOF
      ;;
    --list-claude | --claude-sessions)
      cat <<'EOF'
letibot --list-claude
  What Claude Code has on this box: the id `letibot --session cc-<id>` takes, its model,
  its directory and its first line. Reading one in makes it an ordinary session.

  no arguments; `--tsv` is the plain data form

  example:
    letibot --list-claude
EOF
      ;;
    --handover)
      cat <<'EOF'
letibot --handover SESSION DIR
  Write a letibot session out as a transcript `claude --resume <path>` opens, plus a
  Markdown copy a person can read.

  SESSION   the session to write out
  DIR       where both files go (created if missing)

  example:
    letibot --handover s-1789919514688401228 ~/tmp/handover
EOF
      ;;
    --note)
      cat <<'EOF'
letibot --note TRANSCRIPT TEXT
  Append one line to a Claude Code transcript, after a backup of it.

  TRANSCRIPT   the .jsonl path
  TEXT         the line's text

  example:
    letibot --note ~/.claude/projects/x/abc.jsonl 'moved to letibot'
EOF
      ;;
    --note-continued)
      cat <<'EOF'
letibot --note-continued SESSION TRANSCRIPT [DIR]
  The same line, composed: where the session continued, its git branch and sha. It also
  writes the handover it names.

  SESSION      the letibot session it continued into
  TRANSCRIPT   the Claude Code .jsonl to write the line into
  DIR          where the handover goes (default: beside the transcript)

  example:
    letibot --note-continued s-1789919514688401228 ~/.claude/projects/x/abc.jsonl
EOF
      ;;
    --revert)
      cat <<'EOF'
letibot --revert TRANSCRIPT BACKUP
  Put a transcript back from the backup `--note` took, byte for byte.

  TRANSCRIPT   the .jsonl to restore
  BACKUP       the backup path that was written

  example:
    letibot --revert ~/.claude/projects/x/abc.jsonl ~/.claude/projects/x/abc.jsonl.bak
EOF
      ;;
    *) usage ;;
  esac
}

# Help before anything: no network, no daemon probe, no vocabulary. Unknown `--` words are
# refused rather than sent as a one-shot prompt, which would be a billed model turn.

# The flags this parser reads, in one list; the help is generated from it.
#
# One row per flag: `NAME[,NAME...]|TIER|VALUE|NOTE`.
#   NAME   every spelling, space separated; the first is the one the help prints
#   TIER   daily   `letibot --help` - the seven a person types, and nothing else
#          more    `letibot --help all`
#          config  the setting lives in a file; using the flag prints the key to set
#   VALUE  the placeholder for the word it consumes, or empty when it takes none (which is
#          also what keeps a value like `--mem` from being read as a flag of ours)
#   NOTE   one line: what it is for, or for `config`, the key and the file
#
# The guard below reads only this list, and `tests/launcher.sh` checks every flag both help
# pages print. A new flag is added here first.
flags_table() {
  cat <<'EOF'
--help -h help         |daily |       |this page; `--help all` for every other flag
-c --continue          |daily |       |reopen the newest session in THIS workspace
--stop                 |daily |N/DIR  |stop this folder's daemon; `--force` kills one that stays, `--all` every folder
--restart              |daily |       |restart this folder's daemon keeping its background jobs, then reopen the newest session
--status               |daily |       |is it up, and on what
--ls                   |daily |       |every folder's daemon and the live sessions inside it, numbered
--no-bash              |daily |       |seat no shell (the shell is on by default)
--sessions --list      |more  |       |old spelling of `session list`
--tsv                  |more  |       |a listing in its plain form, one line each with no grouping
--list-claude --claude-sessions |more |  |what Claude Code has on this box, and the id `--session cc-<id>` takes
--providers            |more  |       |every provider: built-ins, `[provider.NAME]` entries, env base URLs
--handover             |more  |SESSION DIR |write a session out as a `claude --resume` transcript, plus Markdown
--note                 |more  |TRANSCRIPT TEXT |append one line to a Claude Code transcript, after a backup
--note-continued       |more  |SESSION FILE |the same line, composed, plus the Markdown handover
--revert               |more  |TRANSCRIPT BACKUP |put that transcript back from the backup, byte for byte
--new -n               |more  |       |start a fresh session in the running daemon (`--new TITLE` names it)
--rename               |more  |ID     |old spelling of `session rename`
--delete               |more  |ID     |old spelling of `session delete`
--archive              |more  |ID     |old spelling of `session archive`
--unarchive            |more  |ID     |old spelling of `session unarchive`
--archived             |more  |       |with `session list`: the archived ones beside the rest
--archived-only        |more  |       |with `session list`: nothing but the archived ones
--migrate              |more  |       |move a session's whole daemon to a host: `--migrate ID --to HOST`
--reattach             |more  |ID     |re-establish a moved session's daemon and forwarded socket
--to                   |more  |HOST   |where `--migrate` goes; `--to local` brings it back
--copy-keys            |more  |       |with `--migrate`: send providers.toml too (mode 600, never printed)
--force                |more  |       |with `--stop`/`--room --stop`: SIGKILL one still there after 5s
--all                  |more  |       |with `--stop`: every folder's daemon, not this one
--room                 |more  |       |the BOX'S ROOM coordinator, one per box (`--room --stop` stops it)
--list-all             |more  |       |`--ls` under its long name
--where                |more  |[FOLDER] |the socket this folder's daemon listens on, and whether it is up
--ensure               |more  |       |with `--where`: start the daemon when none is running
--json                 |more  |       |with `--where`: one object - socket, live, project, folder
--config-reference     |more  |       |every option of every config file, or of one (`letibot --config-reference --help`)
--config-header        |more  |       |write the reference block into a TOML config file's header: `--config-header FILE`
--attach               |more  |[N/DIR] |connect only, never start: this folder's daemon, or another's by number
--listen               |more  |[WORDS] |which repositories of this folder's sessions hear gate news
--read-only            |more  |       |no write tools at all (the orchestrator seat)
--ask                  |more  |       |every write asks, every time, and the answer settles that one call
--web-fetch            |more  |       |seat `web_fetch`: curl egress, reader-mode extracted
--no-web-fetch         |more  |       |the same, off
--mode                 |more  |NAME   |read-only / always-ask / writes-allowed / automode / automode-edits / allow-all
--supervise            |more  |       |start with the guard model consulted on every gated call (needs `--oracle`)
--vm                   |more  |       |run the session - and its subagents - in a firecode VM, which is the boundary
--vm-copy              |more  |       |with `--vm`: a copy even on a Mac
--vm-arg               |more  |ARG    |passed to the VM's own launch, repeatable
--host                 |more  |NAME   |run this session's TOOLS on that machine over ssh (a `[host.NAME]` block)
--web-search           |more  |NAME   |attach a provider behind `web_search` (`brave` is the one there is)
--glm                  |more  |       |GLM's dialect, vocabulary and endpoint, when the daemon STARTS
--dense                |more  |       |the Qwen 27B dense model, when the daemon STARTS
--session -s           |more  |ID/NAME |reopen a particular session; `--session host` is the box's own agent
--provider             |config|NAME   |`[default] provider` in ~/.config/letibot/providers.toml
--model                |config|NAME   |`[default] model` in ~/.config/letibot/providers.toml
--effort               |config|LEVEL  |off, low, medium, high, max: `effort = "high"` in that model's `[model._]` block, providers.toml
--brave-key            |config|KEY    |`[brave] key` in ~/.config/letibot/providers.toml
--oracle               |config|HOST:PORT |`[gatekeeper] endpoint` in ~/.config/letibot/providers.toml
--oracle-budget-ms     |config|MS     |`[gatekeeper] budget_ms` in ~/.config/letibot/providers.toml
EOF
}

# What this release took away, and what replaced it. A removed flag is refused by name
# with its replacement, rather than read as a one-shot prompt.
removed_flags_table() {
  cat <<'EOF'
--daemons  |`--ls` - the same listing, numbered, and it is the one `--stop N` takes
--writes   |nothing: writes-allowed is the default. `--mode writes-allowed` says it out loud
--bash     |nothing: the shell is on by default, and `--no-bash` is how you seat none
--flash    |`[default] model` in ~/.config/letibot/providers.toml (Qwen Flash-Next is the default)
EOF
}

flag_field() { # flag_field WORD FIELD -- one field of WORD's row (2 tier, 3 value, 4 note)
  flags_table | while IFS='|' read -r names tier value note; do
    case " $names " in
      *" $1 "*)
        case "$2" in
          2) printf '%s' "$tier" ;;
          3) printf '%s' "$value" ;;
          4) printf '%s' "$note" ;;
        esac
        return 0
        ;;
    esac
  done
}

known_flag() { # known_flag WORD -- is WORD one of the flags this parser reads?
  [ -n "$(flag_field "$1" 2)" ]
}

flag_takes_value() { # flag_takes_value WORD -- does it consume the word after it?
  [ -n "$(flag_field "$1" 3)" ]
}

removed_flag() { # removed_flag WORD -- the replacement, when WORD is one this release removed
  removed_flags_table | while IFS='|' read -r name why; do
    name=$(printf '%s' "$name" | tr -d ' ') # the column is padded
    [ "$name" = "$1" ] || continue
    printf '%s' "$why"
    return 0
  done
}

pad() { # pad STRING WIDTH -- STRING in a column, one trailing space at least
  _p="$1 "
  while [ ${#_p} -lt "$2" ]; do _p="$_p "; done
  printf '%s' "$_p"
}

flag_lines() { # flag_lines TIER -- one line per row of that tier
  want="$1"    # a variable: the loop below reassigns `$1` with `set --`
  flags_table | while IFS='|' read -r names tier value note; do
    tier=$(printf '%s' "$tier" | tr -d ' ') # the column is padded; the tier word is not
    [ "$tier" = "$want" ] || continue
    # Every spelling, so a page that lists `-c` also names `--continue`: an alias the help
    # omits is an alias a person cannot find.
    label=""
    for n in $names; do
      label="${label:+$label, }$n"
    done
    [ -n "$value" ] && label="$label $value"
    printf '  %s%s\n' "$(pad "$label" 27)" "$note"
  done
}

usage() {
  cat <<'EOF'
letibot — one command to start chatting: brings up harnessd if it is not
already up, then attaches the TUI head to it.

  letibot                     attach to this folder's daemon, starting one on a NEW session
                              if none is up; it never resumes by itself
  letibot "some prompt"       one-shot: run it, print, exit (no TUI)
  letibot -c                  reopen the newest session in THIS workspace
  letibot --stop [N|DIR]      stop this folder's daemon (`--force`, `--all`)
  letibot --restart           restart it on a new build, keeping its background jobs
  letibot --status            is it up, and on what
  letibot --ls                every folder's daemon and the live sessions inside it, numbered
  letibot --no-bash           seat no shell (the shell is on by default)

  letibot --help all          every flag this command takes: sessions, migration, the seat,
                              the model, remote hosts, the room, the VM
  letibot session list        what is on disk; also show, rename, archive, unarchive, delete
  letibot <verb> --help       a verb's own page: session, stats, boundary, notes, browser,
                              rooms, holds, hold, release, gc, where, migrate, fb, attach
  letibot --help removed      what this release took away, and what replaced it

Every setting that lives in a file stays in a file: ~/.config/letibot/providers.toml for
the model, the keys and the guard, the project's leticode.toml for the rest. A flag that has
a config key says so when it is used.
EOF
}

usage_all() {
  cat <<'EOF'
letibot — every flag this command takes, and the file each setting can live in.

  letibot                     attach to this folder's daemon, starting one on a NEW session
  letibot "some prompt"       one-shot: run it, print, exit (no TUI)

WHAT YOU TYPE EVERY DAY
EOF
  flag_lines daily
  cat <<'EOF'

WHEN YOU NEED IT
EOF
  flag_lines more
  cat <<'EOF'

SETTINGS THAT LIVE IN A FILE (using the flag prints the key to set)
EOF
  flag_lines config
  cat <<'EOF'

VERBS
  session list|show|rename|archive|unarchive|delete   the stored sessions
  stats, boundary, notes, browser, rooms, holds, hold, release, gc, where, migrate, fb,
  attach, doctor
  `letibot <verb> --help` is that verb's own page; a verb with no page prints this list.

Env overrides: LETIBOT_BIN LETIBOT_SOCKET LETIBOT_WORKSPACE LETIBOT_STORE
LETIBOT_LOG LETIBOT_DIALECT LETIBOT_MODEL LETIBOT_VOCAB
LETIBOT_ROLE LETIBOT_ADJUDICATOR LETIBOT_MODE LETIBOT_BASH LETIBOT_WEB_FETCH
LETIBOT_GRANTS_RO LETIBOT_ORACLE LETIBOT_ORACLE_BUDGET_MS LETIBOT_ENDPOINT

Providers by env: ANTHROPIC_BASE_URL (+ ANTHROPIC_API_KEY or ANTHROPIC_AUTH_TOKEN,
ANTHROPIC_MODEL) is `--provider env-anthropic`; OPENAI_BASE_URL (+ OPENAI_API_KEY,
OPENAI_MODEL, LETIBOT_OPENAI_PROTOCOL=responses) is `--provider env-openai`.

`letibot --help removed` lists the flags this release deleted, and what replaced each.
EOF
}

usage_removed() {
  cat <<'EOF'
letibot — flags this release removed, and what replaced each.

EOF
  removed_flags_table | while IFS='|' read -r name why; do
    name=$(printf '%s' "$name" | tr -d ' ')
    [ -n "$name" ] || continue
    printf '  %s%s\n' "$(pad "$name" 12)" "$why"
  done
  cat <<'EOF'

A removed flag is refused by name rather than read as a prompt: `letibot --daemons` exits 2
saying `use --ls`, so a script that still passes one learns where it went.
EOF
}

# `--help` after a verb is that verb's page; `letibot 'x' --help` still runs the prompt.
# Pages: `--help` the daily set, `--help all` every flag, `--help removed` what was taken away.
show_help() { # show_help [all|removed]
  case "${1:-}" in
    all) usage_all ;;
    removed) usage_removed ;;
    *) usage ;;
  esac
}

case "${1:-}" in
  --help | -h | help)
    show_help "${2:-}"
    exit 0
    ;;
  --* | -c | -s | -n | attach)
    if [ $# -ge 2 ]; then
      for a in "${@:2}"; do
        case "$a" in
          --help | -h)
            verb_help "$1"
            exit 0
            ;;
          --*) : ;;
          *) break ;; # the verb's own argument has started; nothing after it asks for help
        esac
      done
    fi
    ;;
esac

for a in "$@"; do
  case "$a" in
    --help | -h | help)
      show_help
      exit 0
      ;;
    --*) : ;;
    *) break ;; # the prompt starts here; nothing after it is a flag
  esac
done
skip=0
for a in "$@"; do
  # The value after a value-taking flag is not a flag, whatever it looks like:
  # `--vm-arg --mem` hands `--mem` to firecode.
  if [ "$skip" = 1 ]; then
    skip=0
    continue
  fi
  case "$a" in
    --*) ;;
    *) break ;; # the prompt starts here; nothing after it is a flag
  esac
  # A removed flag is refused by name, with its replacement, not sent as a prompt.
  why="$(removed_flag "$a")"
  if [ -n "$why" ]; then
    die "$a is not a flag any more: $why
         ('$ME --help removed' lists what this release took away)"
  fi
  known_flag "$a" || die "unknown flag: $a
         ('$ME --help' lists the flags; a bare prompt needs no flag)"
  # A SETTING WITH A CONFIG KEY SAYS WHICH KEY. One line, once per use, on stderr: the
  # flag still works for this release, and the file is where it belongs from the next one.
  if [ "$(flag_field "$a" 2)" = config ]; then
    printf '%s: %s\n' "$ME" "$(flag_field "$a" 4)" >&2
  fi
  if flag_takes_value "$a"; then
    skip=1
  fi
done

# Qwen by default: this box serves it, and both Qwen models share one template. Writes are
# gated in the TUI. The seat is `leticode`: `coder` is namespace-confined and cannot start on a
# Mac. LETIBOT_ROLE=coder still selects it.
ROLE="${LETIBOT_ROLE:-leticode}"
# `head` posts the decision to the attached TUI and waits for your answer.
# `console` reads the daemon's own stdin, which a detached daemon does not have,
# so every write would refuse with "nobody answered".
ADJ="${LETIBOT_ADJUDICATOR:-head}"

# Approval policy, which is not the role. The mode is a daemon property, fixed at start.
#
# `always-ask` (harnessd's default, `letibot_tools::mode::UNSEEN_PROJECT`) has grant scope
# `Once`, so "allow for the session" records nothing and every edit asks. `writes-allowed`
# has grant scope `Session`: approving a class approves it until the daemon stops. It is the
# launcher's default, and not a silent widening: the daemon prints the point and its dials at
# startup, and commands, network and the always-ask list still ask.
#
#   letibot            writes allowed, approve a class once per session
#   letibot --ask      every write asks, every time
#   letibot --mode N   read-only | always-ask | writes-allowed | automode |
#                      automode-edits | allow-all
#   LETIBOT_MODE=N     the same, by env
MODE="${LETIBOT_MODE:-writes-allowed}"

# The guard model for `supervised` (model and operator) and `automode` (model only). Both need
# an endpoint, checked here so the refusal precedes a daemon start. The address is config
# (`[gatekeeper] endpoint`); these are a one-off override.
SUPERVISE="${LETIBOT_SUPERVISE:-}"
ORACLE="${LETIBOT_ORACLE:-}"
ORACLE_BUDGET="${LETIBOT_ORACLE_BUDGET_MS:-}"

# The shell is on by default for every seat that can carry one: a coder that cannot run its
# tests is not useful. Every exec call still asks (or the guard model answers at automode),
# and the preapproved list runs unasked.
# The confined view's `$HOME` is a fresh tmpfs, so `~/.cargo` and `~/.rustup` are granted
# read-only, named here rather than compiled in, since readable means readable into the
# transcript. Neither holds credentials.
#
#   letibot              a shell, and the toolchain granted read-only into it
#   letibot --no-bash    no shell
#   LETIBOT_BASH=        the same, by env (any non-empty value seats one)
BASH_ON="${LETIBOT_BASH-1}"

# `web_fetch`: curl egress behind the tool, reader-mode extracted and rendered as markdown.
# Off here; the leticode wrapper sets LETIBOT_WEB_FETCH=1. Without it the tool is not seated.
WEB_FETCH="${LETIBOT_WEB_FETCH-}"
GRANTS_RO="${LETIBOT_GRANTS_RO:-$HOME/.cargo $HOME/.rustup}"

# The providers file, read by the launcher too: where a named model lives (`model_home`) and
# what [default] sends turns to (`default_provider`). The path is `letibot_paths::config_dir`'s
# (XDG_CONFIG_HOME only when absolute), and the readers follow `keys::parse_file`.
case "${XDG_CONFIG_HOME:-}" in
  /*) CONFIG_HOME="$XDG_CONFIG_HOME" ;;
  *) CONFIG_HOME="$HOME/.config" ;;
esac
PROVIDERS="$CONFIG_HOME/letibot/providers.toml"

# providers.toml as `keys::parse_file` reads it, one `section<TAB>key<TAB>value` line per key:
# `#` starts a comment anywhere, a repeated section merges into the first, and a repeated key
# takes the last value. Sections keep their first-seen order.
providers_kv() {
  [ -f "$PROVIDERS" ] || return 0
  awk '
    function trim(s) { gsub(/^[[:space:]]+|[[:space:]]+$/, "", s); return s }
    {
      line = $0
      sub(/#.*/, "", line)
      line = trim(line)
      if (line == "") next
      if (line ~ /^\[.*\]$/) {
        sec = trim(substr(line, 2, length(line) - 2))
        gsub(/^"+|"+$/, "", sec)
        next
      }
      eq = index(line, "=")
      if (eq == 0 || sec == "") next
      key = trim(substr(line, 1, eq - 1))
      val = trim(substr(line, eq + 1))
      gsub(/^"+|"+$/, "", val)
      if (!(sec in seen)) { seen[sec] = 1; order[++n] = sec }
      if (!((sec, key) in kv)) keys[sec] = keys[sec] SUBSEP key
      kv[sec, key] = val
    }
    END {
      for (i = 1; i <= n; i++) {
        sec = order[i]
        k = split(substr(keys[sec], 2), ks, SUBSEP)
        for (j = 1; j <= k; j++) printf "%s\t%s\t%s\n", sec, ks[j], kv[sec, ks[j]]
      }
    }
  ' "$PROVIDERS" 2>/dev/null
}

# The [default] block's KEY, or empty when the file or the key is absent (callers test `-n`).
default_provider() { # default_provider [KEY]
  providers_kv | awk -F '\t' -v want="${1:-provider}" '$1 == "default" && $2 == want { print $3; exit }'
}

# Every `[model."..."]` block that serves one alias, one `name<TAB>host:port` line per block,
# in file order. Mirrors `local_models` (crates/provider/src/keys.rs):
#
#   * `url` is the address, `endpoint` an accepted synonym (`url` wins when both are present);
#   * the alias is the block's `model` value, else the block's name;
#   * scheme and path are dropped (`http://h:p/v1` is `h:p`), as `parse_local_url` does.
#
# Blocks without an address are sampling profiles, not homes, and are not listed.
model_home() { # model_home ALIAS — matching blocks, `name<TAB>host:port` each
  providers_kv | awk -F '\t' -v want="$1" '
    function hp(s) {
      sub(/^[a-zA-Z][a-zA-Z0-9+.-]*:\/\//, "", s)
      sub(/\/.*$/, "", s)
      return s
    }
    $1 !~ /^model\./ { next }
    {
      sec = substr($1, 7)
      gsub(/^"+|"+$/, "", sec)
      if (!(sec in seen)) { seen[sec] = 1; order[++n] = sec }
      if ($2 == "url") u[sec] = $3
      else if ($2 == "endpoint") e[sec] = $3
      else if ($2 == "model") m[sec] = $3
    }
    END {
      for (i = 1; i <= n; i++) {
        sec = order[i]
        addr = (u[sec] != "" ? u[sec] : e[sec])
        if (addr != "" && (m[sec] != "" ? m[sec] : sec) == want) printf "%s\t%s\n", sec, hp(addr)
      }
    }
  '
}

# Which model and where it lives: env vars, a --glm/--dense flag or the server's /props pick it,
# and its providers.toml block gives the address. A wrong vocab or dialect does not fail loudly,
# so the explicit flags stay for a server still loading. LETIBOT_DIALECT/MODEL/VOCAB win.
model_by_path() {
  # $1 = model_path from /props -> "dialect|alias|vocab", or empty if unrecognised
  case "$1" in
    *glm-5.3-flash* | *GLM-5.3-Flash*)
      echo "glm|glm-5.3-flash|$HOME/models/glm-5.3-flash/GLM-5.3-Flash-UD-Q4_K_XL-00001-of-00006.gguf"
      ;;
    *Flash-Next* | *flash-next*)
      echo "qwen|qwen-3.8-flash-next|$HOME/models/qwen3.8-flash-next/Qwen3.8-Flash-Next-UD-Q6_K_XL-00001-of-00006.gguf"
      ;;
    *Qwen3.8-27B*)
      echo "qwen|qwen-3.8-27b|$HOME/models/Qwen3.8-27B-UD-Q6_K_XL.gguf"
      ;;
    *) echo "" ;;
  esac
}

# The starting model: the three env vars, else the Qwen flash default. --glm/--dense
# overwrite all three in the flag loop; /props detection refines them only when neither env
# nor a flag has spoken.
DIALECT="${LETIBOT_DIALECT:-qwen}"
MODEL="${LETIBOT_MODEL:-qwen-3.8-flash-next}"
VOCAB="${LETIBOT_VOCAB:-$HOME/models/qwen3.8-flash-next/Qwen3.8-Flash-Next-UD-Q6_K_XL.gguf}"
# MODEL_FLAG is the flag that settled the model, if any: it silences /props detection and
# is quoted by an unresolved-endpoint refusal. MODEL_FROM names whatever chose the model (a
# flag, $LETIBOT_MODEL, or the default) for the same refusal.
MODEL_FLAG=""
MODEL_FROM="${LETIBOT_MODEL:+\$LETIBOT_MODEL}"
[ -n "$MODEL_FROM" ] || MODEL_FROM="the default (no flag chose one)"

# --force only means something with --stop, and saying so beats silently
# ignoring it: a flag that does nothing is a flag the operator cannot trust.
FORCE=0
for a in "$@"; do [ "$a" = "--force" ] && FORCE=1; done
if [ "$FORCE" = 1 ] && [ "${1:-}" != "--stop" ] && [ "${1:-}" != "--room" ]; then
  die "--force only means something with --stop"
fi

# `--ensure` and `--json` belong to `--where` alone — the same rule one verb over: a flag
# that does nothing is a flag the operator cannot trust.
if [ "${1:-}" != "--where" ] && [ "${1:-}" != where ]; then
  for a in "$@"; do
    case "$a" in
      --ensure | --json) die "$a only means something with --where" ;;
      --*) : ;;
      *) break ;; # the prompt starts here; nothing after it is a flag
    esac
  done
fi

# One loop over every flag, in any order, so no flag falls through as a one-shot prompt.
# Empty arrays expand as `${A[@]+"${A[@]}"}`: bash before 4.4 calls them unbound under `set -u`.
EXTRA_ARGS=()
MODEL_OVERRIDE=""
PROVIDER_SET=""
PROVIDER_NAME=""
while [ $# -gt 0 ]; do
  case "$1" in
    -v | --verbose)
      # The routine startup lines (sessions a pick skipped) are said only when asked for.
      export LETIBOT_VERBOSE=1
      shift
      ;;
    --read-only)
      ROLE=orchestrator
      ADJ=""
      shift
      ;;
    --no-bash)
      BASH_ON=""
      shift
      ;;
    --ask)
      MODE=always-ask
      shift
      ;;
    --mode)
      [ $# -ge 2 ] || die "--mode NAME   (read-only, always-ask, writes-allowed, automode, automode-edits, allow-all)"
      MODE="$2"
      shift 2
      ;;
    --supervise)
      # Start supervised. `/supervise` inside the session does the same thing and is
      # the one people will use -- this exists so a script does not have to type into
      # a TUI. Not a mode: supervision moves at run time and a mode does not.
      SUPERVISE=1
      shift
      ;;
    --oracle)
      [ $# -ge 2 ] || die "--oracle HOST:PORT   the guard model for --supervise / automode"
      ORACLE="$2"
      shift 2
      ;;
    --oracle-budget-ms)
      [ $# -ge 2 ] || die "--oracle-budget-ms N   how long the gate waits before failing closed"
      ORACLE_BUDGET="$2"
      shift 2
      ;;
    # A VM placement, and what to tell firecode. Forwarded verbatim; harnessd
    # owns the meaning (see `harnessd --help`).
    --vm)
      EXTRA_ARGS+=(--where firecode)
      shift
      ;;
    --vm-copy)
      EXTRA_ARGS+=(--vm-copy)
      shift
      ;;
    --vm-arg)
      [ $# -ge 2 ] || die "--vm-arg ARG"
      EXTRA_ARGS+=(--vm-arg "$2")
      shift 2
      ;;
    # Tools on another machine (`docs/remote-hosts.md`). Forwarded verbatim;
    # harnessd owns the meaning and refuses a name that is not in the file, so this
    # line does not have to know what a host is.
    --host)
      [ $# -ge 2 ] || die "--host NAME   (a [host.NAME] in ~/.config/letibot/hosts.toml)"
      EXTRA_ARGS+=(--host "$2")
      shift 2
      ;;
    --provider)
      [ $# -ge 2 ] || die "--provider NAME   (deepseek, glm, grok)"
      EXTRA_ARGS+=(--provider "$2")
      PROVIDER_SET=1
      PROVIDER_NAME="$2"
      shift 2
      ;;
    --web-search)
      [ $# -ge 2 ] || die "--web-search NAME   (brave)"
      EXTRA_ARGS+=(--web-search "$2")
      shift 2
      ;;
    # `web_fetch` is off unless asked for: without it the tool is not seated at all.
    --web-fetch)
      WEB_FETCH=1
      shift
      ;;
    --no-web-fetch)
      WEB_FETCH=""
      shift
      ;;
    # The one effort scale harnessd and `[model.*] effort` share. A local
    # dialect renders it into the prompt prefix; a cloud door sends its own fields.
    --effort)
      [ $# -ge 2 ] || die "--effort LEVEL   (off, low, medium, high, max)"
      case "$2" in
        off | low | medium | high | max) ;;
        *) die "--effort: \`$2\` is not an effort; they are off, low, medium, high, max" ;;
      esac
      EXTRA_ARGS+=(--effort "$2")
      shift 2
      ;;
    --brave-key)
      [ $# -ge 2 ] || die "--brave-key KEY"
      EXTRA_ARGS+=(--brave-key "$2")
      shift 2
      ;;
    --model)
      [ $# -ge 2 ] || die "--model NAME"
      MODEL_OVERRIDE="$2"
      shift 2
      ;;
    # Explicit model overrides. Each names one of the three singleton servers; they do not
    # start it (`model glm` / `systemctl --user start glm` does). The flag settles the model
    # (MODEL_FLAG) and names itself for a refusal (MODEL_FROM).
    --glm)
      DIALECT=glm
      MODEL=glm-5.3-flash
      VOCAB="$HOME/models/glm-5.3-flash/GLM-5.3-Flash-UD-Q4_K_XL-00001-of-00006.gguf"
      MODEL_FLAG="--glm"
      MODEL_FROM="--glm"
      shift
      ;;
    --dense)
      DIALECT=qwen
      MODEL=qwen-3.8-27b
      VOCAB="$HOME/models/Qwen3.8-27B-UD-Q6_K_XL.gguf"
      MODEL_FLAG="--dense"
      MODEL_FROM="--dense"
      shift
      ;;
    *) break ;;
  esac
done

# The address is the [model."..."] block whose model value matches; `LETIBOT_ENDPOINT` wins.
# Among several, a loopback one wins, since the flags name this box's servers. Still ambiguous
# is refused by name.
ENDPOINT="${LETIBOT_ENDPOINT:-}"
LOOKUP_MODEL="$MODEL"
PROV_MISSING=""
PROV_LISTED=""
if [ -n "$MODEL_OVERRIDE" ] && [ -z "$PROVIDER_SET" ]; then
  # `--model M` with no --provider names what the local server is asked for, so M is the
  # model whose home the lookup needs. With a provider it names a cloud model, and the lookup
  # keeps the local alias.
  LOOKUP_MODEL="$MODEL_OVERRIDE"
  MODEL_FROM="--model $MODEL_OVERRIDE"
fi
if [ -z "$ENDPOINT" ]; then
  if [ ! -f "$PROVIDERS" ]; then
    PROV_MISSING="file"
  else
    homes="$(model_home "$LOOKUP_MODEL")"
    if [ -z "$homes" ]; then
      PROV_MISSING="entry"
    else
      listed=""
      onbox=""
      n_all=0
      n_onbox=0
      while IFS=$'\t' read -r n a; do
        [ -n "$n" ] || continue
        n_all=$((n_all + 1))
        listed="${listed:+$listed, }$n ($a)"
        case "$a" in
          127.* | localhost:* | ::1:* | \[::1\]:*)
            n_onbox=$((n_onbox + 1))
            [ -n "$onbox" ] || onbox="$n"$'\t'"$a"
            ;;
        esac
      done <<<"$homes"
      PROV_LISTED="$listed"
      if [ "$n_onbox" -eq 1 ]; then
        ENDPOINT="${onbox#*$'\t'}"
        if [ "$n_all" -gt 1 ]; then
          echo "letibot: '$LOOKUP_MODEL' is listed at more than one address in $PROVIDERS -- $listed." >&2
          echo "         Taking ${onbox%%$'\t'*} (${ENDPOINT}): its address is on this box, which is what" >&2
          echo "         --glm/--dense and the default name." >&2
        fi
      elif [ "$n_onbox" -eq 0 ] && [ "$n_all" -eq 1 ]; then
        while IFS=$'\t' read -r n a; do [ -n "$n" ] && {
          ENDPOINT="$a"
          break
        }; done <<<"$homes"
      else
        PROV_MISSING="ambiguous"
      fi
    fi
  fi
fi

# Why this run's model has no home, naming what asked, the model and the file searched. No
# fallback to `127.0.0.1:8080`: ids would go to whatever serves there. A note, not a refusal,
# and only when the model was asked for by name.
endpoint_missing() {
  case "$PROV_MISSING" in
    file)
      cat <<EOF
no endpoint for this run: $MODEL_FROM asked for the model '$LOOKUP_MODEL', and
the file that says where a model lives is not there:
  $PROVIDERS
A missing file is a different fact from a missing entry -- there is no list to
search at all. Give the model a home:
  [model."local.NAME"]
  url = "http://127.0.0.1:PORT"
  model = "$LOOKUP_MODEL"
or name a server by hand for this run:  LETIBOT_ENDPOINT=host:port
EOF
      ;;
    entry)
      cat <<EOF
no endpoint for this run: $MODEL_FROM asked for the model '$LOOKUP_MODEL', and
no [model."…"] block in
  $PROVIDERS
carries model = "$LOOKUP_MODEL" with a url. The file is there; that model is not
in it. Give the model a home:
  [model."local.NAME"]
  url = "http://host:port"
  model = "$LOOKUP_MODEL"
or name a server by hand for this run:  LETIBOT_ENDPOINT=host:port
EOF
      ;;
    ambiguous)
      cat <<EOF
no endpoint for this run: $MODEL_FROM asked for the model '$LOOKUP_MODEL', and
  $PROVIDERS
does not leave where it lives unambiguous: $PROV_LISTED. Keep one of them and
drop or rename the rest, or name a server by hand for this run:
LETIBOT_ENDPOINT=host:port
EOF
      ;;
    *) printf 'no endpoint was resolved for this run.\n' ;;
  esac
}

# Ask the server what it serves (/props). It refines DIALECT/MODEL/VOCAB only when nothing
# else has spoken; a server naming another model wins for those, and the endpoint stays.
DETECTED=""
if [ -z "${LETIBOT_DIALECT:-}${LETIBOT_MODEL:-}${LETIBOT_VOCAB:-}" ] && [ -z "$MODEL_FLAG" ] && [ -n "$ENDPOINT" ]; then
  # One `curl` and a `sed`, not a `curl` piped into an interpreter: this is on the
  # path that runs before the screen exists.
  DETECTED="$(model_by_path "$(curl -sf -m 2 "http://$ENDPOINT/props" 2>/dev/null |
    sed -n 's/.*"model_path"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' | head -1)")"
fi

if [ -n "$DETECTED" ]; then
  DIALECT="${DETECTED%%|*}"
  MODEL="$(echo "$DETECTED" | cut -d'|' -f2)"
  VOCAB="${DETECTED##*|}"
fi

# The model flag: an override names it; a provider without one takes the
# preset's default (passing the LOCAL alias to a cloud provider was measured as
# a 400 naming the models the provider does have); otherwise the local alias.
if [ -n "$MODEL_OVERRIDE" ]; then
  MODEL_ARGS=(--model "$MODEL_OVERRIDE")
elif [ -n "$PROVIDER_SET" ]; then
  MODEL_ARGS=()
else
  MODEL_ARGS=(--model "$MODEL")
fi

# What answers the turns, which is not `$MODEL`: providers.toml's `[default]` may name a
# provider. The daemon resolves it itself; this read is for the banner and the record only.
# An explicit `--provider` names the provider alone, its model is the daemon catalogue's.
answers_now() {
  local p m=""
  if [ -n "$PROVIDER_NAME" ]; then
    p="$PROVIDER_NAME"
    m="$MODEL_OVERRIDE"
  else
    p="$(default_provider provider)"
    m="$MODEL_OVERRIDE"
    [ -n "$m" ] || [ -z "$p" ] || m="$(default_provider model)"
  fi
  [ -n "$p" ] || {
    printf '%s' "$MODEL"
    return 0
  }
  [ -n "$m" ] && printf '%s/%s' "$p" "$m" || printf '%s' "$p"
}

# `--bash` implies the grants; without a shell there is nothing to grant them to.
EXEC_ARGS=()
if [ -n "$WEB_FETCH" ]; then
  EXTRA_ARGS+=(--web-fetch)
fi
if [ -n "$BASH_ON" ]; then
  EXEC_ARGS+=(--bash)
  for g in $GRANTS_RO; do
    [ -e "$g" ] && EXEC_ARGS+=(--grant-ro "$g")
  done
fi

# Liveness is a conversation, not a file: a stale socket outlives a crashed daemon. The
# refusal text is kept in PROBE because a daemon on another protocol version is alive, and
# starting a second one over it would unlink its socket and orphan its sessions.
PROBE=""
# Is a daemon there, without running a head. No `| grep -q` under pipefail: an early grep exit
# SIGPIPEs `ss` into 141. The claim is read from `/proc/locks` (a pure read, about the inode),
# so a daemon on its way out is still seen. Line shape: `4: FLOCK ADVISORY WRITE <pid> <maj:min:inode> 0 EOF`.
folder_lock_pid() { # prints the pid holding this folder's claim, or fails
  # Linux only, and failing is the macOS answer rather than an error: there is no
  # `/proc/locks` and no GNU `stat -c`, so this returns 1 and `daemon_pid` falls back to
  # the record, exactly as on a Linux box whose `/proc/locks` it cannot read.
  [ "$HOST_OS" = Darwin ] && return 1
  local lock ino
  lock="${SOCKET%.sock}.lock"
  [ -f "$lock" ] || return 1
  ino="$(stat -c %i "$lock" 2>/dev/null)" || return 1
  [ -n "$ino" ] || return 1
  awk -v ino="$ino" '
    $2 == "FLOCK" && $6 ~ (":" ino "$") { print $5; found = 1; exit }
    END { exit !found }
  ' /proc/locks 2>/dev/null
}
socket_is_listening() { # socket_is_listening PATH
  if [ "$HOST_OS" = Darwin ]; then
    [ -n "$(socket_pids "$1")" ]
    return
  fi
  case "$(ss -lxpH 2>/dev/null || true)" in
    *"$1"*) return 0 ;;
    *) return 1 ;;
  esac
}
live() {
  # Not `[ -S "$SOCKET" ]`: a stopping daemon unlinks the file while it still listens, and
  # no-file read as no-daemon would start a second one into the same transcript.
  socket_is_listening "$SOCKET"
}
# Listening but unreachable: a daemon is here and its socket file is gone, so nothing can
# connect to it and starting a second one is the thing that corrupts the transcript. The one
# cleanup is a hand on the process, so the refusal names the pid.
live_detached() {
  socket_is_listening "$SOCKET" || return 1
  [ -S "$SOCKET" ] && return 1
  return 0
}
# The refusal, in one place for both callers. `--attach` and the plain run both reach a
# folder a daemon is holding without a file, and a message written twice is a message that
# drifts. Neither of them may start anything or hand a head a path that is gone.
refuse_detached() {
  echo "letibot: a harnessd for $WORKSPACE is still LISTENING but its socket file is gone." >&2
  echo "         $SOCKET" >&2
  echo "         Nothing can attach to it, and starting a second daemon for one folder is what" >&2
  echo "         makes two processes interleave rows into one transcript until the store refuses" >&2
  echo "         every write. Stop the live one and start again." >&2
  _stuck_pid="$(daemon_pid || true)"
  if [ -n "$_stuck_pid" ]; then
    echo "         letibot --stop            # or: kill $_stuck_pid" >&2
  else
    echo "         letibot --stop            # the pid could not be read; --ls lists what is here" >&2
  fi
  exit 1
}
up() {
  [ -S "$SOCKET" ] || return 1
  # `--probe`, not `--no-tty`: the question is whether a daemon is here and speaks this
  # build's protocol. `--no-tty --since 0` is a whole head that applies the snapshot and renders.
  # `--probe` attaches past the end, gets no history, and prints the same refusal on stderr.
  PROBE="$("$BIN/letibot-tui" --socket "$SOCKET" --probe </dev/null 2>&1 >/dev/null)" &&
    return 0
  return 1
}

# Refuse rather than route around it: restarting somebody's daemon is their call while a turn
# may be running. The protocol number is asked of the resolver, since a daemon serves a
# differing head and its refusal text names no version.
version_skew_or_continue() {
  local json theirs mine
  [ -x "$BIN/letibot-multi" ] || return 0
  json="$("$BIN/letibot-multi" where "$WORKSPACE" --json 2>/dev/null)" || return 0
  theirs="$(printf '%s\n' "$json" | sed -n 's/.*"protocol":[[:space:]]*\([0-9][0-9]*\).*/\1/p' | head -1)"
  mine="$(printf '%s\n' "$json" | sed -n 's/.*"this_build":[[:space:]]*\([0-9][0-9]*\).*/\1/p' | head -1)"
  [ -n "$theirs" ] && [ -n "$mine" ] && [ "$theirs" != "$mine" ] || return 0
  echo "letibot: the daemon on $SOCKET speaks protocol $theirs and this build speaks $mine." >&2
  echo "         It is alive and still serving its sessions, so nothing was started" >&2
  echo "         over it. Stop it when you are ready (letibot --stop) and run this" >&2
  echo "         again; every transcript is on disk and letibot --continue reopens" >&2
  echo "         the newest one in this workspace." >&2
  exit 1
}

# The record beside the socket: what this folder's daemon is. Written when the launcher
# starts one; read by --status, --stop, --ls and the attach banner. The pid in it is how the
# daemon is stopped; a name would stop every harnessd on the box.
record_write() {
  rundir
  python3 - "$RECORD" "$WORKSPACE" "$SOCKET" "$1" "$ROLE" "$MODEL" "$DIALECT" "${BASH_ON:-}" "$(answers_now)" <<'PY'
import json, sys, time
rec, ws, sock, pid, role, model, dialect, bash, answers = sys.argv[1:10]
json.dump({"workspace": ws, "socket": sock, "pid": int(pid), "role": role, "model": model,
           "answers": answers,
           "dialect": dialect, "bash": bool(bash), "started": time.strftime("%Y-%m-%dT%H:%M:%S%z")},
          open(rec, "w"))
PY
}
# Flat-JSON field reads with sed: the record is one flat object, and no python3 fork runs
# before the screen exists. A string field, or empty when the file or key is absent.
json_str() { # json_str KEY FILE
  [ -f "$2" ] || return 0
  sed -n 's/.*"'"$1"'"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' "$2" 2>/dev/null | head -1
}
json_num() { # json_num KEY FILE
  [ -f "$2" ] || return 0
  sed -n 's/.*"'"$1"'"[[:space:]]*:[[:space:]]*\([0-9][0-9]*\).*/\1/p' "$2" 2>/dev/null | head -1
}
# A field of unknown type (`--ls` reads `pid` and `workspace` through one call): tries the
# quoted form, then the bare number.
json_field() { # json_field KEY FILE
  local v
  v="$(json_str "$1" "$2")"
  [ -n "$v" ] && {
    printf '%s' "$v"
    return 0
  }
  json_num "$1" "$2"
}
record_field() { json_field "$1" "$RECORD"; }
record_field_of() { json_field "$2" "$1"; }

# A number from `--ls`, or a directory, resolved to that daemon's socket. `--ls` numbers
# daemons in $RUNDIR order; a directory or no argument (this folder) still works.
#
# Sets WORKSPACE, KEY, SOCKET and RECORD, the four the rest of this script reads.
retarget() {
  local want="$1" n=0 r ws sock rec
  case "$want" in
    '' | .) return 0 ;;
    *[!0-9]*)
      # `cd`'s own message names a shell and a line number, so it is suppressed: the next two lines
      # are the mistake and where the numbers come from.
      WORKSPACE="$(cd "$want" 2>/dev/null && pwd -P)" ||
        die "no such directory: $want
         pass one that is there, or the number \`letibot --ls\` prints beside a daemon"
      ;;
    *)
      for r in "$RUNDIR"/*.json; do
        [ -f "$r" ] || continue
        n=$((n + 1))
        [ "$n" = "$want" ] || continue
        ws="$(record_field_of "$r" workspace)"
        WORKSPACE="$ws"
        # A record's own socket wins over the one this folder's hash would name. They differ only
        # for the box's room, whose socket is named by the host, so `--stop N` reaches the room too.
        sock="$(record_field_of "$r" socket)"
        # And the record the number printed is the one the verb reads: the room's is
        # `room-<host key>.json`, not the key-named file.
        rec="$r"
        break
      done
      [ "$n" -ge "$want" ] || die "there is no daemon $want — \`letibot --ls\` numbers them"
      ;;
  esac
  if folder_where "$WORKSPACE"; then
    WORKSPACE="$W_FOLDER" KEY="$W_KEY"
  elif [ -n "$rec" ]; then
    # A numbered record names its own socket and file; its key is the file's name.
    KEY="$(basename "$rec" .json)"
  else
    die "$WHERE_WHY"
  fi
  SOCKET="${sock:-$W_SOCKET}"
  RECORD="${rec:-$RUNDIR/$KEY.json}"
  [ -n "${LETIBOT_LOG:-}" ] || LOG="$HOME/logs/harnessd-$KEY.log"
}
# A session NAME (its /rename title or slug) to SESSION, this folder first and then every
# folder in the store. A hit elsewhere is offered, never taken: the answer decides where the
# daemon runs and what its tools can touch. Defined after `retarget`, which it calls.
tilde() { # tilde PATH -- $HOME shown as ~
  # shellcheck disable=SC2088 # the literal ~ is the display form
  case "$1" in
    "$HOME") echo "~" ;;
    "$HOME"/*) echo "~/${1#"$HOME"/}" ;;
    *) echo "$1" ;;
  esac
}
resolve_named() { # resolve_named NAME -- sets SESSION; may retarget WORKSPACE and cd there
  local name="$1" out kind id title ws age n=0 i rec ans state
  local -a ids=() titles=() wss=() ages=()
  case "$name" in
    s-[0-9]* | cc-*)
      SESSION="$name"
      return 0
      ;;
  esac
  out="$("${NOGPU[@]}" "$BIN/harnessd" --store "$STORE" --find-session "$name" --scope "$WORKSPACE")" || return 1
  while IFS=$'\t' read -r kind id title ws age; do
    [ "$kind" = here ] || [ "$kind" = there ] || continue
    if [ "$kind" = here ]; then
      SESSION="$id"
      return 0
    fi
    ids+=("$id")
    titles+=("$title")
    wss+=("$ws")
    ages+=("$age")
    n=$((n + 1))
  done <<EOF
$out
EOF
  [ "$n" -gt 0 ] || die "no session named '$name'"
  if [ "$n" -eq 1 ]; then
    if [ -t 0 ]; then
      printf '%s lives in %s. Open it there? [Y/n] ' "${titles[0]}" "$(tilde "${wss[0]}")" >&2
      read -r ans || ans=n
      case "$ans" in
        '' | [Yy] | [Yy][Ee][Ss]) i=0 ;;
        *)
          echo "letibot: nothing opened." >&2
          exit 0
          ;;
      esac
    else
      die "${titles[0]} lives in $(tilde "${wss[0]}"), not in $(tilde "$WORKSPACE"). Nothing was opened.
         there, run: cd $(printf '%q' "${wss[0]}") && $ME --session ${ids[0]}"
    fi
  else
    echo "letibot: '$name' names $n sessions in other folders:" >&2
    i=0
    while [ "$i" -lt "$n" ]; do
      rec=""
      if folder_where "${wss[$i]}"; then rec="$RUNDIR/$W_KEY.json"; fi
      state=stopped
      if [ -f "$rec" ] && pid_alive "$(record_field_of "$rec" pid)"; then state="daemon up"; fi
      printf '  %d) %s  %s  %s ago  %s\n' "$((i + 1))" "${titles[$i]}" "$(tilde "${wss[$i]}")" "${ages[$i]}" "$state" >&2
      i=$((i + 1))
    done
    if [ -t 0 ]; then
      printf 'Open which? [1-%d, Enter cancels] ' "$n" >&2
      read -r ans || ans=
      case "$ans" in
        '' | *[!0-9]* | 0*)
          echo "letibot: nothing opened." >&2
          exit 0
          ;;
      esac
      [ "$ans" -le "$n" ] || die "no choice $ans. Nothing was opened."
      i=$((ans - 1))
    else
      die "nothing was opened. there, run: cd FOLDER && $ME --session ID (ids: ${ids[*]})"
    fi
  fi
  [ -d "${wss[$i]}" ] || die "${wss[$i]} is gone. Nothing was opened."
  retarget "${wss[$i]}"
  [ -z "${LETIBOT_SOCKET:-}" ] || SOCKET="$LETIBOT_SOCKET"
  cd "$WORKSPACE" || die "cannot enter $WORKSPACE"
  SESSION="${ids[$i]}"
  echo "letibot: opening ${titles[$i]} in $(tilde "$WORKSPACE"). A program cannot change its parent shell's directory, so yours stays put. To follow: cd $(printf '%q' "$WORKSPACE")" >&2
}
# Is this pid gone, waited for, bounded. The one place the launcher decides whether a daemon
# stopped. "stopped" is said after the process is gone, never after the signal: a daemon can
# swallow SIGTERM.
wait_gone() { # wait_gone PID [TENTHS]
  local p="$1" n="${2:-10}" i=0
  while [ "$i" -lt "$n" ]; do
    pid_alive "$p" || return 0
    sleep 0.5
    i=$((i + 1))
  done
  pid_alive "$p" && return 1
  return 0
}

# How long a stop waits for the daemon to go: thirty seconds, in tenths. The daemon's orderly
# stop joins the merge queues, waits for subagents (`SUBAGENT_EXIT_GRACE`) and brings VMs down.
STOP_TENTHS=60
# A forced stop keeps FIVE seconds for its SIGTERM window: the SIGKILL is the whole of what
# `--force` is for, and the daemon's own VM and child teardown is bounded by then (cli.rs).
FORCE_TENTHS=10

# log_at LOG -- how many bytes the log holds now, 0 when there is none. A stop reads what the
# daemon wrote AFTER this point, so the step a PREVIOUS run last said is never read as this one's.
log_at() {
  [ -f "$1" ] || {
    echo 0
    return 0
  }
  wc -c <"$1" 2>/dev/null | tr -d ' \n' || echo 0
}

# stop_step LOG FROM -- the last step of the daemon's orderly stop that it wrote since FROM.
# The daemon prints one `  stopping: …` line per step (cli.rs's serving path), so this is the
# daemon's own answer to "what is it waiting for" — the only true one there is.
stop_step() {
  [ -f "$1" ] || return 1
  tail -c +"$(($2 + 1))" "$1" 2>/dev/null | tr -d '\r' |
    grep -E '^  stopping: ' | tail -1
}

# stop_wait LINE PID LOG FROM [TENTHS] -- wait for the process to go, saying what IT says it is
# waiting for. Returns 0 when it is gone, 1 when the bound is spent.
stop_wait() {
  local line="$1" pid="$2" log="$3" from="$4" n="${5:-$STOP_TENTHS}" i=0 said="" step
  while [ "$i" -lt "$n" ]; do
    pid_alive "$pid" || return 0
    sleep 0.5
    i=$((i + 1))
    # Twice a second is too often to repeat a sentence, and once per two seconds says every step.
    if [ $((i % 4)) -eq 0 ]; then
      step="$(stop_step "$log" "$from" || true)"
      if [ -n "$step" ] && [ "$step" != "$said" ]; then
        said="$step"
        echo "  $line — ${step#  }" >&2
      fi
    fi
  done
  pid_alive "$pid" && return 1
  return 0
}

# A restart says each step as it happens: one `restart:` line per step, its clock
# redrawn in place on a terminal and said once off one. `--restart` sets LETIBOT_RESTART_STEPS
# for the `--stop` and `--continue` it runs; unset here so no daemon or tool inherits it.
RESTART_STEPS="${LETIBOT_RESTART_STEPS:-0}"
unset LETIBOT_RESTART_STEPS
now_us() {
  if [ -n "${EPOCHREALTIME:-}" ]; then
    echo "${EPOCHREALTIME/[.,]/}"
  else
    echo $(($(date +%s) * 1000000))
  fi
}
since() { # since T0_US -- `3.2s`
  local d=$((($(now_us) - $1) / 100000))
  printf '%d.%ds' $((d / 10)) $((d % 10))
}
step_live() { # step_live TEXT -- the step's line, redrawn; nothing off a terminal
  [ -t 2 ] || return 0
  printf '\r%s\033[K' "$1" >&2
}
step_line() { # step_line TEXT -- a finished line
  if [ -t 2 ]; then printf '\r%s\033[K\n' "$1" >&2; else printf '%s\n' "$1" >&2; fi
}
step_said() { # step_said TEXT -- off a terminal, a step still running is said once, as itself
  [ -t 2 ] || printf '%s\n' "$1" >&2
}

# restart_wait PID LOG FROM -- stop_wait's bound, as the restart's step line: what the daemon
# last said it is waiting on, and the clock. Quiet for its first second, so a quick exit is one line.
restart_wait() {
  local pid="$1" log="$2" from="$3" i=0 t0 step said="" line
  t0="$(now_us)"
  while [ "$i" -lt "$STOP_TENTHS" ]; do
    if ! pid_alive "$pid"; then
      step_line "restart: the daemon exited (pid $pid, $(since "$t0"))"
      return 0
    fi
    sleep 0.5
    i=$((i + 1))
    [ "$i" -ge 2 ] || continue
    step="$(stop_step "$log" "$from" || true)"
    step="${step#  stopping: }"
    line="restart: waiting for the daemon to exit (pid $pid)${step:+ - $step}"
    if [ "$line" != "$said" ]; then
      said="$line"
      step_said "$line"
    fi
    step_live "$line · $(since "$t0")"
  done
  pid_alive "$pid" || return 0
  [ -t 2 ] && printf '\n' >&2
  return 1
}

daemon_pid() {
  # The pid LISTENING on our socket, which is the daemon whatever the record says;
  # the record is a fallback for a box without `ss`.
  local p
  # `|| true`: `head -1` SIGPIPEs the upstream under `pipefail`, and a failing command
  # substitution in an assignment aborts the script under `set -e` — from a helper
  # whose whole job is to be a fallback.
  p="$(socket_pids "$SOCKET" | head -1 || true)"
  [ -n "$p" ] && {
    echo "$p"
    return 0
  }
  # Then the lock, and only then the record. harnessd writes its own pid into the lock
  # (`FolderClaim::write_pid`), so the lock is the folder's answer; the record is the launcher's
  # note about what it started, and the two have been seen to differ.
  p="$(folder_lock_pid || true)"
  [ -n "$p" ] && pid_alive "$p" && {
    echo "$p"
    return 0
  }
  p="$(record_field pid)"
  [ -n "$p" ] && pid_alive "$p" && {
    echo "$p"
    return 0
  }
  return 1
}

# The box's room. A session's `room` tool cannot start a coordinator, since a daemon forking
# `harnessd` would act under a lease it does not hold. One per box: of two starts the lease
# refuses one by name. Socket and lease names derive from the host key, as below.
ROOM_DATA="${XDG_DATA_HOME:-$HOME/.local/share}/letibot"
# Resolved once, on first use: `--help` and `--status` must not fork `uname`, `od` and `sed` to
# answer a question about a daemon they are not going to touch.
ROOM_SOCKET=""
ROOM_LEASE=""
ROOM_LOG=""
ROOM_RECORD=""
room_paths() {
  [ -n "$ROOM_SOCKET" ] && return 0
  if [ -n "${LETIBOT_ROOM_SOCKET:-}" ]; then
    ROOM_SOCKET="$LETIBOT_ROOM_SOCKET"
  else
    ROOM_SOCKET="$ROOM_DATA/room-$(room_host_key "$(room_host_name)").sock"
  fi
  # `harnessd`'s `room::lease_path` puts the lease beside the socket it belongs to, named by the
  # same key, so a box that moves its socket with `LETIBOT_ROOM_SOCKET` moves both.
  ROOM_LEASE="${ROOM_SOCKET%.sock}.lease"
  ROOM_LOG="$HOME/logs/$(basename "$ROOM_SOCKET" .sock).log"
  ROOM_RECORD="$RUNDIR/$(basename "$ROOM_SOCKET" .sock).json"
}
# `letibot_room::lease::host_key_of` in bash: the name made filename-safe, cut to 24, plus the
# low 32 bits of FNV-1a, exact with the 64-bit prime's low half (435). Pinned by
# `the_host_key_matches_what_the_launcher_derives`. Host name: a Mac's local host name, else `uname -n`.
room_host_name() {
  local name=""
  if [ "$(uname -s)" = Darwin ]; then
    name="$(scutil --get LocalHostName 2>/dev/null || true)"
  fi
  [ -n "$name" ] || name="$(uname -n)"
  printf '%s' "$name"
}
room_host_key() { # room_host_key NAME
  local raw="$1" safe hex h b
  # Per character, as the Rust maps: in a UTF-8 locale one non-ASCII character is one dash.
  # `[:upper:]`/`[:lower:]` rather than `A-Z`/`a-z`; a non-ASCII letter becomes a dash either way.
  safe="$(printf '%s' "$raw" | tr '[:upper:]' '[:lower:]' |
    sed 's/[^a-z0-9]/-/g; s/^\(.\{24\}\).*/\1/; s/-*$//')"
  [ -n "$safe" ] || safe=host
  # `od` and not `${raw:i:1}`: the BYTES are what the Rust hashes, and bash would hand back
  # characters (or a locale's idea of one).
  h=$((0x84222325))
  for b in $(printf '%s' "$raw" | od -An -v -tu1); do
    h=$(((h ^ b) * 435 & 0xFFFFFFFF))
  done
  hex="$(printf '%08x' "$h")"
  printf '%s-%s' "$safe" "$hex"
}
# Is a coordinator here? Either fact is enough: something listens on the room's socket, or
# the lease names a running pid whose argv says `--room` (the window between lease and bind).
# The argv check stops a recycled pid answering for a room that is gone.
room_pid() {
  local p
  room_paths
  p="$(socket_pids "$ROOM_SOCKET" | head -1 || true)"
  if [ -z "$p" ]; then
    # The lease's first line, second field: `owner<TAB>pid<TAB>beat_ms<TAB>started_ms`.
    p="$(awk -F'\t' 'NR == 1 { print $2; exit }' "$ROOM_LEASE" 2>/dev/null || true)"
  fi
  [ -n "$p" ] || return 1
  pid_alive "$p" || return 1
  printf '%s' "$p"
}
room_up() {
  local p
  room_paths
  socket_is_listening "$ROOM_SOCKET" && return 0
  p="$(room_pid)" || return 1
  pid_argv "$p" | grep -qx -- '--room'
}
# Socket activation serves the room (`letibot rooms install`): the manager holds the socket
# and starts the coordinator on the first dial, so the launcher never leases or spawns one. The
# file test is the cheap gate; `rooms is-on` asks the manager. Asked once per run.
ROOM_ACTIVATED=""
room_activated() {
  if [ -z "$ROOM_ACTIVATED" ]; then
    ROOM_ACTIVATED=no
    if [ -f "$HOME/Library/LaunchAgents/io.letibot.rooms.plist" ] ||
      [ -f "$CONFIG_HOME/systemd/user/letibot-rooms.socket" ]; then
      if [ -x "$BIN/letibot-multi" ] && "$BIN/letibot-multi" rooms is-on >/dev/null 2>&1; then
        ROOM_ACTIVATED=yes
      fi
    fi
  fi
  [ "$ROOM_ACTIVATED" = yes ]
}
# What the coordinator last said about failing, from its own log — the lease's refusal names
# the holder, the model's refusal names the key, and neither sentence is one this script could
# write itself. `starting:` lines are the boot's progress, not its reason.
room_failure() {
  tail -n 20 "$ROOM_LOG" 2>/dev/null | grep -v '^ *starting: ' | grep -v '^$' | tail -1 || true
}
# Start one detached, so it outlives this terminal. No model flags: the arbiter is
# providers.toml's default or deepseek. Another model is `harnessd --room --model ...` by hand.
room_start() {
  local p i
  mkdir -p "$(dirname "$ROOM_LOG")" "$ROOM_DATA" 2>/dev/null || true
  # A socket file with nothing listening is not removed here: a box whose reader cannot see the
  # listener would unlink a live socket. The bind replaces a dead file itself.
  detach letibot-room "${NOGPU[@]}" "$BIN/harnessd" --room >>"$ROOM_LOG" 2>&1 </dev/null &
  p=$!
  # Ten seconds. The socket is what is watched, and a coordinator that LOSES the lease exits in
  # milliseconds with the holder's name in its log, so the wait is only ever spent on a real start.
  i=0
  while [ "$i" -lt 20 ]; do
    room_up && return 0
    pid_alive "$p" || break
    sleep 0.5
    i=$((i + 1))
  done
  return 1
}
# The record `--ls` and `--stop` read: the folder daemons' flat JSON with `role: room`,
# which tells the two apart.
room_record_write() { # room_record_write PID
  rundir
  python3 - "$ROOM_RECORD" "$(dirname "$ROOM_SOCKET")/room-workspace" "$ROOM_SOCKET" "$1" <<'PY'
import json, sys, time
rec, ws, sock, pid = sys.argv[1:5]
json.dump({"workspace": ws, "socket": sock, "pid": int(pid), "role": "room",
           "started": time.strftime("%Y-%m-%dT%H:%M:%S%z")}, open(rec, "w"))
PY
}
# Make sure the box has a coordinator — the one call the run paths make. A start that fails is
# SAID, from the coordinator's own words, and is never fatal: the session's `room` tool still
# refuses by name, which is true, and everything else about the run is what it was.
room_ensure() {
  local p said
  room_paths
  room_activated && return 0
  if room_up; then
    room_stale_line >&2
    # And the record is a note this launcher keeps true. A room started by hand (`harnessd
    # --room` in a terminal), or one whose record a tidy-up removed, is still the box's room — and
    # `--ls` and `--stop --all` are how a person sees it and stops it.
    if [ ! -f "$ROOM_RECORD" ]; then
      p="$(room_pid || true)"
      [ -n "$p" ] && room_record_write "$p"
    fi
    return 0
  fi
  echo "letibot: no room on this box - starting one (log $ROOM_LOG)" >&2
  if room_start; then
    p="$(room_pid || true)"
    [ -n "$p" ] && room_record_write "$p"
    echo "letibot: the room is up (pid ${p:-unknown}, socket $ROOM_SOCKET)" >&2
    return 0
  fi
  said="$(room_failure)"
  echo "letibot: the box's room did not start." >&2
  [ -n "$said" ] && echo "         it said: $said" >&2
  echo "         Nothing else changed: a session's room tool refuses by name until a" >&2
  echo "         coordinator is serving, and 'letibot --room' is where to look." >&2
  return 0
}

warn_swallowed_flags() {
  # The seat does not travel in EXTRA_ARGS: role reaches harnessd as `--role` and the shell as
  # `--bash`. The seat is fixed when the daemon starts and attaching cannot change it, so a
  # mismatch is said here rather than attaching in silence.
  local want_role="$ROLE" want_bash have_role have_bash mism=0
  # The model this run asked for: an explicit `--model` wins over the flag that
  # picked a family, and the daemon's record carries the same word for both.
  local want_model="${MODEL_OVERRIDE:-$MODEL}"
  want_bash="$([ -n "$BASH_ON" ] && echo true || echo false)"
  have_role="$(record_field role 2>/dev/null || true)"
  have_bash="$(record_field bash 2>/dev/null || true)"
  {
    if [ -n "$have_role" ] && [ "$have_role" != "$want_role" ]; then
      echo "letibot: you asked for the \`$want_role\` seat, but this folder's daemon is already running as \`$have_role\` (pid $(daemon_pid 2>/dev/null || echo "?"))."
      mism=1
    fi
    if [ -n "$have_bash" ] && [ "$have_bash" != "$want_bash" ]; then
      echo "letibot: you asked for $([ "$want_bash" = true ] && echo "a shell" || echo "no shell"), but this folder's daemon was started with $([ "$have_bash" = true ] && echo "one" || echo "none")."
      mism=1
    fi
    # And the model flag: the port check above fires only when the port serves a model the
    # daemon is not bound to, so a `--glm` against a daemon bound to what the port serves would
    # otherwise attach in silence.
    if [ -n "$MODEL_FLAG" ]; then
      local dpid have_model
      # The process's command line first, the record second: an older record has no `model`.
      dpid="$(daemon_pid 2>/dev/null || true)"
      have_model=""
      [ -n "$dpid" ] && have_model="$(pid_argv "$dpid" |
        awk '/^--model$/{getline; print; exit}')"
      [ -n "$have_model" ] || have_model="$(record_field model 2>/dev/null || true)"
      if [ -n "$have_model" ] && [ "$have_model" != "$want_model" ]; then
        echo "letibot: you asked for \`$want_model\` ($MODEL_FLAG), but this folder's daemon is already running as \`$have_model\` (pid ${dpid:-?})."
        mism=1
      fi
    fi
    # One advice line for both mismatches, after the model check, so a model mismatch is
    # printed too.
    if [ "$mism" = 1 ]; then
      echo "         The seat and the model are fixed when harnessd STARTS; attaching to a running one cannot change either."
      echo "         For what you asked for:  $(restart_advice)"
      echo "         Sessions are on disk, so nothing is lost -- '--continue' reopens this one."
    fi
    if [ ${#EXTRA_ARGS[@]} -gt 0 ]; then
      echo "letibot: this folder's daemon is ALREADY RUNNING (pid $(daemon_pid 2>/dev/null || echo "?")) and these flags did NOT take effect:"
      printf '         %s\n' "${EXTRA_ARGS[*]}"
      echo "         They are read when harnessd STARTS and are fixed for the life of the daemon."
      echo "         To apply them:  $(restart_advice) ${EXTRA_ARGS[*]}"
      echo "         Sessions are on disk, so nothing is lost -- 'letibot --continue' reopens this one."
    fi
  } >&2
}
daemon_line() {
  # One line about this folder's daemon, for the attach banner and --status.
  # `answers`, not `model`, when the record has one: `model` is the local vocab the daemon binds,
  # not what answers the turns. Both are recorded.
  local p started role model answers who
  p="$(daemon_pid || true)"
  started="$(record_field started)"
  role="$(record_field role)"
  model="$(record_field model)"
  answers="$(record_field answers)"
  # The box's room is one of the records `--ls` numbers, and it is not a folder's daemon.
  if [ "$role" = room ]; then
    echo "the box's room${p:+ (pid $p)}${started:+, up since $started}"
    return 0
  fi
  # `answers` is what answers the turns; `model` is the local vocab. An older record has no
  # `answers`, and its `model` is labelled `vocab`, which is what it is.
  if [ -n "$answers" ]; then
    who="model $answers"
  else
    who="vocab ${model:-unknown}"
  fi
  echo "harnessd for $WORKSPACE${p:+ (pid $p)}${started:+, up since $started}${role:+, role $role}${who:+ $who}"
}

# The daemon reads its executable once at exec, so a later build is not in it. Compares BIN's
# mtime with the daemon's start time and prints a line, never a restart: that drops an
# in-flight turn and is the operator's call. A TUI-only rebuild needs no restart.
daemon_stale_line() {
  local p dt bt
  p="$(daemon_pid 2>/dev/null || true)"
  [ -n "$p" ] || return 0
  [ -x "$BIN/harnessd" ] || return 0
  dt="$(pid_started "$p")"
  bt="$(file_mtime "$BIN/harnessd")"
  # A `stat` that could not answer, or a value that is not a number: say nothing.
  # Silence is the right answer for an unknown — this is a hint about a process, not
  # a gate, and a guess here would be a warning about a daemon that is fine.
  case "$dt$bt" in '' | *[!0-9]*) return 0 ;; esac
  # Built before this daemon started? Then it is running what was on disk then.
  [ "$bt" -gt "$dt" ] || return 0
  # With the date, not just the clock: a stale daemon can be days old. The path is quoted as
  # resolved.
  printf 'daemon %s started %s; %s was built %s — it is not running what is on disk\n' \
    "$p" "$(epoch_fmt "$dt" '+%m-%d %H:%M')" "$BIN/harnessd" "$(epoch_fmt "$bt" '+%m-%d %H:%M')"
}

# The box's coordinator against the harnessd on disk: a coordinator started before the last build
# runs older room code than the daemons started now (the protocol check catches only a bumped
# number). Says nothing when either time is unknown.
room_stale_line() {
  local p dt bt
  # Under activation the socket's listener is the manager; `letibot rooms status` says STALE.
  room_activated && return 0
  p="$(room_pid 2>/dev/null || true)"
  [ -n "$p" ] || return 0
  [ -x "$BIN/harnessd" ] || return 0
  dt="$(pid_started "$p")"
  bt="$(file_mtime "$BIN/harnessd")"
  case "$dt$bt" in '' | *[!0-9]*) return 0 ;; esac
  [ "$bt" -gt "$dt" ] || return 0
  printf 'letibot: the box'\''s room (pid %s) runs an older build than %s - restart it with: letibot --room --stop && letibot --room\n' \
    "$p" "$BIN/harnessd"
}

# `--listen WORDS...` sets which repositories of this folder the sessions hear gate news of
# (`-REPO`, `+REPO`, `only REPO|this`, `all`), in the store, before anything starts. The words
# run to the next `--flag`; what follows is the usual command. No words lists the state and exits.
if [ "${1:-}" = --listen ]; then
  shift
  listen_words=()
  while [ $# -gt 0 ] && [[ $1 != --* ]]; do
    listen_words+=("$1")
    shift
  done
  if [ "${#listen_words[@]}" -eq 0 ]; then
    exec "${NOGPU[@]}" "$BIN/harnessd" --store "$STORE" --workspace "$PWD" --listen
  fi
  "${NOGPU[@]}" "$BIN/harnessd" --store "$STORE" --workspace "$PWD" --listen "${listen_words[@]}" || exit $?
fi

# Store questions need no socket or model, so `letibot --sessions` works with the server down.
# Old session flags stay one release as aliases that name their new spelling on stderr.
case "${1:-}" in
  --sessions | --list | --rename | --delete | --archive | --unarchive)
    case "$1" in
      --sessions | --list) new_verb=list ;;
      *) new_verb="${1#--}" ;;
    esac
    echo "note: \`$ME $1\` is now \`$ME session $new_verb\`" >&2
    set -- session "$new_verb" "${@:2}"
    ;;
esac

case "${1:-}" in
  # Only with one of its verbs after it, so a prompt that starts with the word stays a prompt.
  # The ID is checked here so the refusal names the launcher's line; the store query is the
  # multicall's, which runs it in-process as the daemon would.
  session)
    case "${2:-}" in
      "" | --help | -h | list) ;;
      show | delete | unarchive) [ $# -ge 3 ] || need "ID" "session $2" ;;
      rename) [ $# -ge 3 ] || need "ID [TITLE]" "session rename" ;;
      archive) [ $# -ge 3 ] || need "ID [REASON]" "session archive" ;;
      *) die "session has no verb ${2}: list, show, rename, archive, unarchive, delete" ;;
    esac
    [ -x "$BIN/letibot-multi" ] || die "no letibot-multi at $BIN (the session verbs live there)"
    shift
    exec "${NOGPU[@]}" "$BIN/letibot-multi" session "$@" --store "$STORE"
    ;;
  # What Claude Code has on this box (Package H): the ids `letibot --session cc-<id>`
  # takes, so a person can find a uuid without opening the JSONL. No store, no socket.
  --list-claude | --claude-sessions)
    shift
    exec "${NOGPU[@]}" "$BIN/harnessd" --list-claude "$@"
    ;;
  # Every door this box knows, and a bad `[provider.NAME]` entry with its reason.
  --providers)
    shift
    exec "${NOGPU[@]}" "$BIN/harnessd" --providers "$@"
    ;;
  # The return trip, the one write into a file another program owns.
  # `--handover SESSION DIR` writes a transcript `claude --resume <path>` opens;
  # `--note TRANSCRIPT TEXT` appends one line after taking a proven backup;
  # `--revert TRANSCRIPT BACKUP` puts it back, byte for byte.
  --handover)
    [ $# -ge 3 ] || need "SESSION DIR" --handover
    exec "${NOGPU[@]}" "$BIN/harnessd" --store "$STORE" --handover "$2" "$3"
    ;;
  --note)
    [ $# -ge 3 ] || need "TRANSCRIPT TEXT" --note
    exec "${NOGPU[@]}" "$BIN/harnessd" --note "$2" "$3"
    ;;
  --note-continued)
    [ $# -ge 3 ] || need "SESSION TRANSCRIPT" --note-continued
    # No empty trailing argument: an empty DIR is a path that is not there, not "the
    # default", and the daemon would try to write into it.
    if [ $# -ge 4 ]; then
      exec "${NOGPU[@]}" "$BIN/harnessd" --store "$STORE" --note-continued "$2" "$3" "$4"
    else
      exec "${NOGPU[@]}" "$BIN/harnessd" --store "$STORE" --note-continued "$2" "$3"
    fi
    ;;
  --revert)
    [ $# -ge 3 ] || need "TRANSCRIPT BACKUP" --revert
    exec "${NOGPU[@]}" "$BIN/harnessd" --revert "$2" "$3"
    ;;
  --where | where)
    # This folder's socket and whether it is up, for programs that drive letibot. The bridge's
    # resolver answers, as for `--ensure`. The folder is passed so `LETIBOT_WORKSPACE` keeps its meaning.
    [ -x "$BIN/letibot-multi" ] || die "no letibot-multi at $BIN (the where verb lives there)"
    shift
    exec "$BIN/letibot-multi" where "$WORKSPACE" "$@"
    ;;
  --migrate)
    # The whole daemon, on a host and back (`docs/remote-hosts.md` RH4). A verb and not a
    # role: it is one act, it needs the store and the rundir this script already knows, and
    # nothing invokes it by a program name.
    [ -x "$BIN/letibot-multi" ] || die "no letibot-multi at $BIN (the migration verb lives there)"
    shift
    exec "$BIN/letibot-multi" migrate "$@" --store "$STORE_FILE"
    ;;
  --reattach)
    # What this script runs when a moved session's forward has dropped, here so an operator can ask
    # for it by hand. The argument comes first: a missing ID is a mistake about this line, where
    # a missing binary is a fact about the install, and only one of the two is theirs to fix.
    [ $# -ge 2 ] || need "ID" --reattach
    [ -x "$BIN/letibot-multi" ] || die "no letibot-multi at $BIN"
    shift
    exec "$BIN/letibot-multi" migrate --reattach "$1" --store "$STORE_FILE"
    ;;
  --ls | --list-all)
    # The byobu view: every folder's daemon and what is live inside it, numbered; the number is
    # what `--stop N` and `--attach N` take. Live sessions only, plus a count of the rest.
    i=0
    found=0
    for r in "$RUNDIR"/*.json; do
      [ -f "$r" ] || continue
      ws="$(record_field_of "$r" workspace)"
      sock="$(record_field_of "$r" socket)"
      pid="$(record_field_of "$r" pid)"
      if socket_is_listening "$sock"; then state=up; else state=STALE; fi
      found=1
      i=$((i + 1))
      # The box's room is one of these daemons and none of these folders. Its record says
      # `role: room`; its "workspace" is a directory of its own under the data directory, which
      # is true and is not a folder anybody works in.
      if [ "$(json_str role "$r")" = room ]; then
        printf '%2d  %-34s %-6s %s\n' "$i" "the box's room" "$state" "pid $pid"
        continue
      fi
      printf '%2d  %-34s %-6s %s\n' "$i" "${ws/#$HOME/~}" "$state" "pid $pid"
      [ "$state" = up ] || continue
      all="$("$BIN/letibot-tui" --socket "$sock" --list-sessions 2>/dev/null)"
      live_n=0
      while IFS=$'\t' read -r id title live running heads rows model; do
        [ -n "$id" ] || continue
        [ "$live" = true ] || continue
        live_n=$((live_n + 1))
        note=""
        [ "$running" = true ] && note="RUNNING"
        [ "${heads:-0}" != 0 ] && note="$note ${heads} head(s)"
        printf '     %-30.30s %6s rows  %-16s %s\n' "${title:-$id}" "$rows" "$model" "$note"
      done <<SESSIONS_EOF
$all
SESSIONS_EOF
      total=$(printf '%s\n' "$all" | grep -c . || true)
      rest=$((total - live_n))
      [ "$rest" -gt 0 ] && printf '     %s\n' "($rest more on disk — --sessions lists them, --continue reopens the newest)"
    done
    if [ "$found" = 1 ]; then
      echo ""
      echo "  letibot --attach N    letibot --stop N    (N is the number above)"
    else
      echo "no daemons recorded under $RUNDIR"
    fi
    exit 0
    ;;
  --room)
    # The box's room. A coordinator is a daemon of its own (`harnessd --room`) that serves every
    # session on the machine, has no project and no store, and outlives the run that started it.
    # Bare, it makes sure one is serving and says what it is; `--stop` stops it.
    ROOM_STOP=0
    shift
    for a in "$@"; do
      case "$a" in
        --stop) ROOM_STOP=1 ;;
        --force) ;;
        *) die "--room takes --stop and --force, not $a" ;;
      esac
    done
    if [ "$FORCE" = 1 ] && [ "$ROOM_STOP" = 0 ]; then
      die "--force only means something with --stop"
    fi
    room_paths
    # Under activation the manager owns start and stop; the pane's restart (stop, then start)
    # comes through here too.
    if room_activated; then
      if [ "$ROOM_STOP" = 1 ]; then
        exec "$BIN/letibot-multi" rooms stop
      fi
      "$BIN/letibot-multi" rooms start || exit $?
      exec "$BIN/letibot-multi" rooms status
    fi
    if [ "$ROOM_STOP" = 1 ]; then
      if ! p="$(room_pid)"; then
        echo "no room on this box ($ROOM_SOCKET)"
        rm -f "$ROOM_RECORD"
        exit 0
      fi
      # The coordinator's own orderly stop, waited for the way a folder daemon's is: it joins its
      # server, gives the lease back and exits, and "stopped" is said after the process is gone.
      from="$(log_at "$ROOM_LOG")"
      kill "$p" 2>/dev/null || true
      if [ "$FORCE" = 1 ]; then
        wait_gone "$p" "$FORCE_TENTHS" || true
        if pid_alive "$p"; then
          kill -9 "$p" 2>/dev/null || true
          wait_gone "$p" 4 || true
        fi
      else
        stop_wait "the room (pid $p)" "$p" "$ROOM_LOG" "$from" "$STOP_TENTHS" || true
      fi
      if pid_alive "$p"; then
        echo "NOT stopped: the room (pid $p) is still running after SIGTERM." >&2
        echo "  letibot --room --stop --force    sends SIGKILL" >&2
        exit 1
      fi
      # The record is this launcher's note, and it is removed with the process it names — the
      # lease went with the coordinator's own drop, so nothing here has to guess.
      rm -f "$ROOM_RECORD"
      echo "stopped the room (pid $p)"
      exit 0
    fi
    # A stop needs no binary — it is a signal to a pid. A START does: the coordinator IS this
    # box's `harnessd`, and the launcher's own check for it comes later on the run paths.
    [ -x "$BIN/harnessd" ] || die "no harnessd at $BIN (the room's coordinator is that daemon, with --room)"
    room_ensure
    if ! p="$(room_pid)"; then
      echo "the room on this box is not serving: $ROOM_SOCKET"
      echo "  its log is $ROOM_LOG"
      exit 1
    fi
    echo "the room on this box: pid $p"
    echo "  socket  $ROOM_SOCKET"
    echo "  lease   $ROOM_LEASE"
    echo "  log     $ROOM_LOG"
    # `started` comes from the LEASE, not from the record: the lease is the coordinator's own
    # claim and survives being started by hand, where the record is only what this launcher wrote.
    started_ms="$(awk -F'\t' 'NR == 1 { print $4; exit }' "$ROOM_LEASE" 2>/dev/null || true)"
    case "$started_ms" in
      '' | *[!0-9]*) : ;;
      *) echo "  up since $(epoch_fmt $((started_ms / 1000)) '+%Y-%m-%d %H:%M')" ;;
    esac
    echo "  chat    ${ROOM_SOCKET%.sock}.chat (history, seq and cursors survive a restart)"
    echo "  queues  ${ROOM_SOCKET%.sock}.items (items, leases and questions survive a restart)"
    exit 0
    ;;
  --restart)
    # A restart keeps the host jobs (docs/lifecycle.md, "Jobs across a restart"). The marker
    # beside the socket makes the daemon's stop leave them running; one still there after the
    # stop was never read, so the daemon predates this and ended them as a plain stop does.
    [ $# -eq 1 ] || die "--restart takes nothing after it"
    need_where
    if daemon_pid >/dev/null; then
      marker="$SOCKET.restart"
      : >"$marker"
      if ! LETIBOT_STOP_REASON="letibot --restart" LETIBOT_RESTART_STEPS=1 "$0" --stop; then
        rm -f "$marker"
        exit 1
      fi
      if [ -e "$marker" ]; then
        rm -f "$marker"
        echo "letibot: that daemon predates --restart, so it ended its jobs as --stop does" >&2
      fi
    fi
    LETIBOT_RESTART_STEPS=1 exec "$0" --continue
    ;;
  --stop)
    # `--stop N` and `--stop DIR` reach another folder's daemon; `--stop` alone is this one's.
    # Numbering comes from `--ls`. The flags go anywhere after it.
    STOP_ALL=0
    STOP_AT=""
    shift
    for a in "$@"; do
      case "$a" in
        --force) ;;
        --all) STOP_ALL=1 ;;
        *)
          [ -z "$STOP_AT" ] || die "--stop takes one daemon, not both $STOP_AT and $a"
          STOP_AT="$a"
          ;;
      esac
    done
    [ "$STOP_ALL" = 1 ] || retarget "$STOP_AT"
    room_stale_line >&2
    # What the interrupt is recorded as in each session's transcript: this command.
    STOP_REASON="${LETIBOT_STOP_REASON:-letibot --stop}"
    [ "$STOP_ALL" = 1 ] && STOP_REASON="$STOP_REASON --all"
    [ "$FORCE" = 1 ] && STOP_REASON="$STOP_REASON --force"
    [ -n "$STOP_AT" ] && STOP_REASON="$STOP_REASON $STOP_AT"
    # interrupt SOCKET -- abort the daemon's running turns; on failure INTR_FAILED holds why.
    # Not `|| true`: a failed interrupt is why a daemon then goes on past SIGTERM,
    # and the sentence after it has to say so instead of blaming the signal.
    INTR_FAILED=""
    interrupt() {
      local out
      INTR_FAILED=""
      if [ "$RESTART_STEPS" = 1 ]; then
        interrupt_steps "$1"
        return 0
      fi
      if out="$("$BIN/letibot-tui" --socket "$1" --interrupt-all --reason "$STOP_REASON" 2>&1)"; then
        [ -z "$out" ] || printf '%s\n' "$out"
      else
        INTR_FAILED="$(printf '%s' "$out" | sed 's/^letibot-tui: //' | tail -1)"
        [ -n "$INTR_FAILED" ] || INTR_FAILED="letibot-tui --interrupt-all failed"
        echo "letibot: the interrupt did not go through: $INTR_FAILED" >&2
      fi
    }
    # interrupt_steps SOCKET -- `interrupt` as a restart's step: the turns named as the
    # interrupt reaches them, and the clock while they wind down. No turns, no line.
    interrupt_steps() {
      local out ipid rc t0 ids line="" said="" i=0
      out="$(mktemp "${TMPDIR:-/tmp}/letibot-intr.XXXXXX")"
      t0="$(now_us)"
      "$BIN/letibot-tui" --socket "$1" --interrupt-all --reason "$STOP_REASON" >"$out" 2>&1 &
      ipid=$!
      while kill -0 "$ipid" 2>/dev/null; do
        ids="$(sed -n 's/^  \(.*\) · interrupted$/\1/p' "$out")"
        if [ -n "$ids" ]; then
          line="$(turns_line "$ids")"
          if [ "$i" -ge 5 ] && [ "$line" != "$said" ]; then
            said="$line"
            step_said "$line"
          fi
          step_live "$line · $(since "$t0")"
        fi
        sleep 0.2
        i=$((i + 1))
      done
      rc=0
      wait "$ipid" || rc=$?
      ids="$(sed -n 's/^  \(.*\) · interrupted$/\1/p' "$out")"
      [ -z "$ids" ] || line="$(turns_line "$ids")"
      if [ "$rc" = 0 ]; then
        [ -z "$line" ] || step_line "$line · stopped ($(since "$t0"))"
      else
        INTR_FAILED="$(sed 's/^letibot-tui: //' "$out" | tail -1)"
        [ -n "$INTR_FAILED" ] || INTR_FAILED="letibot-tui --interrupt-all failed"
        [ -z "$line" ] || step_line "$line · not stopped ($(since "$t0"))"
        echo "letibot: the interrupt did not go through: $INTR_FAILED" >&2
      fi
      rm -f "$out"
    }
    # turns_line IDS -- `restart: interrupting 2 running turns (s-1, s-2)`, at most two ids named.
    turns_line() {
      local n shown
      n="$(printf '%s\n' "$1" | grep -c .)"
      shown="$(printf '%s\n' "$1" | head -2 | paste -sd, - | sed 's/,/, /g')"
      [ "$n" -le 2 ] || shown="$shown, +$((n - 2))"
      if [ "$n" = 1 ]; then
        echo "restart: interrupting 1 running turn ($shown)"
      else
        echo "restart: interrupting $n running turns ($shown)"
      fi
    }
    # not_stopped LINE PID ADVICE LOG FROM SECONDS -- the sentence for a daemon still there after
    # its wait, and only THEN the advice: `--force` is the last resort, not the first suggestion.
    not_stopped() {
      local step
      if [ -n "$INTR_FAILED" ]; then
        echo "NOT stopped: $1 (pid $2) is still running ${6}s after SIGTERM. Its turns were not" >&2
        echo "  interrupted ($INTR_FAILED), so it is most likely finishing one before it exits." >&2
      else
        echo "NOT stopped: $1 (pid $2) is still running ${6}s after SIGTERM." >&2
      fi
      # What the daemon itself last said it was doing — the difference between a stop that is
      # waiting for its children and one that is wedged. Read from the log's tail since the
      # signal, so it is this stop's step and not a previous run's.
      step="$(stop_step "$4" "$5" || true)"
      if [ -n "$step" ]; then
        echo "  it last said: ${step#  }" >&2
      fi
      echo "  $3    sends SIGKILL; the record is kept until it is gone" >&2
    }
    # stop_one LINE PID LOG ADVICE -- signal one daemon and wait for it as long as this verb
    # promises, relaying what it says it is waiting for. `--force` keeps its five seconds and
    # then SIGKILLs; a plain stop waits STOP_TENTHS and never kills. Returns 0 when it is gone.
    stop_one() {
      local line="$1" pid="$2" log="$3" advice="$4" from waited
      from="$(log_at "$log")"
      kill "$pid" 2>/dev/null || true
      if [ "$FORCE" = 1 ]; then
        waited=$((FORCE_TENTHS / 2))
        wait_gone "$pid" "$FORCE_TENTHS" || true
        if pid_alive "$pid"; then
          kill -9 "$pid" 2>/dev/null || true
          wait_gone "$pid" 4 || true
        fi
      else
        waited=$((STOP_TENTHS / 2))
        if [ "$RESTART_STEPS" = 1 ]; then
          restart_wait "$pid" "$log" "$from" || true
        else
          stop_wait "$line" "$pid" "$log" "$from" "$STOP_TENTHS" || true
        fi
      fi
      pid_alive "$pid" || return 0
      not_stopped "$line" "$pid" "$advice" "$log" "$from" "$waited"
      return 1
    }
    # log_of RECORD -- the log that record's daemon writes (see LOG above): the record is
    # named by the folder's key, which also names the log.
    log_of() {
      if [ -n "${LETIBOT_LOG:-}" ]; then
        echo "$LETIBOT_LOG"
        return 0
      fi
      echo "$HOME/logs/harnessd-$(basename "$1" .json).log"
    }
    if [ "$STOP_ALL" = 1 ]; then
      # And the exit status agrees with the words, as the single-target path's
      # does: a run that said `NOT stopped` and exited 0 would be a script a caller
      # cannot branch on, which is the same defect one layer out.
      all_failed=0
      for r in "$RUNDIR"/*.json; do
        [ -f "$r" ] || continue
        pid="$(json_num pid "$r")"
        ws="$(json_str workspace "$r")"
        if pid_alive "$pid" && pid_argv "$pid" | head -1 | grep -q harnessd; then
          # The turns first, as for one daemon. Except the room's: its socket speaks another
          # protocol, and the refusal would read as turns that could not be interrupted.
          sock="$(json_str socket "$r")"
          is_room="$(json_str role "$r")"
          if [ "$is_room" = room ]; then
            INTR_FAILED=""
          elif [ -n "$sock" ] && socket_is_listening "$sock"; then
            interrupt "$sock"
          else
            INTR_FAILED=""
          fi
          # The room's log is named after its socket (see `room_paths`), not after its workspace.
          rlog="$(log_of "$r")"
          if [ "$is_room" = room ] && [ -n "$sock" ]; then
            rlog="$HOME/logs/$(basename "$sock" .sock).log"
          fi
          # Signal, then wait, then say it: `kill`'s exit status says the signal was
          # delivered, not that the process took it.
          if stop_one "$ws (pid $pid)" "$pid" "$rlog" "letibot --stop --all --force"; then
            echo "stopped $ws (pid $pid)"
            rm -f "$r"
          else
            # The advice acts on ALL of them, as this run did — `--stop --force` alone is
            # this folder's daemon only.
            all_failed=1
          fi
        else
          echo "stale record for $ws (pid $pid gone)"
          rm -f "$r"
        fi
      done
      exit "$all_failed"
    fi
    need_where
    if p="$(daemon_pid)"; then
      # Abort the turns before the signal: a busy worker otherwise finishes after SIGTERM with
      # its socket gone, and the next start is refused by the lock. The room is skipped, since
      # `--interrupt-all` speaks the session protocol, which its socket does not.
      [ "$(record_field role)" = room ] || interrupt "$SOCKET"
      # "stopped" is said after the process is gone, and only then is the record removed. The wait
      # is the daemon's own bound (thirty seconds), with its `stopping: ...` lines relayed.
      line="$(daemon_line)"
      if stop_one "$line" "$p" "$LOG" "letibot --stop --force${STOP_AT:+ $STOP_AT}"; then
        [ "$RESTART_STEPS" = 1 ] || echo "stopped $line"
        rm -f "$RECORD"
      else
        exit 1
      fi
    else
      echo "no daemon for $WORKSPACE (letibot --ls lists the others)"
    fi
    exit 0
    ;;
  --status)
    need_where
    if up; then
      echo "up: $(daemon_line)"
      stale="$(daemon_stale_line)"
      [ -n "$stale" ] && echo "! $stale"
      echo "socket   $SOCKET"
    elif live_detached; then
      # A daemon is here and cannot be reached. Saying "no daemon" here is the sentence
      # that got a second one started, and saying "up" would be false: the path a head needs
      # is gone. Both halves of the truth, and which one to act on.
      echo "DETACHED: a harnessd is listening on $SOCKET but the socket FILE is gone (pid $(daemon_pid 2>/dev/null || echo ?))"
      echo "          nothing can attach to it; letibot --stop  (or kill the pid above)"
      echo "socket   $SOCKET"
    elif [ -n "$PROBE" ]; then
      # Something answered and refused. That is a different fact from silence, and
      # printing "not running" for it is how a live daemon gets a second one started
      # on top of it.
      echo "on $SOCKET, but not speaking to this build: $PROBE"
    else
      echo "no daemon for $WORKSPACE"
    fi
    # What this folder's owners hold on disk (docs/lifecycle.md d.9): one `holds:` line per
    # owner, read from the store and the kernel rather than from the daemon, so it answers while
    # the daemon is wedged or gone. Read-only; a box with no store yet prints nothing.
    if [ -x "$BIN/letibot-multi" ]; then
      LETIBOT_STORE="$STORE" "$BIN/letibot-multi" holds --folder "$WORKSPACE" --line 2>/dev/null || true
    fi
    # The local model server is reported separately from what answers the turns, and labelled
    # for what it is, not as `model` (see `daemon_line`).
    # No resolved address is a refusal here too: what would answer locally is half of --status.
    if [ -z "$ENDPOINT" ]; then
      # No local home is a fact to report, never a refusal: a provider answers the turns,
      # or nothing does yet and `letibot` asks for a model on the first message (see "THE
      # LAUNCHER NEVER GATES ON A MODEL").
      if [ -n "$PROVIDER_SET" ] || [ -n "$(default_provider provider)" ]; then
        echo "local    none  ('$LOOKUP_MODEL' has no [model.\"…\"] block in $PROVIDERS; the turns go to the provider)"
      else
        echo "local    none  ('$LOOKUP_MODEL' has no [model.\"…\"] block in $PROVIDERS; letibot asks for a model on first use)"
      fi
      exit 0
    fi
    printf 'local    %s ' "$ENDPOINT"
    if curl -sf -m 3 "http://$ENDPOINT/health" >/dev/null 2>&1; then
      # Name what is actually loaded, not what the default says. One port serves
      # three models by rotation, so "ok" alone answers the wrong question.
      echo "ok  ($MODEL, dialect $DIALECT)"
    else
      echo "NOT SERVING"
    fi
    exit 0
    ;;
  # The binary's own verbs, which take words after them. Without an arm the first word falls
  # through to a billed one-shot prompt; the verb's parser refuses what it does not know.
  stats | boundary | fb | holds | gc | hold | release)
    [ -x "$BIN/letibot-multi" ] || die "no letibot-multi at $BIN (the metrics, boundary and lifecycle verbs live there)"
    # The store the daemon was handed, folding included, so a hold lands where the daemon reads.
    LETIBOT_STORE="$STORE" exec "$BIN/letibot-multi" "$@"
    ;;
  migrate)
    # `--store` is appended as the `--migrate` arm does, because the move needs the store this
    # launcher already resolved and `--help` returns before the flag is read.
    [ -x "$BIN/letibot-multi" ] || die "no letibot-multi at $BIN (the migration verb lives there)"
    exec "$BIN/letibot-multi" "$@" --store "$STORE_FILE"
    ;;
  browser)
    # The Chrome extension's bridge (docs/browser.md). Bare, with its flags or one of its verbs
    # only, so a prompt that starts with the word stays a prompt.
    case "${2:-}" in
      "" | --port | --help | -h | install | uninstall | start | stop | restart | off | on | status | logs)
        [ -x "$BIN/letibot-multi" ] || die "no letibot-multi at $BIN"
        shift
        exec "$BIN/letibot-multi" browser "$@"
        ;;
    esac
    ;;
  rooms)
    # The box's room coordinator under socket activation (docs/room.md). Bare or one of its
    # verbs only, so a prompt that starts with the word stays a prompt.
    case "${2:-}" in
      "" | --help | -h | install | uninstall | start | stop | restart | off | on | status | logs)
        [ -x "$BIN/letibot-multi" ] || die "no letibot-multi at $BIN"
        shift
        exec "$BIN/letibot-multi" rooms "$@"
        ;;
    esac
    ;;
  notes)
    # Only with one of its verbs after it, so a prompt that starts with the word stays a prompt.
    case "${2:-}" in
      path | push | --help | -h)
        [ -x "$BIN/letibot-multi" ] || die "no letibot-multi at $BIN"
        shift
        exec "$BIN/letibot-multi" notes "$@"
        ;;
    esac
    ;;
  shadow)
    # Only with its verb after it, so a prompt that starts with the word stays a prompt.
    case "${2:-}" in
      replay | --help | -h)
        [ -x "$BIN/letibot-multi" ] || die "no letibot-multi at $BIN"
        shift
        exec "$BIN/letibot-multi" shadow "$@"
        ;;
    esac
    ;;
  attach)
    # The GitHub reviewer seat: one long-lived poll of one scope. It drafts until `[github] post`
    # and a token are set, so this verb posts nothing by itself.
    # Each missing word is named separately, before the binary is looked for.
    ATTACH_USAGE="\`$ME attach github <org|owner/repo>\` — an org, or one repository"
    [ "$#" -ge 2 ] || die "attach needs a source: github
         $ATTACH_USAGE"
    [ "$2" = github ] || die "attach knows one source and it is \`github\`, not $2
         $ATTACH_USAGE"
    [ "$#" -ge 3 ] || die "attach needs a scope: <org|owner/repo>
         $ATTACH_USAGE"
    [ -x "$BIN/letibot-multi" ] || die "no letibot-multi at $BIN (the reviewer seat lives there)"
    shift
    exec "$BIN/letibot-multi" attach "$@"
    ;;
  --attach)
    # Connect only. A second argument names another folder's daemon — as a
    # directory, or as the number `letibot --ls` printed beside it.
    retarget "${2:-}"
    need_where
    if live_detached; then refuse_detached; fi
    if live; then
      # The protocol question, asked here too, so a skewed daemon gets the full sentence (`--stop`,
      # the socket, transcripts on disk) instead of the head's bare version line.
      if up; then :; else version_skew_or_continue; fi
      echo "letibot: attached to $(daemon_line)" >&2
      stale="$(daemon_stale_line)"
      [ -n "$stale" ] && echo "letibot: ! $stale" >&2
      warn_swallowed_flags
      exec "$HEAD" --socket "$SOCKET"
    fi
    # No probe when nothing is listening: this path starts nothing, and `live` already answered.
    echo "letibot: no harnessd for $WORKSPACE - run \`letibot\` there to start one" >&2
    echo "         (letibot --ls lists the folders that have one)" >&2
    exit 1
    ;;
esac
need_where

# Which session this invocation is about. SESSION is the id to reopen; NEW_TITLE means a fresh one.
# A plain run declares nothing, so harnessd mints a new id: only `--continue` and `--session ID`
# reopen. `tests/launcher.sh` pins it.
SESSION=""
NEW_TITLE=""
WANT_NEW=0
# Whether THIS invocation started the daemon (as opposed to attaching to one already up). It
# decides one thing, at the end: a start has already opened the fresh session a `--new` asked
# for, so the head must not ask for a second one. See the exec at the bottom.
STARTED=0
case "${1:-}" in
  --continue | -c)
    shift
    # An id after `--continue` means `--session`, said out loud; anything else is refused. A
    # one-shot prompt is only the first argument, and text after a verb is a mistake about the
    # verb, not a prompt to run in the newest session.
    if [ $# -gt 0 ] && [[ "$1" =~ ^s-[0-9]+(#t[0-9]+)?$ ]]; then
      echo "letibot: --continue takes no argument; $1 is a session id, so this is --session $1" >&2
      SESSION="$1"
      shift
    fi
    # A name, when it is the only argument left: resolved here, refused with candidates if not one.
    if [ -z "$SESSION" ] && [ $# -eq 1 ] && [[ "$1" != -* ]]; then
      resolve_named "$1" || exit 1
      shift
    fi
    if [ $# -gt 0 ]; then
      # Two lines, the second carrying both doors. The wall that followed this refusal is the same
      # defect as `--help` printing twenty commands: a person reads none of it.
      echo "letibot: --continue takes no argument, and '$1' is not a session id.
         to name one: $ME --session ID (--sessions lists them); to run a prompt, put it first" >&2
      exit 1
    fi
    # Scoped to this workspace by path prefix, exact match preferred, so `--continue` works from a
    # subdirectory. stderr is not captured: harnessd names the pick before the head opens.
    # Only when no id was given.
    if [ -z "$SESSION" ]; then
      if ! SESSION="$("${NOGPU[@]}" "$BIN/harnessd" --store "$STORE" --latest-session --scope "$WORKSPACE")"; then
        echo "letibot: no session with anything in it under $WORKSPACE." >&2
        echo '         "letibot --sessions" lists what is on disk; plain "letibot" starts a new one.' >&2
        exit 1
      fi
    fi
    ;;
  --session | -s)
    [ $# -ge 2 ] || need "ID" --session
    resolve_named "$2" || exit 1
    shift 2
    ;;
  --new | -n)
    shift
    WANT_NEW=1
    NEW_TITLE="${1:-}"
    [ $# -gt 0 ] && shift || true
    ;;
esac

# A session on a host is attached through its forward (`docs/remote-hosts.md` RH4). A dropped
# forward leaves its socket file, so the socket is probed, not the file, and the forward redone.
if [ -n "$SESSION" ] && [ "$WANT_NEW" != 1 ]; then
  MIGRATED_RECORD="$RUNDIR/migrated-$SESSION.json"
  if [ -f "$MIGRATED_RECORD" ]; then
    MIGRATED_SOCKET="$(json_str socket "$MIGRATED_RECORD")"
    MIGRATED_HOST="$(json_str host "$MIGRATED_RECORD")"
    [ -n "$MIGRATED_SOCKET" ] || die "$MIGRATED_RECORD names no socket — it was written by something else. Remove it, or re-run the migration."
    if ! { [ -S "$MIGRATED_SOCKET" ] &&
      "$BIN/letibot-tui" --socket "$MIGRATED_SOCKET" --probe </dev/null >/dev/null 2>&1; }; then
      echo "letibot: $SESSION lives on $MIGRATED_HOST — re-establishing the forward" >&2
      "$BIN/letibot-multi" migrate --reattach "$SESSION" --store "$STORE" >&2 ||
        die "$SESSION lives on $MIGRATED_HOST and its daemon could not be reached.
         Nothing was opened. \`$ME --migrate $SESSION --to local\` brings it back here."
    fi
    exec "$HEAD" --socket "$MIGRATED_SOCKET" --resume "$SESSION"
  fi
fi

[ -x "$BIN/harnessd" ] || die "no harnessd at $BIN
  This launcher looks beside itself as typed, beside the script it links to, and in
  that checkout's target/release, unless LETIBOT_BIN says otherwise. From a source checkout that means: cargo build --release.
  From an install the binaries should be beside this script, so re-install, or
  point LETIBOT_BIN at the directory holding them."

# The launcher never gates on a model: the head opens the `/models` chooser on the first
# message the model cannot answer. With no home, no `--endpoint` or `--vocab` is invented, so
# token ids never reach whatever serves the default port. `tests/launcher.sh` holds the cases.
if [ -z "$ENDPOINT" ] && [ -z "$PROVIDER_SET" ] && [ -z "$(default_provider provider)" ] &&
  [ "$MODEL_FROM" != "the default (no flag chose one)" ]; then
  {
    endpoint_missing
    echo "Starting anyway: the head asks for a model on the first message."
  } |
    sed 's/^/letibot: /' >&2
fi
ENDPOINT_ARGS=()
[ -z "$ENDPOINT" ] || ENDPOINT_ARGS=(--endpoint "$ENDPOINT")
VOCAB_ARGS=(--vocab "$VOCAB")
if [ -z "${LETIBOT_VOCAB:-}" ]; then
  if [ ! -f "$VOCAB" ]; then
    VOCAB_ARGS=()
  elif [ -z "$ENDPOINT" ] && [ -z "$PROVIDER_SET" ] && [ -z "$(default_provider provider)" ]; then
    VOCAB_ARGS=()
  fi
fi

# The running daemon's model must be the one on the port: --dialect/--model/--vocab are fixed at
# its start, and a mismatch gets `Prompt contains invalid tokens` from llama.cpp. Refuse with the fix.
daemon_models() {
  # Only the pids actually LISTENING on OUR socket. A stale daemon whose path was
  # rebound out from under it still shows in `ps`, and killing or trusting the
  # wrong one is how a live session gets taken down to fix a dead one.
  local pids
  pids="$(socket_pids "$SOCKET")"
  local pid
  for pid in $pids; do
    pid_argv "$pid" | awk '/^--model$/{getline; print; exit}'
  done
}

if live && [ -n "$ENDPOINT" ]; then
  # The probe's failure is not the launcher's: it exists to catch a vocab mismatch, which needs
  # an answer. A server that does not answer is the daemon's story on the next turn. `|| :`
  # keeps curl's exit code from aborting under `set -e -o pipefail`.
  SERVING="$(curl -sf -m 3 "http://$ENDPOINT/props" 2>/dev/null |
    sed -n 's/.*"model_alias"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' | head -1)" || :
  BOUND="$(daemon_models | paste -sd, -)"
  if [ -n "$SERVING" ] && [ -n "$BOUND" ] && ! printf '%s\n' "$BOUND" | tr ',' '\n' | grep -qxF "$SERVING"; then
    echo "letibot: the daemon on $SOCKET is bound to '$BOUND' but $ENDPOINT is serving '$SERVING'." >&2
    echo "         A daemon submits token ids, so the vocabs must match; every turn would come" >&2
    echo "         back http 400 \"Prompt contains invalid tokens\"." >&2
    echo "         --glm/--dense choose a model only when the daemon STARTS. They" >&2
    echo "         cannot rebind one that is already running, and neither can autodetection." >&2
    echo "" >&2
    echo "         Fix:  $(restart_advice)" >&2
    echo "         Sessions are on disk, so nothing is lost -- 'letibot --continue' reopens this one." >&2
    exit 1
  fi
fi

mkdir -p "$STORE_DIR" "$(dirname "$LOG")" "$(dirname "$SHARED_LOG")"

# The room, before any session looks for it: a session's `room` tool is seated at open from the
# socket present then. Not fatal and not quiet: a failed start prints the coordinator's sentence.
room_ensure

# A provider of providers.toml: a `[NAME]` table that is not one of the file's own sections.
provider_section() { # provider_section NAME
  [ -f "$PROVIDERS" ] || return 1
  case "$1" in default | model.* | brave | gatekeeper | host.*) return 1 ;; esac
  awk -v want="$1" '
    { line = $0; sub(/#.*/, "", line); gsub(/^[[:space:]]+|[[:space:]]+$/, "", line) }
    line ~ /^\[.*\]$/ {
      sec = substr(line, 2, length(line) - 2)
      gsub(/^[[:space:]]+|[[:space:]]+$/, "", sec)
      gsub(/^"+|"+$/, "", sec)
      if (sec == want) { found = 1; exit }
    }
    END { exit !found }
  ' "$PROVIDERS" 2>/dev/null
}

# A one-shot's `--model` applies or refuses. harnessd reads a bare `--model` as the local
# binding, so a provider's model would be dropped for the file's default provider.
oneshot_model() {
  [ -n "$MODEL_OVERRIDE" ] && [ -z "$PROVIDER_SET" ] || return 0
  local p m
  case "$MODEL_OVERRIDE" in
    */*)
      p="${MODEL_OVERRIDE%%/*}"
      m="${MODEL_OVERRIDE#*/}"
      [ -n "$p" ] && [ -n "$m" ] || die "--model $MODEL_OVERRIDE: PROVIDER/MODEL wants both halves"
      MODEL_ARGS=(--provider "$p" --model "$m")
      ;;
    *)
      if provider_section "$MODEL_OVERRIDE"; then
        MODEL_ARGS=(--provider "$MODEL_OVERRIDE")
        return 0
      fi
      p="$(default_provider provider)"
      [ -n "$p" ] || return 0
      if [ -n "$(model_home "$MODEL_OVERRIDE")" ]; then
        die "--model $MODEL_OVERRIDE is a local model, and \`[default] provider = \"$p\"\` in $PROVIDERS answers this run's turns. Nothing was run. Pass --model $p/NAME for that provider's model, or clear \`[default] provider\` to run $MODEL_OVERRIDE here"
      fi
      MODEL_ARGS=(--provider "$p" --model "$MODEL_OVERRIDE")
      ;;
  esac
}

# One-shot: no daemon, no TUI. Its socket is its own, so two one-shots side by side do not
# fight over the folder's.
if [ $# -gt 0 ]; then
  oneshot_model
  rundir
  ONESHOT_SOCK="$RUNDIR/oneshot-$$.sock"
  # In a scope of its own too, for `detach`'s reason: its tool calls are as able to eat the
  # box as a daemon's, and in the terminal's scope a cap cannot be set at all. A scope runs
  # the command in place, so the one-shot keeps this terminal.
  ONESHOT=("${NOGPU[@]}" "$BIN/harnessd" --dialect "$DIALECT" ${MODEL_ARGS[@]+"${MODEL_ARGS[@]}"} ${ENDPOINT_ARGS[@]+"${ENDPOINT_ARGS[@]}"}
    --socket "$ONESHOT_SOCK"
    ${VOCAB_ARGS[@]+"${VOCAB_ARGS[@]}"} --workspace "$WORKSPACE" --store "$STORE"
    --role "$ROLE" ${ADJ:+--adjudicator console} ${MODE:+--mode "$MODE"}
    ${SUPERVISE:+--supervise} ${ORACLE:+--oracle "$ORACLE"} ${ORACLE_BUDGET:+--oracle-budget-ms "$ORACLE_BUDGET"}
    ${EXEC_ARGS[@]+"${EXEC_ARGS[@]}"} ${EXTRA_ARGS[@]+"${EXTRA_ARGS[@]}"}
    ${SESSION:+--session "$SESSION"} --prompt "$*")
  scope_run letibot-oneshot
  if [ "${#SCOPE_RUN[@]}" -gt 0 ] && scope_join "${ONESHOT[@]}"; then
    scope_wait
  fi
  exec "${ONESHOT[@]}"
fi

# Role, model, provider and search backend are fixed when harnessd starts, so a flag for them
# cannot reach a running daemon. A warning, not a refusal: attaching still works.

if live; then warn_swallowed_flags; fi

# And nothing is ever started over a daemon that is listening without its file. This is
# the state that bricked a session: `live` is true, so the start branch below is not taken,
# and every path past here would have attached a head to a socket path that does not exist.
if live_detached; then refuse_detached; fi

if ! live; then
  # The probe belongs here only: this branch is about to start a daemon, and starting one over
  # a live-but-skewed daemon orphans its sessions. `up` is a real conversation, not a socket dump.
  version_skew_or_continue
  # A stopping daemon unlinks its socket but holds the folder lock until its turn ends. A live
  # harnessd pid in the record is waited for (`wait_gone`, as `--stop`) rather than started over.
  if _going="$(daemon_pid)"; then
    # And it has to be this folder's daemon: a recycled pid could be another folder's harnessd.
    # A daemon's argv names its socket. `pid_argv` is read whole, so no SIGPIPE under `set -e`.
    _going_argv="$(pid_argv "$_going")"
    if grep -qxF -- "$SOCKET" <<<"$_going_argv"; then
      echo "letibot: a harnessd for $WORKSPACE (pid $_going) is still going - waiting for it" >&2
      # Thirty seconds, relaying what the daemon says: its way out is bounded but not quick
      # (merge queues joined, subagent threads waited for).
      _going_from="$(log_at "$LOG")"
      if ! stop_wait "letibot: a harnessd for $WORKSPACE (pid $_going)" "$_going" "$LOG" \
        "$_going_from" "$STOP_TENTHS"; then
        # Not `refuse_detached`, which says the daemon is still listening; nothing was here, only a
        # pid holding the folder claim.
        echo "letibot: a harnessd for $WORKSPACE (pid $_going) still holds this folder and is" >&2
        echo "         not taking heads, $((STOP_TENTHS / 2))s after it was asked to stop. Nothing was started" >&2
        echo "         over it: two daemons for one folder interleave rows into one transcript." >&2
        _step="$(stop_step "$LOG" "$_going_from" || true)"
        if [ -n "$_step" ]; then echo "         it last said: ${_step#  }" >&2; fi
        echo "         letibot --stop            # or: kill $_going" >&2
        exit 1
      fi
    fi
  fi
  # Nothing answered, so the file is a leftover.
  rm -f "$SOCKET"
  # The daemon opens its first session eagerly, and that is the one this start is about.
  # `--session ID` makes a resume and its hash-chain check happen at startup; without it (a
  # plain run, `--new`) the daemon mints a fresh id. `--title` names it when `--new` gave one.
  STARTED=1
  rundir
  scope_ask_here
  detach letibot-harnessd "${NOGPU[@]}" "$BIN/harnessd" --dialect "$DIALECT" ${MODEL_ARGS[@]+"${MODEL_ARGS[@]}"} ${ENDPOINT_ARGS[@]+"${ENDPOINT_ARGS[@]}"} \
    ${VOCAB_ARGS[@]+"${VOCAB_ARGS[@]}"} --workspace "$WORKSPACE" --store "$STORE" --socket "$SOCKET" \
    --role "$ROLE" ${ADJ:+--adjudicator "$ADJ"} ${MODE:+--mode "$MODE"} \
    ${SUPERVISE:+--supervise} ${ORACLE:+--oracle "$ORACLE"} ${ORACLE_BUDGET:+--oracle-budget-ms "$ORACLE_BUDGET"} \
    ${EXEC_ARGS[@]+"${EXEC_ARGS[@]}"} ${EXTRA_ARGS[@]+"${EXTRA_ARGS[@]}"} \
    ${SESSION:+--session "$SESSION"} ${NEW_TITLE:+--title "$NEW_TITLE"} \
    >>"$LOG" 2>&1 </dev/null &
  DPID=$!
  [ "$LOG" = "$SHARED_LOG" ] ||
    printf '%s letibot: harnessd pid %s for %s logs to %s\n' "$(date '+%F %T')" "$DPID" "$WORKSPACE" "$LOG" \
      >>"$SHARED_LOG" 2>/dev/null || true
  # The banner names what will answer the turns, not the local vocab's model — see
  # `answers_now`.
  if [ "$RESTART_STEPS" = 1 ]; then
    _built="$(file_mtime "$BIN/harnessd")"
    _start_line="restart: starting harnessd${_built:+ (built $(epoch_fmt "$_built" '+%H:%M'))}"
    _start_t0="$(now_us)"
  else
    echo "letibot: no harnessd for $WORKSPACE - starting one (role $ROLE, model $(answers_now), pid $DPID)" >&2
  fi
  # Poll the cheap check, not the probe. Wait while the daemon is alive rather than a fixed
  # half minute: a loaded box spends that on store calls alone. A dead daemon fails at once.
  waited=0
  while ! live; do
    kill -0 "$DPID" 2>/dev/null || break
    [ "$waited" -ge 600 ] && break
    if [ "$RESTART_STEPS" = 1 ]; then
      [ "$waited" != 2 ] || step_said "$_start_line"
      step_live "$_start_line · $(since "$_start_t0")"
    elif [ -t 2 ] && [ "$waited" -gt 0 ] && [ $((waited % 2)) -eq 0 ]; then
      printf '\rletibot: waiting for the daemon to start (%ss)...\033[K' "$((waited / 2))" >&2
    elif [ "$waited" -gt 0 ] && [ $((waited % 20)) -eq 0 ]; then
      echo "letibot: still starting ($((waited / 2))s): $(tail -1 "$LOG" 2>/dev/null | cut -c1-120)" >&2
    fi
    sleep 0.5
    waited=$((waited + 1))
  done
  if [ "$RESTART_STEPS" = 1 ]; then
    if live; then
      step_line "$_start_line · up ($(since "$_start_t0"))"
    else
      step_line "$_start_line · failed ($(since "$_start_t0"))"
    fi
  elif [ -t 2 ] && [ "$waited" -gt 1 ]; then
    printf '\r\033[K' >&2
  fi
  live || {
    # Stopped, so a daemon still starting does not come up later with nobody attached.
    kill "$DPID" 2>/dev/null || true
    echo "letibot: daemon did not come up; last lines of $LOG:" >&2
    tail -15 "$LOG" >&2
    exit 1
  }
  # Record the pid the daemon claims (the lock), not the one this shell started: `--stop --all`
  # reads these records directly. `$DPID` is the fallback where `/proc/locks` is unreadable.
  record_write "$(folder_lock_pid || echo "$DPID")"
  # This head attaches by being the head of this daemon, with no `--resume` and no
  # `--new-session`: the start already opened the session. Asking again would leave the daemon
  # holding two, and the next plain attach would land on the empty one.
  [ "$RESTART_STEPS" = 1 ] && step_line "restart: attaching"
  exec "$HEAD" --socket "$SOCKET"
fi

# Ask the protocol question before handing a head to a listening daemon, so an older build gets
# the full refusal. Any other refusal falls through.
if up; then :; else version_skew_or_continue; fi
# A daemon is already up. Ask it, rather than restarting it: a restart would cost
# every other session on this box to open one, and one of them may be mid-turn.
if [ "$RESTART_STEPS" = 1 ]; then
  step_line "restart: attaching to $(daemon_line)"
else
  echo "letibot: attached to $(daemon_line)" >&2
fi

# And say whether what is answering is what is on disk, before anything else is
# said: a stale daemon makes every other line here describe the wrong build. See
# `daemon_stale_line` for why this is a sentence and not a restart.
stale="$(daemon_stale_line)"
[ -n "$stale" ] && echo "letibot: ! $stale" >&2

# `--bash` decides a seat's tools at open, so attaching to a daemon started without it gives no
# shell. Read the daemon's argv from /proc by exact name: `pgrep -af` matches its own caller.
daemon_has_bash() {
  local p
  p="$(daemon_pid)" || return 1
  pid_argv "$p" | grep -qx -- '--bash'
}

if [ -n "$BASH_ON" ] && ! daemon_has_bash; then
  echo "letibot: a daemon is ALREADY RUNNING and it was started WITHOUT --bash," >&2
  echo "         so this session will not have a shell. --bash is decided when the" >&2
  echo "         daemon opens, and a running one cannot be re-seated." >&2
  echo "" >&2
  echo "         Its own sessions may be mid-turn, so this does not restart it." >&2
  echo "         To get a shell:  letibot --stop  &&  letibot --bash" >&2
  echo "" >&2
  echo "         Attaching to the existing daemon in 5s; ctrl-c to stop." >&2
  sleep 5
fi

if [ "$WANT_NEW" = 1 ] && [ "$STARTED" = 0 ]; then
  # Only when the daemon was already up. With none, the start above opened the fresh session
  # this verb asked for and the head attaches to that one; asking here as well would open a
  # SECOND session in the same daemon and leave the first empty.
  exec "$HEAD" --socket "$SOCKET" \
    --new-session "$NEW_TITLE"
fi
if [ -n "$SESSION" ]; then
  exec "$HEAD" --socket "$SOCKET" \
    --resume "$SESSION"
fi
exec "$HEAD" --socket "$SOCKET"
