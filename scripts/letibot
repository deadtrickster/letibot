#!/usr/bin/env bash
# One command to start chatting: brings up harnessd if it is not already up,
# then attaches the TUI head to it.
#
# WHY IT IS TWO PROCESSES AND NOT ONE. The daemon owns the session, the ledger and
# the model connection; the TUI is one head among several that may attach to it.
# That separation is the point of the design, not an accident of packaging -- you
# can close this window mid-turn and reattach, and the turn keeps running, because
# idle means quiet rather than unwatched. A second head can attach at the same time
# and see the same stream from a snapshot.
#
#   letibot                     attach, starting the daemon if needed
#   letibot --continue          reopen the newest session in THIS workspace
#   letibot --session ID        reopen a particular one
#   letibot --sessions          what is on disk: id, title, workspace, age, rows
#   letibot --new [TITLE]       start a fresh session
#   letibot --rename ID TITLE   name a stored session
#   letibot --delete ID         remove a stored session that has no rows
#   letibot "some prompt"       one-shot: run it, print, exit (no TUI)
#   letibot --glm               GLM's dialect+vocab; providers.toml names the address
#   letibot --stop              stop the daemon
#   letibot --status            is it up, and on what
#
# HOW A SESSION IS REOPENED, IN BOTH DIRECTIONS. Every one of the session commands
# has to work with a daemon already running and with none, and the two paths are
# genuinely different:
#
#   no daemon    start harnessd with `--session ID`. It finds the transcript in the
#                store, replays the stored TOKENS into a new ledger, verifies the
#                hash chain twice, and refuses by name if it does not reproduce.
#   daemon up    ask it over the socket (`letibot-tui --resume ID`), which is the
#                same two frames the ctrl-s picker sends. Restarting the daemon
#                instead would take down every other session on the box to open one.
#
# The daemon logs to ~/logs/harnessd.log; the socket lives in $XDG_RUNTIME_DIR.

set -euo pipefail

# Where the binaries are: **beside this launcher, unless told otherwise.**
#
# The default used to be an absolute path into the operator's build tree
# (`/home/dead/Projects/letibot/letibot/target/release`), which resolves on exactly
# one machine — and that is why nothing caught it. On that box it works, the
# `~/bin/letibot` symlink hides it, and every check passes. Installed anywhere else
# the launcher starts, looks for `letibot-tui` in a directory that does not exist,
# and reports the head missing while it sits RIGHT BESIDE THE LAUNCHER.
#
# Same shape as leticl's `native/hl`: a default that happens to be right in one
# place, whose failure exists only on boxes nobody tests on. Its workflow comment
# names the general case better than this one can — *"a comment about a dependency
# is a claim with a lifetime"* — and a default is a claim that never expires.
#
# It resolves its OWN location, THROUGH SYMLINKS, because the operator reaches it as
# `~/bin/letibot` -> `scripts/letibot` and `dirname "$0"` alone would answer `~/bin`.
# Then it takes the first candidate that actually holds the binaries, so both layouts
# work with no special case:
#
#   * beside the launcher  — the INSTALLED layout, which is what install.sh makes;
#   * ../../target/release — the SOURCE-TREE layout, which is where this file lives
#     before it is installed, and where the operator runs it from today.
#
# `LETIBOT_BIN` is authoritative when set and is never second-guessed: leticl's
# install is built on it, and a wrong value should be NAMED rather than routed
# around.
if [ -n "${LETIBOT_BIN:-}" ]; then
  BIN="$LETIBOT_BIN"
else
  _self="$(readlink -f -- "${BASH_SOURCE[0]}" 2>/dev/null || printf '%s' "${BASH_SOURCE[0]}")"
  _dir="$(cd -- "$(dirname -- "$_self")" 2>/dev/null && pwd -P)" || _dir="$(dirname -- "$_self")"
  BIN=""
  for _cand in "$_dir" "$_dir/../target/release"; do
    if [ -x "$_cand/harnessd" ]; then
      BIN="$_cand"
      break
    fi
  done
  # Nothing found: keep the FIRST candidate, so the message below names the place a
  # reader would expect to look — beside the launcher.
  [ -n "$BIN" ] || BIN="$_dir"
  # **Resolved, so every message that names the binary names a path a reader can
  # paste.** The source-tree candidate is `$_dir/../target/release`, and it printed
  # through as `…/scripts/../target/release/harnessd` — ugly, and a path that only
  # works from the directory it was written in. One `cd`, once, at startup: this is
  # the value `--status`, the staleness line and every refusal quote back.
  BIN="$(cd -- "$BIN" 2>/dev/null && pwd -P || printf '%s' "$BIN")"
fi
# THE HEAD IS A SEAT'S CHOICE. Everything above the head — finding or starting the
# folder's daemon, the seat's defaults, --continue, --new — is this launcher's, and
# another head (leticl, the Common Lisp one) wants all of it and only draws
# differently. So the five places that exec the TUI go through $LETIBOT_HEAD, and
# the utility calls (--probe, --list-sessions, --interrupt-all) stay on letibot-tui:
# they ask the daemon questions, they do not draw. The head is handed
# `--socket S --identity U [--resume ID | --new-session TITLE]`, which is the
# contract a substitute has to speak.
HEAD="${LETIBOT_HEAD:-$BIN/letibot-tui}"

# ONE DAEMON PER FOLDER, tmux-style. The workspace is the git toplevel when you
# are inside a checkout (so `letibot` in a subdirectory joins the daemon of the
# repo, not a second one), else the directory you are standing in. Its daemon
# lives at a socket named by the workspace's path, and a small record beside the
# socket says what it is - pid, role, model, when it started - so `--status`,
# `--stop` and `--daemons` act on THIS folder's daemon by pid, never on every
# harnessd on the box.
#
#   letibot                     connect to this folder's daemon, or start one
#   letibot --attach [DIR]      connect only; refuse to start one
#   letibot --daemons           every folder's daemon on this box, live or stale
#   letibot --stop [--all]      this folder's daemon (or all of them)
WORKSPACE="${LETIBOT_WORKSPACE:-$(git -C "$PWD" rev-parse --show-toplevel 2>/dev/null || echo "$PWD")}"
# `cd` into it to normalise, but a FAILED cd must not leave this empty: an empty
# workspace is a socket key everything shares and a `--scope` that matches every
# session on the box, which is how `--continue` reopened another project's
# conversation. The directory can genuinely be gone -- a pruned worktree does it.
if ! WORKSPACE="$(cd "$WORKSPACE" 2>/dev/null && pwd -P)" || [ -z "$WORKSPACE" ]; then
  echo "letibot: cannot resolve a workspace from $PWD -- the directory may have been" >&2
  echo "         removed (a pruned git worktree does this). cd somewhere that exists," >&2
  echo "         or set LETIBOT_WORKSPACE." >&2
  exit 1
fi
# **The host's facts, asked the way each kernel answers them.** Linux has `/proc`, `ss`,
# `setsid(1)` and GNU `stat`/`date`; macOS has none of those and answers the same
# questions through `ps`, `lsof`, BSD `stat`/`date` and perl's `POSIX::setsid`. Every
# caller below goes through these, so the two spellings live in one place. On Linux each
# helper is the exact command the script used before.
HOST_OS="$(uname -s)"
# The first twelve hex of the workspace's SHA-256 — `launcher.rs`'s key, on either box.
sha12() {
  if command -v sha256sum >/dev/null 2>&1; then sha256sum; else shasum -a 256; fi | cut -c1-12
}
# Is this pid still there? Linux: its `/proc` directory. macOS: `ps` has a state for it,
# and the state is not a zombie's.
pid_alive() { # pid_alive PID
  [ -n "$1" ] || return 1
  if [ "$HOST_OS" = Darwin ]; then
    case "$(ps -o stat= -p "$1" 2>/dev/null)" in '' | Z*) return 1 ;; *) return 0 ;; esac
  fi
  [ -d "/proc/$1" ]
}
# A pid's argument vector, one argument per line. macOS has no `cmdline` file; `ps` gives
# the arguments space-joined, which is enough for the flags this script looks for.
pid_argv() { # pid_argv PID
  if [ "$HOST_OS" = Darwin ]; then
    ps -ww -o args= -p "$1" 2>/dev/null | tr ' ' '\n'
    return 0
  fi
  tr '\0' '\n' < "/proc/$1/cmdline" 2>/dev/null
}
# The pids listening on a unix socket, by its bound path — which both `ss` and `lsof`
# still report after the file has been unlinked, the case `live` below is written for.
# Each listing runs to completion before the match, for the SIGPIPE reason `live` gives.
socket_pids() { # socket_pids PATH
  local listing
  if [ "$HOST_OS" = Darwin ]; then
    listing="$(lsof -nP -U -a -F pn 2>/dev/null || true)"
    printf '%s\n' "$listing" \
      | awk -v s="$1" '/^p/ { p = substr($0, 2) } /^n/ && substr($0, 2) == s { print p }' \
      | sort -u
    return 0
  fi
  listing="$(ss -lxpH 2>/dev/null || true)"
  printf '%s\n' "$listing" | grep -F "$1" | grep -oE 'pid=[0-9]+' | cut -d= -f2 | sort -u || true
}
# When a process started and when a file was written, as epoch seconds; empty if unknown.
pid_started() { # pid_started PID
  if [ "$HOST_OS" = Darwin ]; then
    local l
    l="$(LC_ALL=C ps -o lstart= -p "$1" 2>/dev/null | sed 's/ *$//')"
    [ -n "$l" ] && LC_ALL=C date -j -f '%a %b %e %T %Y' "$l" +%s 2>/dev/null
    return 0
  fi
  stat -c %Y "/proc/$1" 2>/dev/null || true
}
file_mtime() { # file_mtime PATH
  if [ "$HOST_OS" = Darwin ]; then stat -f %m "$1" 2>/dev/null || true; else stat -c %Y "$1" 2>/dev/null || true; fi
}
epoch_fmt() { # epoch_fmt SECONDS FORMAT
  if [ "$HOST_OS" = Darwin ]; then date -r "$1" "$2"; else date -d "@$1" "$2"; fi
}
# Run a command as the leader of a new session, detached from this terminal. macOS has the
# system call and not the command, and perl's POSIX module is on every Mac.
detach() { # detach COMMAND [ARGS...]
  if [ "$HOST_OS" = Darwin ]; then
    /usr/bin/perl -MPOSIX -e 'POSIX::setsid(); exec { $ARGV[0] } @ARGV or die "detach: $ARGV[0]: $!\n"' -- "$@"
  else
    setsid "$@"
  fi
}

# The runtime dir: `$XDG_RUNTIME_DIR/letibot`, else `/run/user/<uid>/letibot` on Linux and
# the per-user temp dir on macOS — asked of `getconf`, not read from `$TMPDIR`, so a
# daemon started without that variable lands where the head looks (`launcher.rs::rundir`).
if [ -n "${XDG_RUNTIME_DIR:-}" ]; then
  RUNDIR="$XDG_RUNTIME_DIR/letibot"
elif [ "$HOST_OS" = Darwin ]; then
  _tmp="$(getconf DARWIN_USER_TEMP_DIR 2>/dev/null || true)"
  RUNDIR="${_tmp:-${TMPDIR:-/tmp/}}"
  RUNDIR="${RUNDIR%/}/letibot"
else
  RUNDIR="/run/user/$(id -u)/letibot"
fi
mkdir -p "$RUNDIR"
KEY="$(printf '%s' "$WORKSPACE" | sha12)"
SOCKET="${LETIBOT_SOCKET:-$RUNDIR/$KEY.sock}"
RECORD="$RUNDIR/$KEY.json"
STORE="${LETIBOT_STORE:-$HOME/.local/share/letibot/sessions.db}"
LOG="${LETIBOT_LOG:-$HOME/logs/harnessd.log}"

# THE DAEMON NEEDS NO GPU AND WAS TAKING 1.1 GB OF IT.
#
# harnessd links libllama for one reason: the TOKENIZER, to count tokens and
# build prompts from `--vocab <gguf>`. That shared object pulls in
# libggml-cuda / libcudart / libcublas, and ggml registers every available
# backend when the library LOADS -- so a CUDA context is opened on each card at
# process start, before anything asks for one.
#
# Measured on this box: a fresh daemon holds 1100 MiB across the two cards and
# runs not one op on them. Inference is the model server's, over HTTP. With two
# daemons up that was 2.2 GB of a card that had 1.9 GB free.
#
#   GPUs visible              1100 MiB
#   CUDA_VISIBLE_DEVICES=""      0 MiB, daemon alive and serving
#
# Set for harnessd ONLY, not exported: a later child of this script that does
# want a GPU must not inherit a blindfold from a line about the tokenizer.
NOGPU=(env CUDA_VISIBLE_DEVICES=)

die() { echo "letibot: $*" >&2; exit 1; }

# **THE COMMAND THE PERSON ACTUALLY TYPED**, for every sentence that hands one back.
#
# `leticode` execs this script, so `$0` here is `letibot` on that path — and a fix line
# built from it told the operator to run a different command: not their seat
# (`LETIBOT_ROLE=leticode`, which the wrapper exports) and not their model flag, so
# `leticode --glm` answered *"Fix:  letibot --stop && letibot"*, which starts a
# **coder** daemon on the **default** model. MEASURED 2026-10-07, and it is the whole
# of why that pair of words could not be reached. The wrapper names itself in
# `LETIBOT_INVOKED_AS`; a bare `letibot` names nothing and `$0` is already right.
ME="${LETIBOT_INVOKED_AS:-$(basename "$0")}"

# **`--glm`/`--flash`/`--dense` are CONSUMED by the flag loop and never reach
# `EXTRA_ARGS`.** No other check in this script can see that a model was asked for —
# which is how a warning about swallowed flags came to say nothing about the one flag
# that picks the model, and how `leticode --glm` against a daemon bound to another
# model attached in SILENCE whenever the port happened to serve what that daemon was
# bound to. Recorded the moment it is parsed; empty means the model was left alone.
MODEL_FLAG=""

# **What would apply this run's model choice**, in the person's own words: their verb,
# their flag. One function because three sentences hand a command back and three
# copies would be three answers to *what do I run next*.
restart_advice() {
  if [ -n "$MODEL_FLAG" ]; then
    printf '%s --stop && %s %s' "$ME" "$ME" "$MODEL_FLAG"
  else
    printf '%s --stop && %s' "$ME" "$ME"
  fi
}

# HELP BEFORE ANYTHING. No network, no daemon probe, no vocabulary: a question
# about the command must not cost a model turn to answer.
#
# Found 2026-09-13, and the mechanism is worth writing down: `--help` matched no
# case below, nothing shifted it, and by the one-shot branch `$#` was still 1 --
# so it ran `harnessd --prompt "--help"`. The banner printed, the vocabulary
# loaded (the multi-second hang), and GLM answered the prompt "--help" with
# usage examples. The operator's report -- "prints something then hangs then
# offers usage examples" -- was the model's answer to a flag it was never meant
# to see. Any typo'd flag (`--halp`, `--vesion`) rode the same fall-through and
# became a billed turn, so unknown `--` words are now refused rather than
# prompted; a one-shot prompt whose first word begins with `--` is rare enough
# that refusing it with a name of the mistake is the honest trade.
usage() {
  cat <<'EOF'
letibot — one command to start chatting: brings up harnessd if it is not
already up, then attaches the TUI head to it.

  letibot                     attach, starting the daemon if needed
  letibot --continue          reopen the newest session in THIS workspace
  letibot --session ID        reopen a particular one
  letibot --sessions          what is on disk: id, title, workspace, age, rows
  letibot --new [TITLE]       start a fresh session
  letibot --rename ID TITLE   name a stored session
  letibot --delete ID         remove a stored session that has no rows
  letibot "some prompt"       one-shot: run it, print, exit (no TUI)
  letibot --glm               GLM's dialect+vocab; providers.toml names the address
  letibot --stop              stop the daemon
  letibot --stop --force      interrupt all in-flight turns, then stop
  letibot --status            is it up, and on what

  letibot                     the leticode seat: opencode's tools and bash, on this host
                              (LETIBOT_ROLE=coder for the namespace-confined seat, Linux)
  letibot --read-only         no write tools at all (orchestrator seat)
  letibot --ask               the old behaviour: every write asks, every time
  letibot --writes            approve a class once, for the session (default)
  letibot --web-fetch         seat `web_fetch`: curl egress, reader-mode extracted
                              (already the default under `leticode`; --no-web-fetch off)
  letibot --effort L          GLM reasoning effort: low | high | max (absent = max)
  letibot --mode N            read-only | always-ask | writes-allowed | automode |
                              automode-edits | allow-all
  letibot --supervise         start supervised: the guard model answers every gated
                              call before you do, and both verdicts land on one
                              corpus row. `/supervise` does the same mid-session and
                              is the usual way. The guard's address is config, not a
                              flag: [gatekeeper] endpoint in providers.toml
  letibot --no-bash           seat no shell (the shell is on by default)
  letibot --vm                run the session's tools in a firecode VM on a COPY of
                              the workspace: the VM is the boundary, allow-all inside,
                              writes land in a sibling directory when it ends
  letibot --vm-arg ARG        passed to `firecode up`, repeatable (--mem, --vcpu, --add-dir)
  letibot --provider NAME     turns go to a cloud provider (deepseek | glm | grok), metered
  letibot --web-search brave  attach Brave behind `web_search` (else the tool refuses).
                              Key: --brave-key, $BRAVE_API_KEY, or [brave] key= in
                              ~/.config/letibot/providers.toml
  letibot --model M           the provider's model (default: the preset's)
  letibot --oracle H:P        the guard model for `--mode supervised` and
                              `--adjudicator model`: a llama.cpp /completion
                              endpoint answering "did the operator ask for this".
                              Its own endpoint, not --endpoint - the guard need
                              not be the model doing the work. Both refuse by
                              name without it rather than falling back to a
                              person, so a session cannot silently be weaker
                              than the mode it printed
  letibot --oracle-budget-ms N  how long the gate waits for that answer before
                              failing closed (default 400). Measured against a
                              4B on THIS box's CPU; a remote oracle needs its
                              own number
  LETIBOT_MODE=writes-allowed letibot        the same, by env

Env overrides: LETIBOT_BIN LETIBOT_SOCKET LETIBOT_WORKSPACE LETIBOT_STORE
LETIBOT_LOG LETIBOT_PROVIDERS LETIBOT_DIALECT LETIBOT_MODEL LETIBOT_VOCAB
LETIBOT_ROLE LETIBOT_ADJUDICATOR LETIBOT_MODE LETIBOT_BASH LETIBOT_WEB_FETCH
LETIBOT_GRANTS_RO LETIBOT_ORACLE LETIBOT_ORACLE_BUDGET_MS
LETIBOT_ENDPOINT — the manual override: the address for this run's model server,
                   winning over the [model."…"] lookup in providers.toml

The daemon logs to ~/logs/harnessd.log. The model server's address comes from
providers.toml — the [model."…"] block whose model matches this run's (the flag,
or the default); LETIBOT_ENDPOINT overrides it by hand. Model choice is detected
from what that server has loaded (letibot --status reports it); explicit
--glm/--flash/--dense choose a model only when the daemon STARTS.
EOF
}

for a in "$@"; do
  case "$a" in
    --help|-h|help) usage; exit 0 ;;
    --*) : ;;
    *) break ;;  # the prompt starts here; nothing after it is a flag
  esac
done
skip=0
for a in "$@"; do
  # The value after a value-taking flag is not a flag, whatever it looks like:
  # `--vm-arg --mem` hands `--mem` to firecode.
  if [ "$skip" = 1 ]; then skip=0; continue; fi
  case "$a" in
    --vm-arg|--provider|--model|--mode|--session|-s|--rename|--delete|\
    --web-search|--brave-key|--oracle|--oracle-budget-ms) skip=1 ;;
  esac
  case "$a" in
    --help|-h|help|--read-only|--writes|--bash|--no-bash|--ask|--supervise|--glm|--flash|--dense|--attach|--daemons|--all|\
    --sessions|--list|--stop|--status|--continue|-c|--new|-n|--session|-s|\
    --rename|--delete|--mode|--force|--vm|--vm-arg|--provider|--model|\
    --web-search|--brave-key|--oracle|--oracle-budget-ms|--ls|--list-all) ;;
    --*) die "unknown flag: $a
         ('letibot --help' lists the flags; a bare prompt needs no flag)" ;;
    *) break ;;
  esac
done

# Qwen is the default because it is what this box serves. Both Qwen models ship a
# byte-identical template, so this one dialect covers Flash-Next and the 27B dense.
# WRITES BY DEFAULT. `letibot` with no flags can edit files, and every write is
# gated -- the head asks you and you answer in the TUI. Read-only is `--read-only`.
#
# It was the other way round until 2026-09-10 and that was wrong twice over: the
# operator hit "no edit tools" with no way to change it in place, which is a
# refusal that cannot be lifted from where it is met -- the exact failure
# docs/boundary-and-adjudication.md 4b makes a requirement -- and it made the
# price of writing a file a flag nobody should have to know.
#
# **And the seat is `leticode`** — opencode's tool union, run on this host, with bash —
# because that is the one the operator runs, on Linux and on a Mac alike (2026-10-07:
# *"in fact even on linux i use only leticode"*). It was `coder`, the namespace-confined
# seat, which on a Mac cannot start at all (no bubblewrap there) and on Linux was the
# default nobody chose. `coder` is still one variable away: LETIBOT_ROLE=coder.
ROLE="${LETIBOT_ROLE:-leticode}"
# `head` posts the decision to the attached TUI and waits for your answer.
# `console` reads the daemon's own stdin, which a detached daemon does not have,
# so every write would refuse with "nobody answered".
ADJ="${LETIBOT_ADJUDICATOR:-head}"

# APPROVAL POLICY, which is not the role.
#
# `always-ask` is the daemon default and its grant scope is `Once`: an answer settles
# that one call. So choosing "allow this class for the rest of the session" at that
# point recorded nothing, and the next write asked again -- reported twice as
# "allow_session doesn't stick" before the cause was found.
#
# `writes-allowed` is the point whose grant scope is `Session`. It is the one to start
# in if you want to approve edits once and be left alone.
#
#   letibot --writes            approve a class once, for the session
#   LETIBOT_MODE=writes-allowed letibot        the same, by env
#
# The mode is a property of the DAEMON, decided when it starts -- like the model and
# the role. A daemon already running cannot be re-pointed; stop it first.
# DEFAULT: writes are allowed for the session.
#
# `always-ask` is harnessd's own default and it is right for a tree nobody has seen
# before -- `letibot_tools::mode::UNSEEN_PROJECT` is literally that constant. It is
# wrong as the way you work every day: its grant scope is `Once`, so every edit asks,
# and the answer settles that call and nothing else.
#
# This is the operator's standing request, asked for three times: "i want to allow
# edits for the entire session". `writes-allowed` is the named point whose grant scope
# is `Session`, so approving a class approves it until the daemon stops.
#
# It is NOT a silent widening. The daemon prints the point and its four dials at
# startup -- `write admit, exec ask, network ask, grants session` -- so what changed is
# on the screen, and commands, the network and the always-ask list (privilege
# escalation, deleting outside the project, a host never seen before) still ask at
# every point. Nothing at any mode reaches an inexpressible action.
#
#   letibot            writes allowed, approve a class once per session
#   letibot --ask      the old behaviour: every write asks, every time
#   letibot --mode N   read-only | always-ask | writes-allowed | automode |
#                      automode-edits | allow-all
MODE="${LETIBOT_MODE:-writes-allowed}"

# THE GUARD MODEL, for the two points that consult one.
#
# `supervised` asks the model AND you, on every gated call; `automode` asks only the
# model. Both need an endpoint and both refuse by name without one -- the daemon does
# that, and this checks it here too so the refusal arrives before a daemon starts and
# a session opens, rather than at the first write.
# The guard's address is CONFIG, not an argument: `[gatekeeper] endpoint` in
# ~/.config/letibot/providers.toml, read by the daemon itself. These two are the
# one-off override and are empty in the ordinary case, which is every case.
SUPERVISE="${LETIBOT_SUPERVISE:-}"
ORACLE="${LETIBOT_ORACLE:-}"
ORACLE_BUDGET="${LETIBOT_ORACLE_BUDGET_MS:-}"

# A SHELL, AND WHAT IT NEEDS TO BE USEFUL.
#
# The shell is ON by default, for every seat that can carry one. It was a flag —
# `bash` is the one tool whose result is an arbitrary byte stream, and §5's single
# choke point for tool results does not exist yet — and the flag produced a coder
# that could edit a test and not run it. The operator, 2026-09-15, on finding a
# session seated without one: "i dont think having coder that cant do tests is a
# sane idea anyway". Correct. What guards the shell is not its absence: every exec
# call still asks (or the guard model answers, at automode), and the preapproved
# list is what runs unasked. `--no-bash` seats no shell.
#
# The grants are the other half. The confined view is HERMETIC: `$HOME` inside is a
# fresh tmpfs, so `~/.cargo` and `~/.rustup` are ABSENT — the same property that keeps a
# secret out, pointed at the toolchain. Without them `cargo` is not found and a shell is
# a shell that cannot build. Checked 2026-09-11: neither holds a `credentials.toml` or
# anything else credential-shaped.
#
# Read-only in the view still means readable INTO THE TRANSCRIPT, which is why these are
# named here where you can see them rather than compiled into the daemon.
#
#   letibot              a shell, and the toolchain granted read-only into it
#   letibot --no-bash    no shell
#   LETIBOT_BASH=        the same, by env (any non-empty value seats one)
BASH_ON="${LETIBOT_BASH-1}"

# `web_fetch`: curl egress behind the tool, reader-mode extracted and rendered
# as markdown before it reaches the model. OFF here and ON for the leticode
# seat, which sets LETIBOT_WEB_FETCH=1 itself — the operator's rule
# (2026-09-17): "i dont want any flags to leticode", the same rule that already
# makes `--bash` a default there.
#
# It is not seated without this. `role_for_seat` adds the tool only when the
# daemon was told to attach a fetcher, so a session started without it has the
# prompt bytes it always had — and `reseat` in such a session correctly reports
# nothing to change, which is how this was found.
WEB_FETCH="${LETIBOT_WEB_FETCH-}"
GRANTS_RO="${LETIBOT_GRANTS_RO:-$HOME/.cargo $HOME/.rustup}"

# THE PROVIDERS FILE, READ BY THE LAUNCHER TOO. The daemon reads
# ~/.config/letibot/providers.toml for provider keys, per-model sampling and the
# [default] block; this launcher asks the same file the two questions it cannot
# answer alone -- where a named model lives (`model_home`, below), and what
# [default] sends the turns to (`default_provider`, for `answers_now`). One file,
# one reader shape, so the launcher and the daemon cannot disagree about where a
# model lives. `LETIBOT_PROVIDERS` points both readers at another file.
PROVIDERS="${LETIBOT_PROVIDERS:-$HOME/.config/letibot/providers.toml}"

# The [default] block's KEY, or empty when the file or the key is absent (callers
# test `-n`). Used by `answers_now`; it lives up here beside the file's other
# reader so the two stay one shape.
default_provider() { # default_provider [KEY]
  [ -f "$PROVIDERS" ] || return 0
  awk -v want="${1:-provider}" '
    /^\[default\][[:space:]]*$/ { inblock = 1; next }
    /^\[/                        { inblock = 0 }
    inblock && $0 ~ "^[[:space:]]*" want "[[:space:]]*=" {
      sub(/^[^=]*=[[:space:]]*/, "")
      gsub(/^"|"[[:space:]]*$/, "")
      print
      exit
    }
  ' "$PROVIDERS" 2>/dev/null
}

# Every `[model."…"]` block that serves one alias, one `name<TAB>host:port` line
# per block, in file order. The daemon's reader of these blocks is `local_models`
# (crates/provider/src/keys.rs) and this mirrors it ruling for ruling rather than
# inventing a second dialect of the file:
#
#   * a block header is `[model.<name>]`; the name may be quoted and dotted --
#     `[model."local.qwe"]` -- which is the one shape the `[default]` matcher
#     above never had to meet;
#   * `url` is the address, and `endpoint` is accepted as the same key (`url` wins
#     when a block carries both), as it is on the daemon side;
#   * the alias a block serves is its `model` value when it has one, else the
#     block's own name;
#   * a scheme and a path are discarded (`http://h:p/v1` is `h:p`) -- the same
#     deal `parse_local_url` makes in harnessd, because `$ENDPOINT` below is a
#     bare host:port;
#   * `#` starts a comment anywhere on a line, as `parse_file` has it.
#
# Blocks without an address are sampling profiles, not homes, and are not listed
# -- a lookup that returned one would point a run at an address it does not have.
model_home() { # model_home ALIAS — matching blocks, `name<TAB>host:port` each
  [ -f "$PROVIDERS" ] || return 0
  awk -v want="$1" '
    function hp(s) {                    # http://h:p/v1 -> h:p, the daemon deal
      sub(/^[a-zA-Z][a-zA-Z0-9+.-]*:\/\//, "", s)
      sub(/\/.*$/, "", s)
      return s
    }
    function flush() {
      if (sec != "" && (u != "" || e != "") && (m != "" ? m : sec) == want) {
        addr = (u != "" ? u : e)        # url wins, endpoint fills
        printf "%s\t%s\n", sec, hp(addr)
      }
    }
    {
      line = $0
      sub(/#.*/, "", line)              # a comment starts anywhere, as parse_file has it
      gsub(/^[[:space:]]+|[[:space:]]+$/, "", line)
      if (line == "") next
      if (substr(line, 1, 1) == "[") {  # any header ends the block; flush first
        flush()
        u = ""; e = ""; m = ""
        if (line ~ /^\[model\./) {
          sec = line
          sub(/^\[model\./, "", sec)
          sub(/\][[:space:]]*$/, "", sec)
          gsub(/^"|"$/, "", sec)
        } else {
          sec = ""
        }
        next
      }
      if (sec == "") next
      eq = index(line, "=")
      if (eq == 0) next
      key = substr(line, 1, eq - 1)
      val = substr(line, eq + 1)
      gsub(/^[[:space:]]+|[[:space:]]+$/, "", key)
      gsub(/^[[:space:]]+|[[:space:]]+$/, "", val)
      gsub(/^"|"$/, "", val)
      if      (key == "url")      u = val
      else if (key == "endpoint") e = val
      else if (key == "model")    m = val
    }
    END { flush() }
  ' "$PROVIDERS" 2>/dev/null
}

# WHICH MODEL, AND WHERE IT LIVES. Three units serve this fleet's models and are
# systemd `Conflicts=` with one another, so exactly one is up at a time -- glm on
# one port, the Qwen dense on another, the flash on a third, one port each since
# the split of 2026-10-07. Two questions follow, answered in order below: WHICH
# model this run wants (the env vars, a --glm/--flash/--dense flag, or the server
# itself over /props), and WHERE that model lives (the [model."…"] block in
# providers.toml that carries its alias -- nothing here hard-codes an address).
#
# This matters beyond convenience. The vocab is how the harness counts tokens and
# how it renders tool calls, and the dialect is which parser reads the model's
# output. Naming the wrong one does not fail loudly -- it produces a token ledger
# that is quietly wrong and tool calls that arrive as literal <function...> text.
# A flag the operator must keep in sync with a service they switched an hour ago
# is a mistake waiting to be made; /props already knows the answer.
#
# The explicit flags remain, because detection needs a server and there are two
# times there isn't one: the model is still loading, and you want the daemon up
# first. LETIBOT_DIALECT / LETIBOT_MODEL / LETIBOT_VOCAB still win over both.
model_by_path() {
  # $1 = model_path from /props -> "dialect|alias|vocab", or empty if unrecognised
  case "$1" in
    *glm-5.3-flash*|*GLM-5.3-Flash*)
      echo "glm|glm-5.3-flash|$HOME/models/glm-5.3-flash/GLM-5.3-Flash-UD-Q4_K_XL-00001-of-00006.gguf" ;;
    *Flash-Next*|*flash-next*)
      echo "qwen|qwen-3.8-flash-next|$HOME/models/qwen3.8-flash-next/Qwen3.8-Flash-Next-UD-Q6_K_XL-00001-of-00006.gguf" ;;
    *Qwen3.8-27B*)
      echo "qwen|qwen-3.8-27b|$HOME/models/Qwen3.8-27B-UD-Q6_K_XL.gguf" ;;
    *) echo "" ;;
  esac
}

# The model this run starts from, before any flag or server has spoken: the three
# env vars, else the Qwen flash default, which is what this box serves most of the
# time. Both Qwen models ship a byte-identical template, so the one dialect covers
# Flash-Next and the 27B dense; only the vocab differs between them. --glm/--flash/
# --dense overwrite all three in the flag loop below, and /props detection refines
# them only when neither the env nor a flag has spoken.
DIALECT="${LETIBOT_DIALECT:-qwen}"
MODEL="${LETIBOT_MODEL:-qwen-3.8-flash-next}"
VOCAB="${LETIBOT_VOCAB:-$HOME/models/qwen3.8-flash-next/Qwen3.8-Flash-Next-UD-Q6_K_XL.gguf}"
# MODEL_FLAG is the flag that settled the model, if any: it is what silences the
# /props detect (an explicit choice does not need the server's opinion) and, with
# MODEL_FROM, what an unresolved-endpoint refusal quotes back. MODEL_FROM is the
# SENTENCE-TRUE name of whatever chose the model -- a flag, $LETIBOT_MODEL, or the
# default -- so a refusal says who asked for the model it could not find a home for.
MODEL_FLAG=""
MODEL_FROM="${LETIBOT_MODEL:+\$LETIBOT_MODEL}"
[ -n "$MODEL_FROM" ] || MODEL_FROM="the default (no flag chose one)"

# --force only means something with --stop, and saying so beats silently
# ignoring it: a flag that does nothing is a flag the operator cannot trust.
FORCE=0
for a in "$@"; do [ "$a" = "--force" ] && FORCE=1; done
if [ "$FORCE" = 1 ] && [ "${1:-}" != "--stop" ]; then
  die "--force only means something with --stop"
fi

# One loop over every flag, in any order and any number. Two single-shot
# `case "$1"` blocks used to stand here — the mode flag first, then the model
# flag — so `--glm --bash` consumed `--glm` and handed `--bash` on as the
# one-shot prompt: harnessd ran in the foreground with `--prompt --bash`, the
# vocabulary loaded, and GLM answered a prompt that said "--bash". Measured
# 2026-09-14, from the operator's own leticode --glm --bash.
# **Every expansion of an array that may be empty is `${A[@]+"${A[@]}"}`.** Bash before 4.4
# — which is `/usr/bin/env bash` on every stock Mac (3.2) — calls an empty array unbound
# under `set -u`, so a plain `"${A[@]}"` killed the launch with no flags given. MEASURED
# 2026-10-07: `EXTRA_ARGS[@]: unbound variable` on the first macOS start.
EXTRA_ARGS=()
MODEL_OVERRIDE=""
PROVIDER_SET=""
PROVIDER_NAME=""
while [ $# -gt 0 ]; do
  case "$1" in
    --read-only)
      ROLE=orchestrator; ADJ=""; shift ;;
    --writes)
      MODE=writes-allowed; shift ;;
    --bash)
      BASH_ON=1; shift ;;
    --no-bash)
      BASH_ON=""; shift ;;
    --ask)
      MODE=always-ask; shift ;;
    --mode)
      [ $# -ge 2 ] || die "--mode NAME   (read-only, always-ask, writes-allowed, automode, automode-edits, allow-all)"
      MODE="$2"; shift 2 ;;
    --supervise)
      # Start supervised. `/supervise` inside the session does the same thing and is
      # the one people will use -- this exists so a script does not have to type into
      # a TUI. Not a mode: supervision moves at run time and a mode does not.
      SUPERVISE=1; shift ;;
    --oracle)
      [ $# -ge 2 ] || die "--oracle HOST:PORT   the guard model for --mode supervised / automode"
      ORACLE="$2"; shift 2 ;;
    --oracle-budget-ms)
      [ $# -ge 2 ] || die "--oracle-budget-ms N   how long the gate waits before failing closed"
      ORACLE_BUDGET="$2"; shift 2 ;;
    # A VM placement, and what to tell firecode. Forwarded verbatim; harnessd
    # owns the meaning (see `harnessd --help`).
    --vm)
      EXTRA_ARGS+=(--where firecode); shift ;;
    --vm-arg)
      [ $# -ge 2 ] || die "--vm-arg ARG"
      EXTRA_ARGS+=(--vm-arg "$2"); shift 2 ;;
    --provider)
      [ $# -ge 2 ] || die "--provider NAME   (deepseek, glm, grok)"
      EXTRA_ARGS+=(--provider "$2"); PROVIDER_SET=1; PROVIDER_NAME="$2"; shift 2 ;;
    --web-search)
      [ $# -ge 2 ] || die "--web-search NAME   (brave)"
      EXTRA_ARGS+=(--web-search "$2"); shift 2 ;;
    # `web_fetch`: curl egress behind the tool, reader-mode extracted and
    # rendered as markdown before it reaches the model. Off unless asked for --
    # the tool is not even SEATED without it, so a session started without this
    # flag has the prompt bytes it always had. Measured 2026-09-17: a `reseat`
    # in a session started without it correctly reported "nothing to re-seat",
    # because there was nothing seated to change.
    --web-fetch)
      WEB_FETCH=1; shift ;;
    --no-web-fetch)
      WEB_FETCH=""; shift ;;
    # GLM's own reasoning dial: low | high | max. ABSENT RENDERS MAX -- the
    # template's `effective_reasoning_effort` is only honoured for low and high
    # -- so every session ever run here has been at maximum effort. It renders
    # at position 3 of the prompt, before the tools block, so it is a property
    # of a session's prefix: changing it needs a new session, and the resume
    # path says so rather than rewriting message 0.
    --effort)
      [ $# -ge 2 ] || die "--effort LEVEL   (low, high, max)"
      EXTRA_ARGS+=(--effort "$2"); shift 2 ;;
    --brave-key)
      [ $# -ge 2 ] || die "--brave-key KEY"
      EXTRA_ARGS+=(--brave-key "$2"); shift 2 ;;
    --model)
      [ $# -ge 2 ] || die "--model NAME"
      MODEL_OVERRIDE="$2"; shift 2 ;;
    # Explicit model overrides. Each names one of the three singleton servers;
    # they do not START it -- `model glm` / `systemctl --user start glm` does.
    # The flag also settles the model question (MODEL_FLAG, so /props detection
    # below keeps quiet) and names itself for a refusal (MODEL_FROM): a flag
    # whose model has no home in providers.toml is refused BY FLAG NAME below,
    # not silently pointed somewhere else.
    --glm)
      DIALECT=glm; MODEL=glm-5.3-flash
      VOCAB="$HOME/models/glm-5.3-flash/GLM-5.3-Flash-UD-Q4_K_XL-00001-of-00006.gguf"
      MODEL_FLAG="--glm"; MODEL_FROM="--glm"
      shift ;;
    --flash)
      DIALECT=qwen; MODEL=qwen-3.8-flash-next
      VOCAB="$HOME/models/qwen3.8-flash-next/Qwen3.8-Flash-Next-UD-Q6_K_XL-00001-of-00006.gguf"
      MODEL_FLAG="--flash"; MODEL_FROM="--flash"
      shift ;;
    --dense)
      DIALECT=qwen; MODEL=qwen-3.8-27b
      VOCAB="$HOME/models/Qwen3.8-27B-UD-Q6_K_XL.gguf"
      MODEL_FLAG="--dense"; MODEL_FROM="--dense"
      shift ;;
    *) break ;;
  esac
done

# **WHERE THAT MODEL LIVES -- the entry says, not this script.**
#
# The operator: *"and you dont have to teach letibot anything - it should come
# from providers.toml"*. ENDPOINT used to be a literal `127.0.0.1:8080`: a claim
# about one box wearing the grammar of a constant, and the port split of
# 2026-10-07 ended even that -- the three units no longer share a port, so the
# literal was pointing the default (flash-next) at whatever 8080 happened to be
# serving. Now the flag names a MODEL, the [model."…"] block carrying that model
# value says the address, and `LETIBOT_ENDPOINT` remains the manual override that
# wins over all of it.
#
# Matching the MODEL VALUE, not a flag→entry-name table (`--dense → local.qwe`),
# is the point: a table here would be a second list of the same models -- right
# today, wrong the first time an entry is renamed. The value moves only when the
# weights do.
#
# THE ONE AMBIGUITY IS MEASURED, on this box's own file: `qwen-3.8-27b` is
# served twice on the fleet -- `[model."dense78"]` (192.168.1.78, another box)
# and `[model."local.qwe"]` (127.0.0.1, this one) both carry it, and the file
# itself warns about exactly this. First-match-in-file-order would take dense78,
# which is on another machine, while --glm/--flash/--dense and the default all
# name THIS box's servers (the units are `systemctl --user` ones). So among
# blocks that carry the model, one whose address is on this box wins -- a
# loopback address is "this box" by definition, not by the entry's naming
# convention, so it survives a rename. If that still leaves the home ambiguous
# (the same model twice off-box, or twice on it), that is refused by name below
# rather than guessed. A model with exactly one home is taken wherever that home
# is: that is the file's answer, and it is not this script's to second-guess.
#
# Nothing here starts anything or talks to any server: it is a file read, once,
# before the screen exists.
ENDPOINT="${LETIBOT_ENDPOINT:-}"
LOOKUP_MODEL="$MODEL"
PROV_MISSING=""
PROV_LISTED=""
if [ -n "$MODEL_OVERRIDE" ] && [ -z "$PROVIDER_SET" ]; then
  # `--model M` with no --provider names what the LOCAL server is asked for, so M
  # is the model whose home the lookup needs. With a provider it names a CLOUD
  # model, and the local endpoint is not where those turns go -- the lookup keeps
  # the local alias.
  LOOKUP_MODEL="$MODEL_OVERRIDE"
  MODEL_FROM="--model $MODEL_OVERRIDE"
fi
if [ -z "$ENDPOINT" ]; then
  if [ ! -f "$PROVIDERS" ]; then
    PROV_MISSING="file"
  else
    homes="$(model_home "$LOOKUP_MODEL")"
    if [ -z "$homes" ]; then
      PROV_MISSING="entry"
    else
      listed=""; onbox=""; n_all=0; n_onbox=0
      while IFS=$'\t' read -r n a; do
        [ -n "$n" ] || continue
        n_all=$((n_all + 1))
        listed="${listed:+$listed, }$n ($a)"
        case "$a" in
          127.*|localhost:*|::1:*|\[::1\]:*)
            n_onbox=$((n_onbox + 1))
            [ -n "$onbox" ] || onbox="$n"$'\t'"$a" ;;
        esac
      done <<< "$homes"
      PROV_LISTED="$listed"
      if [ "$n_onbox" -eq 1 ]; then
        ENDPOINT="${onbox#*$'\t'}"
        if [ "$n_all" -gt 1 ]; then
          echo "letibot: '$LOOKUP_MODEL' is listed at more than one address in $PROVIDERS -- $listed." >&2
          echo "         Taking ${onbox%%$'\t'*} (${ENDPOINT}): its address is on this box, which is what" >&2
          echo "         --glm/--flash/--dense and the default name." >&2
        fi
      elif [ "$n_onbox" -eq 0 ] && [ "$n_all" -eq 1 ]; then
        while IFS=$'\t' read -r n a; do [ -n "$n" ] && { ENDPOINT="$a"; break; } done <<< "$homes"
      else
        PROV_MISSING="ambiguous"
      fi
    fi
  fi
fi

# The refusal, once, for both readers of it (the health gate below and --status's
# local line). A missing FILE is a different fact from a missing ENTRY, and each
# sentence says which; every sentence names what asked for the model, the model
# value searched for, and the file searched, and leaves two doors: give the model
# a home in the file, or name a server by hand for this run. `127.0.0.1:8080` is
# deliberately NOT fallen back to: a silent default here would send token ids to
# whatever 8080 is serving -- the 2026-09-10 incident further down -- while
# reading as though the flag had worked.
endpoint_refusal() {
  case "$PROV_MISSING" in
    file)
      cat <<EOF
no endpoint for this run: $MODEL_FROM asked for the model '$LOOKUP_MODEL', and
the file that says where a model lives is not there:
  $PROVIDERS
A missing file is a different fact from a missing entry -- there is no list to
search at all. Give the model a home:
  [model."local.NAME"]
  url = "http://127.0.0.1:PORT"
  model = "$LOOKUP_MODEL"
or name a server by hand for this run:  LETIBOT_ENDPOINT=host:port
EOF
      ;;
    entry)
      cat <<EOF
no endpoint for this run: $MODEL_FROM asked for the model '$LOOKUP_MODEL', and
no [model."…"] block in
  $PROVIDERS
carries model = "$LOOKUP_MODEL" with a url. The file is there; that model is not
in it. Give the model a home:
  [model."local.NAME"]
  url = "http://host:port"
  model = "$LOOKUP_MODEL"
or name a server by hand for this run:  LETIBOT_ENDPOINT=host:port
EOF
      ;;
    ambiguous)
      cat <<EOF
no endpoint for this run: $MODEL_FROM asked for the model '$LOOKUP_MODEL', and
  $PROVIDERS
does not leave where it lives unambiguous: $PROV_LISTED. Keep one of them and
drop or rename the rest, or name a server by hand for this run:
LETIBOT_ENDPOINT=host:port
EOF
      ;;
    *) printf 'no endpoint was resolved for this run.\n' ;;
  esac
}

# ASK THE SERVER WHAT IT IS ACTUALLY SERVING (the /props detect). This needs the
# endpoint, so it runs after the resolution above -- and the flag loop sits
# between them for the same reason: a flag changes which model is wanted, and the
# endpoint follows the model. It refines DIALECT/MODEL/VOCAB only when nothing
# else has spoken (none of the three env vars, no --glm/--flash/--dense), and it
# is skipped entirely when no endpoint resolved: there is nothing to ask, and
# the refusal above is what this run meets at the gates that need an address.
# When the server names a model other than the one looked up, the server wins
# for dialect/model/vocab -- it is what is actually loaded -- and the endpoint
# stays where the entry sent it: that is a file misdescribing its server, and
# the vocab is the thing that has to be right.
DETECTED=""
if [ -z "${LETIBOT_DIALECT:-}${LETIBOT_MODEL:-}${LETIBOT_VOCAB:-}" ] && [ -z "$MODEL_FLAG" ] && [ -n "$ENDPOINT" ]; then
  # One `curl` and a `sed`, not a `curl` piped into an interpreter: this is on the
  # path that runs before the screen exists.
  DETECTED="$(model_by_path "$(curl -sf -m 2 "http://$ENDPOINT/props" 2>/dev/null \
    | sed -n 's/.*"model_path"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' | head -1)")"
fi

if [ -n "$DETECTED" ]; then
  DIALECT="${DETECTED%%|*}"
  MODEL="$(echo "$DETECTED" | cut -d'|' -f2)"
  VOCAB="${DETECTED##*|}"
fi

# The model flag: an override names it; a provider without one takes the
# preset's default (passing the LOCAL alias to a cloud provider was measured as
# a 400 naming the models the provider does have); otherwise the local alias.
if [ -n "$MODEL_OVERRIDE" ]; then
  MODEL_ARGS=(--model "$MODEL_OVERRIDE")
elif [ -n "$PROVIDER_SET" ]; then
  MODEL_ARGS=()
else
  MODEL_ARGS=(--model "$MODEL")
fi

# **What will actually answer the turns**, which is not `$MODEL`.
#
# The operator, after a restart: *"leticode --session … letibot: no harnessd for
# /home/dead/Projects/letibot - starting one (role leticode, model qwen-3.8-27b, pid
# 907864) … so - qwen again"*. `$MODEL` is the LOCAL alias — the vocab the daemon submits
# token ids against — while the turns were going to deepseek, because
# `~/.config/letibot/providers.toml` carries a `[default]` block:
#
#     [default]
#     model = "deepseek-flash"
#     provider = "deepseek"
#
# The daemon reads that itself, so nothing on this command line mentioned deepseek and
# the banner could not have known from its arguments alone. It could know from the same
# file, which is what this does.
#
# Used for the start banner and the record. **Not** passed to harnessd: the daemon
# resolves this itself, and a launcher that also passed it would be a second opinion on a
# question with one owner.
# (the reader itself, `default_provider`, lives up beside `model_home` at the top
# of the providers-file section, so the file's two readers stay one shape)
# `deepseek/deepseek-flash`, or the local alias when no provider is configured.
#
# **The provider and its model come from the same place, and which place differs.** An
# explicit `--provider` means this script does not know the model — the catalogue that
# holds each preset's default is the daemon's — so it names the provider alone rather
# than borrowing the *config's* model for it. That borrowing was the first version's bug,
# caught by running it: `--provider glm` printed `glm/deepseek-flash`.
answers_now() {
  local p m=""
  if [ -n "$PROVIDER_NAME" ]; then
    p="$PROVIDER_NAME"
    m="$MODEL_OVERRIDE"
  else
    p="$(default_provider provider)"
    m="$MODEL_OVERRIDE"
    [ -n "$m" ] || [ -z "$p" ] || m="$(default_provider model)"
  fi
  [ -n "$p" ] || { printf '%s' "$MODEL"; return 0; }
  [ -n "$m" ] && printf '%s/%s' "$p" "$m" || printf '%s' "$p"
}

# `--bash` implies the grants; without a shell there is nothing to grant them to.
EXEC_ARGS=()
if [ -n "$WEB_FETCH" ]; then
  EXTRA_ARGS+=(--web-fetch)
fi
if [ -n "$BASH_ON" ]; then
  EXEC_ARGS+=(--bash)
  for g in $GRANTS_RO; do
    [ -e "$g" ] && EXEC_ARGS+=(--grant-ro "$g")
  done
fi

# LIVENESS IS A CONVERSATION, NOT A FILE. A stale socket outlives a crashed daemon,
# so the honest test is talking to it. What the daemon *says* when it refuses is kept
# in PROBE, because there is one refusal that must not be treated as "not running":
# a daemon speaking a different protocol version is alive and serving, and starting a
# second one over it would unlink its socket, leave it orphaned holding every session
# it has, and give no sign that had happened.
PROBE=""
# **Is a daemon there, without running one to find out.**
#
# `up` below answers the same question by attaching a whole head — right when the
# *protocol* matters, and four times too expensive when it does not. Measured 2026-09-20,
# `leticode --session …` with the daemon already up ran **four** `letibot-tui` processes,
# three of them that probe at three separate gates, to answer a question `ss` answers
# without forking anything.
#
# **`| grep -q` is a trap under `set -o pipefail`, which this script sets.** `grep -q`
# exits the moment it matches, sending `ss` a SIGPIPE — and `pipefail` reports the 141
# from the killed command even though the last one succeeded. Measured: `--attach` said
# *"no harnessd"* for a live daemon about one run in ten, on a socket list long enough
# that `ss` had more left to write than `grep` needed to read. The same shape sat at the
# `--ls` and `--daemons` checks, where it shows up as a live daemon labelled STALE.
#
# So both readers below run `ss` to completion and match the string in the shell: no
# pipe, no signal, and an answer that does not depend on what followed the match.
#
# One implementation for both callers, because `--ls` and `--daemons` check *every*
# record rather than this folder's, and a fix applied to one caller and forgotten in the
# other is exactly how this class of bug survives.
socket_is_listening() { # socket_is_listening PATH
  if [ "$HOST_OS" = Darwin ]; then
    [ -n "$(socket_pids "$1")" ]
    return
  fi
  case "$(ss -lxpH 2>/dev/null || true)" in
    *"$1"*) return 0 ;;
    *) return 1 ;;
  esac
}
live() {
  # **NOT `[ -S "$SOCKET" ]` FIRST, AND THAT LINE WAS THE DEFECT.** A daemon's own shutdown
  # path UNLINKS the socket file while the process goes on listening on the now-nameless
  # inode, so "is there a file" answers *no* for a folder that has a daemon. MEASURED
  # 2026-10-05 on the operator's box, and the consequence was a BRICKED session: the launcher
  # read no-file as no-daemon, started a second one, and two daemons interleaved rows into
  # one transcript until the store refused every append (`transcript_item seq must be the
  # next one`). `ss` names the path of a bound socket whether or not the file still exists —
  # verified here: one LISTEN row for a path `ls` said was not there — so it is the reader
  # that answers this question. The daemon now also holds a lock beside the socket, and it is
  # what refuses a second start; this is the launcher refusing to TRY.
  socket_is_listening "$SOCKET"
}
# **Listening but unreachable**: a daemon is here and its socket file is gone, so nothing can
# connect to it and starting a second one is the thing that corrupts the transcript. The one
# cleanup is a hand on the process, so the refusal names the pid.
live_detached() {
  socket_is_listening "$SOCKET" || return 1
  [ -S "$SOCKET" ] && return 1
  return 0
}
# **The refusal, in one place for both callers.** `--attach` and the plain run both reach a
# folder a daemon is holding without a file, and a message written twice is a message that
# drifts. Neither of them may start anything or hand a head a path that is gone.
refuse_detached() {
  echo "letibot: a harnessd for $WORKSPACE is still LISTENING but its socket file is gone." >&2
  echo "         $SOCKET" >&2
  echo "         Nothing can attach to it, and starting a second daemon for one folder is what" >&2
  echo "         makes two processes interleave rows into one transcript until the store refuses" >&2
  echo "         every write. Stop the live one and start again." >&2
  _stuck_pid="$(daemon_pid || true)"
  if [ -n "$_stuck_pid" ]; then
    echo "         letibot --stop            # or: kill $_stuck_pid" >&2
  else
    echo "         letibot --stop            # the pid could not be read; --daemons lists what is here" >&2
  fi
  exit 1
}
up() {
  [ -S "$SOCKET" ] || return 1
  # **`--probe`, not `--no-tty`.** The question is "is there a daemon here, and does
  # it speak this build's protocol" -- nothing about the transcript. `--no-tty
  # --since 0` is a whole head: it builds the config, reads the prefs, APPLIES THE
  # ENTIRE SNAPSHOT and renders a frame, and this runs before anything is on the
  # screen. Measured 2026-09-20 on a 1397-row session: 0.14 s that way, 0.02 s as a
  # probe. `--probe` attaches past the end so the daemon sends no history at all,
  # and prints the same refusal line on stderr, which is what this variable is read
  # for below.
  PROBE="$("$BIN/letibot-tui" --socket "$SOCKET" --probe </dev/null 2>&1 >/dev/null)" \
    && return 0
  return 1
}

# Refuse rather than route around it. Restarting somebody's daemon is their decision,
# and it is a safe one -- the transcripts are on disk and `--continue` brings them
# back -- but it is not one this script gets to make while a turn may be running.
version_skew_or_continue() {
  case "$PROBE" in
    *"protocol version"*)
      echo "letibot: the daemon on $SOCKET does not speak this build's protocol." >&2
      echo "         $PROBE" >&2
      echo "         It is alive and still serving its sessions, so nothing was started" >&2
      echo "         over it. Stop it when you are ready (letibot --stop) and run this" >&2
      echo "         again; every transcript is on disk and letibot --continue reopens" >&2
      echo "         the newest one in this workspace." >&2
      exit 1 ;;
  esac
}

# The record beside the socket: what this folder's daemon is. Written by the
# launcher when it starts one; read by --status, --stop, --daemons and the
# attach banner. The pid in it is how the daemon is stopped - a name is how
# every harnessd on the box gets stopped.
record_write() {
  python3 - "$RECORD" "$WORKSPACE" "$SOCKET" "$1" "$ROLE" "$MODEL" "$DIALECT" "${BASH_ON:-}" "$(answers_now)" <<'PY'
import json, sys, time
rec, ws, sock, pid, role, model, dialect, bash, answers = sys.argv[1:10]
json.dump({"workspace": ws, "socket": sock, "pid": int(pid), "role": role, "model": model,
           "answers": answers,
           "dialect": dialect, "bash": bool(bash), "started": time.strftime("%Y-%m-%dT%H:%M:%S%z")},
          open(rec, "w"))
PY
}
# **Flat-JSON field reads, in bash.** The record is written by `record_write` below
# and is a single flat object, so a `sed` is enough — and it matters: this function is
# called several times on the path that runs *before* anything is on the screen, and
# each call was a `python3` fork of ~30 ms. Measured on `--attach` 2026-09-20: nine
# interpreter and filter forks, 0.43 s of launcher against 0.07 s of actual work.
#
# A string field, or an empty string when the file or the key is absent — the same
# contract the python3 version had, including the empty string (callers test `-n`).
json_str() { # json_str KEY FILE
  [ -f "$2" ] || return 0
  sed -n 's/.*"'"$1"'"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' "$2" 2>/dev/null | head -1
}
json_num() { # json_num KEY FILE
  [ -f "$2" ] || return 0
  sed -n 's/.*"'"$1"'"[[:space:]]*:[[:space:]]*\([0-9][0-9]*\).*/\1/p' "$2" 2>/dev/null | head -1
}
#
# A field whose type the caller does not know — `--ls` wants `pid` and `workspace`
# through the same call, and one is a number and one is a string. So this tries the
# quoted form and falls back to the bare number, which is what the python3 version did
# by virtue of not caring. **Found by running `--ls`, which printed `pid ` with the
# number missing**: the string reader cannot see `"pid": 645043`.
json_field() { # json_field KEY FILE
  local v
  v="$(json_str "$1" "$2")"
  [ -n "$v" ] && { printf '%s' "$v"; return 0; }
  json_num "$1" "$2"
}
record_field() { json_field "$1" "$RECORD"; }
record_field_of() { json_field "$2" "$1"; }

# **A number from `--ls`, or a directory, resolved to that daemon's socket.**
#
# tmux's whole ergonomic claim is that you act on a thing by the handle the list
# just gave you, rather than retyping a path. `--ls` numbers the daemons in
# $RUNDIR order; this maps that number back. A directory still works, and so does
# no argument at all (this folder), so nothing that used to work stops.
#
# Sets WORKSPACE, KEY, SOCKET and RECORD, the four the rest of this script reads.
retarget() {
  local want="$1" n=0 r ws
  case "$want" in
    ''|.) return 0 ;;
    *[!0-9]*)
      WORKSPACE="$(cd "$want" && pwd -P)" || die "no such directory: $want"
      ;;
    *)
      for r in "$RUNDIR"/*.json; do
        [ -f "$r" ] || continue
        n=$((n+1))
        [ "$n" = "$want" ] || continue
        ws="$(record_field_of "$r" workspace)"
        WORKSPACE="$ws"
        break
      done
      [ "$n" -ge "$want" ] || die "there is no daemon $want — \`letibot --ls\` numbers them"
      ;;
  esac
  KEY="$(printf '%s' "$WORKSPACE" | sha12)"
  SOCKET="$RUNDIR/$KEY.sock"
  RECORD="$RUNDIR/$KEY.json"
}
# **Is this pid gone, waited for, bounded.** The one place the launcher decides
# whether a daemon actually stopped, so the two verbs that stop one cannot disagree.
#
# Measured 2026-09-16: a daemon wedged on a `llama-server` that had gone away swallowed
# SIGTERM, `--stop` printed "stopped", deleted the record, and left an orphan holding the
# store and the GPU that `--daemons` could no longer see. So "stopped" is said after the
# process is gone and never after the signal is sent. `--stop --all` had the other half of
# that defect until now: it echoed `stopped` straight off `kill`'s exit status.
wait_gone() { # wait_gone PID [TENTHS]
  local p="$1" n="${2:-10}" i=0
  while [ "$i" -lt "$n" ]; do
    pid_alive "$p" || return 0
    sleep 0.5
    i=$((i + 1))
  done
  pid_alive "$p" && return 1
  return 0
}

daemon_pid() {
  # The pid LISTENING on our socket, which is the daemon whatever the record says;
  # the record is a fallback for a box without `ss`.
  local p
  # `|| true`: `head -1` SIGPIPEs the upstream under `pipefail`, and a failing command
  # substitution in an assignment aborts the script under `set -e` — from a helper
  # whose whole job is to be a fallback.
  p="$(socket_pids "$SOCKET" | head -1 || true)"
  [ -n "$p" ] && { echo "$p"; return 0; }
  p="$(record_field pid)"
  [ -n "$p" ] && pid_alive "$p" && { echo "$p"; return 0; }
  return 1
}

warn_swallowed_flags() {
  # **The SEAT is the flag that is silently swallowed most, and it does not travel
  # in EXTRA_ARGS.** Role reaches harnessd as `--role` and the shell as `--bash`,
  # so a `leticode` (role leticode, bash on) run against a folder whose daemon is
  # already a plain `letibot` (coder, no bash) attached to the coder daemon and
  # said nothing -- the operator got a session that could not run a test and was
  # told nothing about why. The seat is fixed when the daemon starts; attaching
  # cannot change it, and the honest thing is to say so, not to look only at the
  # args a person typed after the verb.
  local want_role="$ROLE" want_bash have_role have_bash mism=0
  # The model this run asked for: an explicit `--model` wins over the flag that
  # picked a family, and the daemon's record carries the same word for both.
  local want_model="${MODEL_OVERRIDE:-$MODEL}"
  want_bash="$([ -n "$BASH_ON" ] && echo true || echo false)"
  have_role="$(record_field role 2>/dev/null || true)"
  have_bash="$(record_field bash 2>/dev/null || true)"
  {
    if [ -n "$have_role" ] && [ "$have_role" != "$want_role" ]; then
      echo "letibot: you asked for the \`$want_role\` seat, but this folder's daemon is already running as \`$have_role\` (pid $(daemon_pid 2>/dev/null || echo "?"))."
      mism=1
    fi
    if [ -n "$have_bash" ] && [ "$have_bash" != "$want_bash" ]; then
      echo "letibot: you asked for $([ "$want_bash" = true ] && echo "a shell" || echo "no shell"), but this folder's daemon was started with $([ "$have_bash" = true ] && echo "one" || echo "none")."
      mism=1
    fi
    # **And the MODEL flag, which no other check in this script can see.** The
    # port check above fires only when the port serves a model the daemon is not
    # bound to — so a daemon bound to `qwen-3.8-27b` while 8081 serves that same
    # model, plus a `--glm`, passed every gate and attached in silence to the
    # wrong model. That is the same silent shape the seat check exists for.
    if [ -n "$MODEL_FLAG" ]; then
      local dpid have_model
      # **The process's own command line first, the record second**, for the reason
      # `daemon_models` reads `/proc` at all: a record written before the field existed
      # has no `model`, and MEASURED 2026-10-07 on this box, the daemon holding the
      # operator's own workspace is exactly such a record — `--status` printed
      # `vocab unknown`, so a check that only read the record stayed SILENT about the
      # model flag on the one daemon it had to speak about.
      dpid="$(daemon_pid 2>/dev/null || true)"
      have_model=""
      [ -n "$dpid" ] && have_model="$(pid_argv "$dpid" \
        | awk '/^--model$/{getline; print; exit}')"
      [ -n "$have_model" ] || have_model="$(record_field model 2>/dev/null || true)"
      if [ -n "$have_model" ] && [ "$have_model" != "$want_model" ]; then
        echo "letibot: you asked for \`$want_model\` ($MODEL_FLAG), but this folder's daemon is already running as \`$have_model\` (pid ${dpid:-?})."
        mism=1
      fi
    fi
    # **One advice line for both mismatches, and it comes AFTER the model check.**
    # The first version put this block before it, so a MODEL mismatch set `mism` and
    # then nothing printed it: a warning with no way out. MEASURED 2026-10-07 by
    # running `leticode --flash` against this folder's glm daemon and reading the
    # output — one line, and it ended there.
    if [ "$mism" = 1 ]; then
      echo "         The seat and the model are fixed when harnessd STARTS; attaching to a running one cannot change either."
      echo "         For what you asked for:  $(restart_advice)"
      echo "         Sessions are on disk, so nothing is lost -- '--continue' reopens this one."
    fi
    if [ ${#EXTRA_ARGS[@]} -gt 0 ]; then
      echo "letibot: this folder's daemon is ALREADY RUNNING (pid $(daemon_pid 2>/dev/null || echo "?")) and these flags did NOT take effect:"
      printf '         %s\n' "${EXTRA_ARGS[*]}"
      echo "         They are read when harnessd STARTS and are fixed for the life of the daemon."
      echo "         To apply them:  $(restart_advice) ${EXTRA_ARGS[*]}"
      echo "         Sessions are on disk, so nothing is lost -- 'letibot --continue' reopens this one."
    fi
  } >&2
}
daemon_line() {
  # One line about this folder's daemon, for the attach banner and --status.
  #
  # **`answers`, not `model`,** when the record has one: the `model` field is the local
  # vocab the daemon binds (`qwen-3.8-27b`), and a session whose turns go to deepseek was
  # being announced as qwen on every attach — the operator: *"so - qwen again"*. The two
  # are both recorded, because they are both true; only one answers the turns.
  local p started role model answers who
  p="$(daemon_pid || true)"; started="$(record_field started)"; role="$(record_field role)"
  model="$(record_field model)"; answers="$(record_field answers)"
  # **`answers` is what answers the turns; `model` is the local vocab.**
  #
  # A record written before this field existed has no `answers`, and the honest label for
  # the field it does have is **`vocab`** — it is the vocab the daemon binds token ids
  # against, which is true and is not a claim about what is answering. Calling it `model`
  # for a legacy record is what produced the operator's *"so - qwen again"* on an attach
  # to a session whose turns went to deepseek.
  if [ -n "$answers" ]; then
    who="model $answers"
  else
    who="vocab ${model:-unknown}"
  fi
  echo "harnessd for $WORKSPACE${p:+ (pid $p)}${started:+, up since $started}${role:+, role $role}${who:+ $who}"
}

# **THE DAEMON IS A PROCESS, AND EVERY FIX REACHES IT LAST.**
#
# A commit, a build and a running daemon are three different facts, and only the
# third one changes what the operator sees. This is the tree's own rule — *"landed,
# deployed and running are three different facts, and a rule you can read in a file
# is evidence of none of them"* — and the daemon is where it keeps biting, because
# it is the one long-lived process here and it reads its executable exactly once, at
# exec.
#
# MEASURED 2026-10-02, three times in one day, and the third is the one that cost the
# most: a fix committed at 16:37 and another at 17:01 were both in
# `target/release/harnessd`, built 17:02, while leticl's daemon had started at 16:02.
# So the head went on failing with `400: you requested 1464765 tokens` — which reads
# EXACTLY like the unfixed bug, because as far as that process was concerned it was
# the unfixed bug. The operator's report was *"leticl is stuck with compaction again,
# for some reason it is broken"*, and it was not broken; it was 25 minutes behind.
# Knowing that meant comparing a commit timestamp, `ps -o lstart` and a file's mtime
# by hand. Nobody should have to do that once, never mind three times.
#
# **Both facts are already in this script**: `BIN` is the binary this launcher would
# start, and `daemon_pid` names the one that is live. `/proc/<pid>`'s own mtime IS the
# process start time — checked against `/proc/<pid>/stat` field 22 (starttime in clock
# ticks, converted through `/proc/uptime`) and the two agree to 0.0s — so the whole
# comparison is one `stat` and no interpreter fork, on a path that runs before
# anything is on the screen.
#
# **A line, not a restart, and not a refusal.** A restart drops an in-flight turn and
# that is the operator's call every time; the defect is not that a daemon is old, it is
# that nothing says so. `/proc/<pid>/exe` reading `(deleted)` is the kernel telling the
# truth — true of both stale daemons on this box today — but it says the executable was
# REPLACED, not which way; the timestamps are what make the sentence specific.
#
# **And the line is about the BINARY, not about correctness.** A rebuild that only
# touched the TUI obliges no daemon restart, so anything stronger would cry wolf on a
# safe box. `it is not running what is on disk` is checkable and is true whenever it is
# printed. The stronger answer is a build id carried by the daemon and compared by the
# launcher — `--version` already distinguishes releases and would have caught every
# case today — and that is a separate change.
daemon_stale_line() {
  local p dt bt
  p="$(daemon_pid 2>/dev/null || true)"
  [ -n "$p" ] || return 0
  [ -x "$BIN/harnessd" ] || return 0
  dt="$(pid_started "$p")"
  bt="$(file_mtime "$BIN/harnessd")"
  # A `stat` that could not answer, or a value that is not a number: say nothing.
  # Silence is the right answer for an unknown — this is a hint about a process, not
  # a gate, and a guess here would be a warning about a daemon that is fine.
  case "$dt$bt" in '' | *[!0-9]*) return 0 ;; esac
  # Built before this daemon started? Then it is running what was on disk then.
  [ "$bt" -gt "$dt" ] || return 0
  # **With the date, not just the clock.** The daemon this was written for had been
  # up for five days, and `started 14:57` reads as though that were today — the gap
  # this line exists to name is a day count as often as it is minutes, so both ends
  # carry the day. The path is quoted as resolved, which is what `BIN` now holds.
  printf 'daemon %s started %s; %s was built %s — it is not running what is on disk\n' \
    "$p" "$(epoch_fmt "$dt" '+%m-%d %H:%M')" "$BIN/harnessd" "$(epoch_fmt "$bt" '+%m-%d %H:%M')"
}

# Questions about the store need no socket, no model and no vocabulary. They are
# answered before any of that is checked, so `letibot --sessions` still works on a
# box whose model server is down -- which is exactly when you want to look.
case "${1:-}" in
  --sessions|--list)
    exec "${NOGPU[@]}" "$BIN/harnessd" --store "$STORE" --list-sessions ;;
  --rename)
    [ $# -ge 2 ] || die "--rename ID [TITLE]  (an empty title clears the name)"
    exec "${NOGPU[@]}" "$BIN/harnessd" --store "$STORE" --rename "$2" "${3:-}" ;;
  --delete)
    [ $# -ge 2 ] || die "--delete ID"
    exec "${NOGPU[@]}" "$BIN/harnessd" --store "$STORE" --delete "$2" ;;
  --ls|--list-all)
    # **The byobu view: every folder's daemon, and what is live inside it.**
    #
    # `--daemons` answers "which folders have one"; `--sessions` answers "what is
    # on disk, here". Neither answers the question an operator actually has with
    # three of these running — what is going on, everywhere — and neither gives a
    # handle to act on. This does both: one numbered list, and the number is what
    # `--stop N` and `--attach N` take.
    #
    # Live sessions only, plus a count of the rest: byobu lists the windows that
    # exist, not every one ever opened, and a daemon here holds ~70 on disk.
    i=0
    found=0
    for r in "$RUNDIR"/*.json; do
      [ -f "$r" ] || continue
      ws="$(record_field_of "$r" workspace)"
      sock="$(record_field_of "$r" socket)"
      pid="$(record_field_of "$r" pid)"
      if socket_is_listening "$sock"; then state=up; else state=STALE; fi
      found=1
      i=$((i+1))
      printf '%2d  %-34s %-6s %s\n' "$i" "${ws/#$HOME/~}" "$state" "pid $pid"
      [ "$state" = up ] || continue
      all="$("$BIN/letibot-tui" --socket "$sock" --list-sessions 2>/dev/null)"
      live_n=0
      while IFS=$'\t' read -r id title live running heads rows model; do
        [ -n "$id" ] || continue
        [ "$live" = true ] || continue
        live_n=$((live_n+1))
        note=""
        [ "$running" = true ] && note="RUNNING"
        [ "${heads:-0}" != 0 ] && note="$note ${heads} head(s)"
        printf '     %-30.30s %6s rows  %-16s %s\n' "$title" "$rows" "$model" "$note"
      done <<SESSIONS_EOF
$all
SESSIONS_EOF
      total=$(printf '%s\n' "$all" | grep -c . || true)
      rest=$((total - live_n))
      [ "$rest" -gt 0 ] && printf '     %s\n' "($rest more on disk — --sessions lists them, --continue reopens the newest)"
    done
    if [ "$found" = 1 ]; then
      echo ""
      echo "  letibot --attach N    letibot --stop N    (N is the number above)"
    else
      echo "no daemons recorded under $RUNDIR"
    fi
    exit 0 ;;
  --daemons)
    # Every folder's daemon: the records, each checked against a live listener.
    found=0
    for r in "$RUNDIR"/*.json; do
      [ -f "$r" ] || continue
      found=1
      ws="$(json_str workspace "$r")"
      sock="$(json_str socket "$r")"
      pid="$(json_num pid "$r")"
      if socket_is_listening "$sock"; then state="up (pid $pid)"; else state="STALE (nothing listens on its socket)"; fi
      echo "$ws  $state  $sock"
    done
    [ "$found" = 1 ] || echo "no daemons recorded under $RUNDIR"
    exit 0 ;;
  --stop)
    # `--stop N` and `--stop DIR` reach another folder's daemon; `--stop` alone is
    # still this one's. Numbering comes from `--ls`.
    [ "${2:-}" = "--all" ] || [ "${2:-}" = "--force" ] || retarget "${2:-}"
    if [ "${2:-}" = "--all" ]; then
      # **And the exit status agrees with the words**, as the single-target path's
      # does: a run that said `NOT stopped` and exited 0 would be a script a caller
      # cannot branch on, which is the same defect one layer out.
      all_failed=0
      for r in "$RUNDIR"/*.json; do
        [ -f "$r" ] || continue
        pid="$(json_num pid "$r")"
        ws="$(json_str workspace "$r")"
        if pid_alive "$pid" && pid_argv "$pid" | head -1 | grep -q harnessd; then
          # **Signal, then WAIT, then say it.** The exit status of `kill` says the
          # signal was delivered and nothing about whether the process took it —
          # which is the whole of the 2026-09-16 incident, one verb over.
          kill "$pid" 2>/dev/null || true
          if wait_gone "$pid"; then
            echo "stopped $ws (pid $pid)"
            rm -f "$r"
          else
            echo "NOT stopped: $ws (pid $pid) is ignoring SIGTERM after 5s." >&2
            echo "  letibot --stop --force    sends SIGKILL; the record is kept until it is gone" >&2
            all_failed=1
          fi
        else
          echo "stale record for $ws (pid $pid gone)"; rm -f "$r"
        fi
      done
      exit "$all_failed"
    fi
    if p="$(daemon_pid)"; then
      if [ "$FORCE" = 1 ]; then
        # Abort the turns BEFORE the signal, over the protocol: a busy daemon's
        # worker finishes a turn mid-flight before honouring SIGTERM, and a wedged
        # one never does. An interrupt is the frame an Esc-Esc sends.
        "$BIN/letibot-tui" --socket "$SOCKET" --interrupt-all || true
      fi
      # "stopped" is said AFTER the process is gone, not after the signal is
      # sent, and the record is removed only then. Measured 2026-09-16: a daemon
      # wedged on a llama-server that had gone away swallowed SIGTERM, this
      # printed "stopped", deleted the record, and left an orphan holding the
      # store and the GPU that `--daemons` could no longer see.
      line="$(daemon_line)"
      kill "$p" || true
      wait_gone "$p" || true
      if pid_alive "$p" && [ "$FORCE" = 1 ]; then
        kill -9 "$p" 2>/dev/null || true
        wait_gone "$p" 4 || true
      fi
      if pid_alive "$p"; then
        echo "NOT stopped: $line (pid $p) is ignoring SIGTERM after 5s." >&2
        echo "  letibot --stop --force    sends SIGKILL; the record is kept until it is gone" >&2
        exit 1
      fi
      echo "stopped $line"
      rm -f "$RECORD"
    else
      echo "no daemon for $WORKSPACE (letibot --daemons lists the others)"
    fi
    exit 0 ;;
  --status)
    if up; then
      echo "up: $(daemon_line)"
      stale="$(daemon_stale_line)"
      [ -n "$stale" ] && echo "! $stale"
      echo "socket   $SOCKET"
    elif live_detached; then
      # **A daemon is here and cannot be reached.** Saying "no daemon" here is the sentence
      # that got a second one started, and saying "up" would be false: the path a head needs
      # is gone. Both halves of the truth, and which one to act on.
      echo "DETACHED: a harnessd is listening on $SOCKET but the socket FILE is gone (pid $(daemon_pid 2>/dev/null || echo ?))"
      echo "          nothing can attach to it; letibot --stop  (or kill the pid above)"
      echo "socket   $SOCKET"
    elif [ -n "$PROBE" ]; then
      # Something answered and refused. That is a different fact from silence, and
      # printing "not running" for it is how a live daemon gets a second one started
      # on top of it.
      echo "on $SOCKET, but not speaking to this build: $PROBE"
    else
      echo "no daemon for $WORKSPACE"
    fi
    # The local model server is a separate fact from what answers the turns, so it is
    # reported separately — and labelled for what it is. It said `model`, beside a
    # daemon whose turns go to a provider, which reads as "this is the model": the
    # operator's *"so - qwen again"* was about the line two rows up, but this one
    # invited the same reading. See `daemon_line`.
    # No resolved address is a refusal here too, not a quiet skip of the line:
    # "what would answer locally" is half of what --status exists to say.
    if [ -z "$ENDPOINT" ]; then
      # A provider answers the turns, so no local home is a fact to report, not a refusal.
      [ -n "$PROVIDER_SET" ] || [ -n "$(default_provider provider)" ] || die "$(endpoint_refusal)"
      echo "local    none  ('$LOOKUP_MODEL' has no [model.\"…\"] block in $PROVIDERS; the turns go to the provider)"
      exit 0
    fi
    printf 'local    %s ' "$ENDPOINT"
    if curl -sf -m 3 "http://$ENDPOINT/health" >/dev/null 2>&1; then
      # Name what is actually loaded, not what the default says. One port serves
      # three models by rotation, so "ok" alone answers the wrong question.
      echo "ok  ($MODEL, dialect $DIALECT)"
    else
      echo "NOT SERVING"
    fi
    exit 0 ;;
  --attach)
    # Connect only. A second argument names another folder's daemon — as a
    # directory, or as the number `letibot --ls` printed beside it.
    retarget "${2:-}"
    if live_detached; then refuse_detached; fi
    if live; then
      echo "letibot: attached to $(daemon_line)" >&2
      stale="$(daemon_stale_line)"
      [ -n "$stale" ] && echo "letibot: ! $stale" >&2
      warn_swallowed_flags
      exec "$HEAD" --socket "$SOCKET" --identity "${USER:-operator}"
    fi
    # **No probe here, deliberately.** This path starts nothing, so there is nothing
    # to guard: a daemon that is there reports its own skew through the head's own
    # error (it is the same refusal this would have printed), and a daemon that is
    # not is the message below. Probing would be a head process to re-ask a question
    # `live` just answered.
    echo "letibot: no harnessd for $WORKSPACE - run \`letibot\` there to start one" >&2
    echo "         (letibot --daemons lists the folders that have one)" >&2
    exit 1 ;;
esac

# Which session this invocation is about, decided before anything is started.
# SESSION is the id to reopen; NEW_TITLE (when set) means make a fresh one instead.
SESSION=""
NEW_TITLE=""
WANT_NEW=0
case "${1:-}" in
  --continue|-c)
    shift
    # Scoped to this workspace by default. A session's workspace is a stored fact,
    # and reopening a ~/ conversation while standing in Projects/rano is almost
    # never what was meant -- so the scope is a path prefix with the exact match
    # preferred, which lets `--continue` work from a subdirectory without reaching
    # sideways into a sibling tree.
    # stderr is deliberately NOT captured: harnessd prints which session it picked,
    # its title, its row count and its workspace there. Continuing the wrong
    # conversation is not a keystroke you can take back -- the next thing you type
    # lands in it -- so the pick is announced before the head opens over it.
    if ! SESSION="$("${NOGPU[@]}" "$BIN/harnessd" --store "$STORE" --latest-session --scope "$WORKSPACE")"; then
      echo "letibot: no session with anything in it under $WORKSPACE." >&2
      echo '         "letibot --sessions" lists what is on disk; plain "letibot" starts a new one.' >&2
      exit 1
    fi
    ;;
  --session|-s)
    [ $# -ge 2 ] || die "--session ID   (\`letibot --sessions\` lists them)"
    SESSION="$2"; shift 2 ;;
  --new|-n)
    shift
    WANT_NEW=1
    NEW_TITLE="${1:-}"; [ $# -gt 0 ] && shift || true ;;
esac

[ -x "$BIN/harnessd" ] || die "no harnessd at $BIN
  This launcher looks beside itself and in ../../target/release, unless LETIBOT_BIN
  says otherwise. From a source checkout that means: cargo build --release.
  From an install the binaries should be beside this script, so re-install, or
  point LETIBOT_BIN at the directory holding them."

# **The remedy has to be one a reader can carry out.** This said
# `systemctl --user start qwen-flash-next`, which names a unit that exists on
# exactly one machine — the same shape as the `BIN` default above and as the
# `cargo build --release` this script used to recommend to an installed box: a
# message that is true where it was written and unusable everywhere else.
#
# What is true for everyone: a model server has to be running, it speaks the OpenAI
# shape, and the address is whatever `$ENDPOINT` says -- which since the providers.toml
# lookup is the home of THIS run's model, so the example port below is the endpoint's
# own rather than a literal. (install.sh still prints the generic `--port 8080` line:
# it advises a bare box before any providers.toml exists.)
#
# **Only when the turns go there.** A provider — `--provider`, or the `[default]` block in
# providers.toml — answers over the network, and a box that has only a key (a laptop, a Mac
# with no llama-server) died here on the very remedy the message below suggests. MEASURED
# 2026-10-07 on macOS: `letibot --provider deepseek` with nothing on 8080 refused to start.
# **The vocabulary goes with the same question.** A local model needs the GGUF it serves,
# so `--vocab` is always passed then. A provider needs none — the daemon keeps its ledger
# in the byte vocabulary (`letibot_tokencore::Vocab::bytes`) — so it is passed only when
# it names a file that is there (a box with the model keeps using it, and its sessions
# keep their ids) or when LETIBOT_VOCAB asked for it by name.
#
# **And the address is a LOOKUP now, so it can be ABSENT.** A model whose block is missing,
# or whose block carries no url, has no home — refused here, once, by `endpoint_refusal`,
# naming the flag that asked, the model it wanted and the file it read. Before the health
# gate, because a gate needs an address to curl.
#
# **But only a run whose turns go to the local model needs that home.** With a provider
# (`--provider`, or `[default] provider` in providers.toml) the local alias answers nothing,
# so a missing block is no reason to refuse -- and refusing was a regression: a box whose
# providers.toml is a `[default]` and a key, and no `[model."…"]` block at all, worked
# before the lookup and died after it. MEASURED 2026-10-08, the operator's `leticode` with
# deepseek as the default. The daemon then keeps its own default endpoint, which no turn
# reaches; `tests/launcher.sh` holds both halves.
if [ -z "$ENDPOINT" ] && [ -z "$PROVIDER_SET" ] && [ -z "$(default_provider provider)" ]; then
  die "$(endpoint_refusal)"
fi
ENDPOINT_ARGS=()
[ -z "$ENDPOINT" ] || ENDPOINT_ARGS=(--endpoint "$ENDPOINT")
if [ -z "$PROVIDER_SET" ] && [ -z "$(default_provider provider)" ] \
  && ! curl -sf -m 3 "http://$ENDPOINT/health" >/dev/null 2>&1; then
  # **Nothing to answer, and a person at the keyboard: ask, rather than die.** The
  # operator: *"id prefer leticode to ask me of course"*. The choice becomes `--provider`;
  # the KEY is not asked here — the daemon asks for it on the first turn, on the masked
  # card sudo's password uses, and saves it (0600) with this provider as the default, so
  # this question is asked once per box. Without a terminal there is nobody to ask, and
  # the refusal stands as it was.
  if [ -t 0 ] && [ -t 1 ]; then
    printf '%s\n' "letibot: nothing is serving a local model on $ENDPOINT, and no cloud provider is set up." \
      "  Use a cloud provider? Its key is asked for on the first turn and saved." \
      "    1) deepseek    2) glm    3) grok        (enter quits)" >&2
    printf '  > ' >&2
    _choice=""
    read -r _choice || _choice=""
    case "$_choice" in
      1 | deepseek) PROVIDER_NAME=deepseek ;;
      2 | glm) PROVIDER_NAME=glm ;;
      3 | grok) PROVIDER_NAME=grok ;;
      *) die "no provider chosen, and nothing serving on $ENDPOINT — nothing was started." ;;
    esac
    PROVIDER_SET=1
    EXTRA_ARGS+=(--provider "$PROVIDER_NAME")
    # The local alias is a LOCAL binding; handed to a provider it is a 400 naming models
    # the provider has (the reason MODEL_ARGS is empty for `--provider` above).
    [ -n "$MODEL_OVERRIDE" ] || MODEL_ARGS=()
  else
    die "nothing serving on $ENDPOINT
  Start a model server first — letibot is a harness, and a turn needs one:
    llama-server -m MODEL.gguf --port ${ENDPOINT##*:}
  or a cloud provider instead:  --provider deepseek|glm|grok
  Point this launcher elsewhere with LETIBOT_ENDPOINT=host:port."
  fi
fi

VOCAB_ARGS=(--vocab "$VOCAB")
if [ -n "$PROVIDER_SET" ] || [ -n "$(default_provider provider)" ]; then
  if [ -z "${LETIBOT_VOCAB:-}" ] && [ ! -f "$VOCAB" ]; then
    VOCAB_ARGS=()
  fi
fi


# THE RUNNING DAEMON'S MODEL MUST BE THE MODEL ON THE PORT.
#
# A daemon renders and submits TOKEN IDS, so its vocab has to be the vocab of the
# server on the other end. Nothing reconciles that at runtime: --dialect, --model
# and --vocab are decided when the daemon starts, so `letibot --glm` against an
# already-running Qwen daemon sets three variables that are then never used, and
# the detection above is equally powerless -- it also only feeds a daemon START.
#
# Measured 2026-09-10, and it is why this check exists: GLM took port 8080, the
# Qwen-bound daemon stayed up, and every turn came back
#   http 400 {"error":{"code":400,"message":"Prompt contains invalid tokens"}}
# That is the honest failure -- ids from one vocab are not ids in the other, and
# llama.cpp validates them. A client sending `messages` rather than ids would have
# received a plausible WRONG ANSWER instead of a 400, which is the whole argument
# for submitting ids.
#
# Refuse in the same call that would have failed, and hand over the fix, per
# docs/tool-design-brief.md 2.1.
daemon_models() {
  # Only the pids actually LISTENING on OUR socket. A stale daemon whose path was
  # rebound out from under it still shows in `ps`, and killing or trusting the
  # wrong one is how a live session gets taken down to fix a dead one.
  local pids
  pids="$(socket_pids "$SOCKET")"
  local pid
  for pid in $pids; do
    pid_argv "$pid" | awk '/^--model$/{getline; print; exit}'
  done
}

if live && [ -n "$ENDPOINT" ]; then
  SERVING="$(curl -sf -m 3 "http://$ENDPOINT/props" 2>/dev/null \
    | sed -n 's/.*"model_alias"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' | head -1)"
  BOUND="$(daemon_models | paste -sd, -)"
  if [ -n "$SERVING" ] && [ -n "$BOUND" ] && ! printf '%s\n' "$BOUND" | tr ',' '\n' | grep -qxF "$SERVING"; then
    echo "letibot: the daemon on $SOCKET is bound to '$BOUND' but $ENDPOINT is serving '$SERVING'." >&2
    echo "         A daemon submits token ids, so the vocabs must match; every turn would come" >&2
    echo "         back http 400 \"Prompt contains invalid tokens\"." >&2
    echo "         --glm/--flash/--dense choose a model only when the daemon STARTS. They" >&2
    echo "         cannot rebind one that is already running, and neither can autodetection." >&2
    echo "" >&2
    echo "         Fix:  $(restart_advice)" >&2
    echo "         Sessions are on disk, so nothing is lost -- 'letibot --continue' reopens this one." >&2
    exit 1
  fi
fi

mkdir -p "$(dirname "$STORE")" "$(dirname "$LOG")"

# One-shot: no daemon, no TUI. Useful in scripts and for a quick question. The
# socket is its own, so two one-shots side by side do not fight over the
# folder's (measured: the second said "already served by a live daemon" and
# exited before its prompt ran).
if [ $# -gt 0 ]; then
  ONESHOT_SOCK="$RUNDIR/oneshot-$$.sock"
  exec "${NOGPU[@]}" "$BIN/harnessd" --dialect "$DIALECT" ${MODEL_ARGS[@]+"${MODEL_ARGS[@]}"} ${ENDPOINT_ARGS[@]+"${ENDPOINT_ARGS[@]}"} \
       --socket "$ONESHOT_SOCK" \
       ${VOCAB_ARGS[@]+"${VOCAB_ARGS[@]}"} --workspace "$WORKSPACE" --store "$STORE" \
       --role "$ROLE" ${ADJ:+--adjudicator console} ${MODE:+--mode "$MODE"} \
       ${SUPERVISE:+--supervise} ${ORACLE:+--oracle "$ORACLE"} ${ORACLE_BUDGET:+--oracle-budget-ms "$ORACLE_BUDGET"} \
       ${EXEC_ARGS[@]+"${EXEC_ARGS[@]}"} ${EXTRA_ARGS[@]+"${EXTRA_ARGS[@]}"} \
       ${SESSION:+--session "$SESSION"} --prompt "$*"
fi

# **A flag that shapes the SESSION cannot be applied to a daemon that is already
# running.** (definition; called from both the attach and the start paths) The role, the model, the provider and the search backend are all
# decided when harnessd starts and are cloned into every session it opens, so
# passing one here while a daemon is up used to do exactly nothing, silently.
#
# Measured 2026-09-15: `leticode --web-search brave` against a daemon started
# without it attached, seated no `web_search`, and said so nowhere -- the
# operator reasonably concluded the feature did not work. That is the same
# "a banner saying one thing and a session doing another" this tree refuses
# everywhere else, and a launcher is not exempt from it.
#
# It is a WARNING rather than a refusal: attaching is still what you asked for
# and the session is still usable. What it may not do is pretend the flag landed.

if live; then warn_swallowed_flags; fi

# **And nothing is ever started over a daemon that is listening without its file.** This is
# the state that bricked a session: `live` is true, so the start branch below is not taken,
# and every path past here would have attached a head to a socket path that does not exist.
if live_detached; then refuse_detached; fi

if ! live; then
  # **The probe belongs here and only here.** This is the branch that is about to
  # *start* a daemon, and starting one over a live-but-skewed daemon unlinks its
  # socket and orphans every session it holds. `live` already said nothing is
  # listening; `up` is the belt to that braces, because it is a real conversation
  # rather than a netlink dump.
  version_skew_or_continue
  # Nothing answered, so the file is a leftover.
  rm -f "$SOCKET"
  # The daemon opens its first session eagerly, so passing `--session ID` here is
  # what makes the resume -- and its hash-chain check -- happen at startup, where a
  # failure is a line in this terminal rather than a surprise inside a prompt.
  detach "${NOGPU[@]}" "$BIN/harnessd" --dialect "$DIALECT" ${MODEL_ARGS[@]+"${MODEL_ARGS[@]}"} ${ENDPOINT_ARGS[@]+"${ENDPOINT_ARGS[@]}"} \
      ${VOCAB_ARGS[@]+"${VOCAB_ARGS[@]}"} --workspace "$WORKSPACE" --store "$STORE" --socket "$SOCKET" \
      --role "$ROLE" ${ADJ:+--adjudicator "$ADJ"} ${MODE:+--mode "$MODE"} \
      ${SUPERVISE:+--supervise} ${ORACLE:+--oracle "$ORACLE"} ${ORACLE_BUDGET:+--oracle-budget-ms "$ORACLE_BUDGET"} \
      ${EXEC_ARGS[@]+"${EXEC_ARGS[@]}"} ${EXTRA_ARGS[@]+"${EXTRA_ARGS[@]}"} \
      ${SESSION:+--session "$SESSION"} ${NEW_TITLE:+--title "$NEW_TITLE"} \
      >>"$LOG" 2>&1 </dev/null &
  DPID=$!
  # The banner names what will answer the turns, not the local vocab's model — see
  # `answers_now`.
  echo "letibot: no harnessd for $WORKSPACE - starting one (role $ROLE, model $(answers_now), pid $DPID)" >&2
  # Poll the cheap check, not the probe: this runs up to sixty times while a cold
  # daemon boots, and sixty head processes to watch one start is the same mistake
  # one layer down.
  for _ in $(seq 1 60); do live && break; sleep 0.5; done
  live || { echo "letibot: daemon did not come up; last lines of $LOG:" >&2; tail -15 "$LOG" >&2; exit 1; }
  record_write "$DPID"
  # The session was named on the daemon's own command line, so the head attaches to
  # it by being the head of that daemon. Nothing more to ask for.
  exec "$HEAD" --socket "$SOCKET" --identity "${USER:-operator}"
fi

# A daemon is already up. Ask it, rather than restarting it: a restart would cost
# every other session on this box to open one, and one of them may be mid-turn.
echo "letibot: attached to $(daemon_line)" >&2

# **And say whether what is answering is what is on disk**, before anything else is
# said: a stale daemon makes every other line here describe the wrong build. See
# `daemon_stale_line` for why this is a sentence and not a restart.
stale="$(daemon_stale_line)"
[ -n "$stale" ] && echo "letibot: ! $stale" >&2

# LANDED IS NOT RUNNING. `--bash` is a DAEMON flag: it decides which tools the seat
# is given at open, and a daemon that is already up was opened without it. Attaching
# here gets you that daemon's seat, not the one you just asked for -- and the way
# you would find out is a model saying it has no `bash` tool, three turns in.
# So say it here, where the choice is still yours to make.
# Read the daemon's own argv out of /proc, matched by EXACT process name. The
# obvious spelling -- `pgrep -af 'harnessd .*--bash'` -- matches its own caller:
# any shell whose command line happens to mention both strings is a hit, and the
# check then reports that a shell-less daemon has a shell. Measured here on
# 2026-09-11, one hour after it was written.
daemon_has_bash() {
  local p
  p="$(daemon_pid)" || return 1
  pid_argv "$p" | grep -qx -- '--bash'
}

if [ -n "$BASH_ON" ] && ! daemon_has_bash; then
  echo "letibot: a daemon is ALREADY RUNNING and it was started WITHOUT --bash," >&2
  echo "         so this session will not have a shell. --bash is decided when the" >&2
  echo "         daemon opens, and a running one cannot be re-seated." >&2
  echo "" >&2
  echo "         Its own sessions may be mid-turn, so this does not restart it." >&2
  echo "         To get a shell:  letibot --stop  &&  letibot --bash" >&2
  echo "" >&2
  echo "         Attaching to the existing daemon in 5s; ctrl-c to stop." >&2
  sleep 5
fi

if [ "$WANT_NEW" = 1 ]; then
  exec "$HEAD" --socket "$SOCKET" --identity "${USER:-operator}" \
       --new-session "$NEW_TITLE"
fi
if [ -n "$SESSION" ]; then
  exec "$HEAD" --socket "$SOCKET" --identity "${USER:-operator}" \
       --resume "$SESSION"
fi
exec "$HEAD" --socket "$SOCKET" --identity "${USER:-operator}"
