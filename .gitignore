/target
**/*.rs.bk
.env
scripts/__pycache__/

# Working files, scrape output and logs. Nothing in the build reads it.
scratch/
# Worktrees made by hand with `git worktree add worktrees/<slug>`.
/worktrees/

# The daemon's per-project state. Notes live in their own repository (docs/notes.md).
/.letibot/

# A local `.cargo/config.toml` with `paths = [...]` swaps the pinned rano for a local checkout
# whatever the lock asks for. Unreleased rano work goes through a `[patch]` on its branch.
/.cargo/config.toml
/.cargo/config.toml.off-*

# The plugin crates are standalone workspaces with their own build output. A built example's
# `.wasm` is committed as `plugin.wasm` beside it.
/plugins/examples/*/target/
/plugins/builtin/*/target/
